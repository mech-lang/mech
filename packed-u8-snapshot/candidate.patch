+    #[test]
+    fn packed_u8_matrix_honors_each_construction_denial_and_recovers() {
+        let (schemas, [matrix, ..]) = packed_u8_test_schemas();
+        let source = (0..=255u8).collect::<Vec<_>>();
+        for admitted in 0..4 {
+            let authority = FailAfterConstructionAuthority { remaining: Cell::new(admitted) };
+            let context = SnapshotValidationContext::with_shared_schemas(&schemas)
+                .with_construction_authority(&authority);
+            assert!(matches!(
+                Value::from_u8_matrix_slice(matrix, Box::new([1, 256]), &source, &context),
+                Err(SnapshotValueError::MemoryRuntime(_))
+            ));
+            authority.remaining.set(4);
+            let value = Value::from_u8_matrix_slice(matrix, Box::new([1, 256]), &source, &context).unwrap();
+            assert!(matches!(value.data(), ValueData::Matrix(matrix) if matches!(matrix.elements(), SequenceView::U8(bytes) if bytes == source.as_slice())));
+            assert!(Arc::ptr_eq(&value.schemas().unwrap(), &schemas));
+        }
+        let authority = RecordingConstructionAuthority::default();
+        let context = SnapshotValidationContext::with_shared_schemas(&schemas)
+            .with_construction_authority(&authority);
+        let _value = Value::from_u8_matrix_slice(matrix, Box::new([1, 256]), &source, &context).unwrap();
+        let allocations = authority.allocations.borrow();
+        assert_eq!(allocations.len(), 4, "one packed payload and three common final owners");
+        assert_eq!(allocations[0], (256, 1));
+    }
