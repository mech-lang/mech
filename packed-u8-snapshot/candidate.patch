+    #[test]
+    fn packed_u8_matrix_rejects_invalid_metadata_before_payload_allocation() {
+        let (schemas, [matrix, scalar, wrong_kind, wrong_rank, bounded]) = packed_u8_test_schemas();
+        let source = [0, 255, 128];
+        for (schema, shape, payload) in [
+            (SchemaId::new(u32::MAX), vec![], &source[..]),
+            (scalar, vec![], &source[..]),
+            (wrong_kind, vec![], &source[..2]),
+            (wrong_rank, vec![], &source[..2]),
+            (matrix, vec![1], &source[..]),
+            (matrix, vec![1, 2], &source[..]),
+            (matrix, vec![1, 4], &source[..]),
+            (matrix, vec![u64::MAX, 2], &source[..]),
+            (bounded, vec![0], &[][..]),
+            (bounded, vec![9], &source[..]),
+        ] {
+            let authority = RecordingConstructionAuthority::default();
+            let context = SnapshotValidationContext::with_shared_schemas(&schemas)
+                .with_construction_authority(&authority);
+            assert!(Value::from_u8_matrix_slice(schema, shape.into_boxed_slice(), payload, &context).is_err());
+            assert!(authority.allocations.borrow().is_empty(), "invalid metadata reached payload/finalization allocation");
+        }
+        assert_eq!(source, [0, 255, 128]);
+        // The existing default lower0/unbounded Turn axes still admit empty
+        // geometry and large extents when another axis makes cardinality zero.
+        let context = SnapshotValidationContext::with_shared_schemas(&schemas);
+        for shape in [[1, 0], [0, 17], [u64::MAX, 0]] {
+            let value = Value::from_u8_matrix_slice(matrix, Box::new(shape), &[], &context).unwrap();
+            assert_eq!(value.shape().parameter_values(), shape);
+            assert!(matches!(value.data(), ValueData::Matrix(matrix) if matches!(matrix.elements(), SequenceView::U8([]))));
+        }
+    }
