    | "camera-ray"  truth-screen[1]      truth-screen[2]      selected-landmark-screen[1] selected-landmark-screen[2] 0x687780    0.3               "round"          camera-ray-opacity 0.0 0.0 0.0 |

  scene-line-strips :=
    | id<string>        positions<*>       fill<*>  stroke<*> stroke-width<f64> stroke-dasharray<*> line-cap<string> line-join<string> opacity<f64> closed<bool> |
    | "ellipse-fill"    covariance-ellipse 0xc08cc7 "none"    0.0               [0.0]               "round"          "round"           0.3          true         |
    | "covariance"      covariance-ellipse "none"   0xc08cc7 0.55              [0.0]               "round"          "round"           1.0          true         |
    | "truth-path"      next-truth-path    "none"   0x63d6c5 0.75              [0.0]               "round"          "round"           0.8          false        |
    | "estimate-path"   next-estimate-path "none"   0xad9159 0.6               [0.1 1.5]           "round"          "round"           1.0          false        |
    | "truth"           truth-outline      "none"   0x63d6c5 0.55              [0.0]               "round"          "round"           1.0          true         |
    | "estimate"        estimate-outline   0xf6c04e 0xf6c04e 0.45              [0.0]               "round"          "round"           1.0          true         |
    | "truth-heading"   truth-heading-line "none"   0x687780 0.7               [0.0]               "round"          "round"           1.0          false        |
    | "estimate-heading" estimate-heading-line "none" 0x687780 0.7            [0.0]               "round"          "round"           1.0          false        |
    | "camera"          camera-outline     0x62b4a4 "none"    0.0               [0.0]               "round"          "round"           1.0          true         |

  font := "Inter, ui-sans-serif, system-ui, sans-serif"
  scene-texts :=
    | id<string> x<f64>                        y<f64>                        fill<f64> font-size<f64> font-family<string> font-weight<f64> text-anchor<string> opacity<f64>       value<string> |
    | "label-1" landmark-screen[1,1] + 3.0    landmark-screen[1,2] + 1.0    0x91cabc  2.8            font                400              "start"             landmark-opacity[1] "Landmark 1" |
    | "label-2" landmark-screen[2,1] + 3.0    landmark-screen[2,2] + 1.0    0x91cabc  2.8            font                400              "start"             landmark-opacity[2] "Landmark 2" |
    | "label-3" landmark-screen[3,1] - 3.0    landmark-screen[3,2] + 1.0    0x91cabc  2.8            font                400              "end"               landmark-opacity[3] "Landmark 3" |
    | "label-4" landmark-screen[4,1] + 3.0    landmark-screen[4,2] + 1.0    0x91cabc  2.8            font                400              "start"             landmark-opacity[4] "Landmark 4" |
    | "scale"   5.0                           126.0                         0xa9bcc5  2.7            font                400              "start"             1.0                "World coordinates · grid spacing 10" |

  field-presentation := {
    width: 200.0
    height: 130.0
    background: 0x080d10<f64>
    circles: scene-circles
    lines: scene-lines
    line-strips: scene-line-strips
    texts: scene-texts
  }

  truth = next-truth
  accepted-turns = next-accepted-turns
  truth-path = next-truth-path
  estimate-path = next-estimate-path
  @scene/replace <- field-presentation
