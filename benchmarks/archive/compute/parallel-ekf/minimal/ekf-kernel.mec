+> math
-------------------------------------------------------------------------------

n := 100000f32
i := 1f32..=n
p := 6.283185307179586<f32> * (i - 1f32) / n
d := 0.1<f32>
v := 1f32 + 0.05<f32> * math/sin(3f32 * p)
w := 0.015<f32> * (1f32 + 0.1<f32> * math/sin(2f32 * p))
z := -0.55<f32> + 0.01<f32> * math/sin(7f32 * p) + 0.005<f32> * math/sin(11f32 * p)

S @compute
-------------------------------------------------------------------------------
l<[f32]> := [140; 12]
Q<[f32]> := [0.01 0; 0 0.0025]
E<[f32]> := [1 0 0; 0 1 0; 0 0 1]
~x<[f32]> := [55; 25; 0.4]
~P<[f32]> := [100 0 0
              0 100 0
              0 0 0.15]
a := x[3]
s := math/sin(a)
c := math/cos(a)
h := v * d
y := x + [h * c; h * s; w * d]
F := [1f32 0f32 0f32 - d * s; 0f32 1f32 h * c; 0f32 0f32 1f32]
G := [c * d 0f32; s * d 0f32; 0f32 d]
R := F ** P ** F' + G ** Q ** G'
e := l - [y[1]; y[2]]
e0 := e[1]
e1 := e[2]
b := e · e
m := math/atan2(e1, e0) - y[3]
n1 := z - m
n2 := math/atan2(math/sin(n1), math/cos(n1))
H := [e1 / b, -e0 / b, -1f32]
V := H ** R · H + 0.25<f32>
K := R ** H' / V
X := y + K * n2
A := E - K ** H
Y := A ** R ** A' + (K ** K') * 0.25<f32>
f! := math/abs(X[1]) <= 1e30<f32> && math/abs(X[2]) <= 1e30<f32> && math/abs(X[3]) <= 1e30<f32> && math/abs(Y[1,1]) <= 1e30<f32> && math/abs(Y[2,1]) <= 1e30<f32> && math/abs(Y[3,1]) <= 1e30<f32> && math/abs(Y[1,2]) <= 1e30<f32> && math/abs(Y[2,2]) <= 1e30<f32> && math/abs(Y[3,2]) <= 1e30<f32> && math/abs(Y[1,3]) <= 1e30<f32> && math/abs(Y[2,3]) <= 1e30<f32> && math/abs(Y[3,3]) <= 1e30<f32> && Y[1,1] > 0f32 && Y[2,2] > 0f32 && Y[3,3] > 0f32
g! := math/abs(Y[1,2] - Y[2,1]) <= 0.0001<f32> && math/abs(Y[1,3] - Y[3,1]) <= 0.0001<f32> && math/abs(Y[2,3] - Y[3,2]) <= 0.0001<f32>
x = X
P = Y
(x, P)
