++> math
-------------------------------------------------------------------------------

n := 100000f32
i := 1f32..=n
p := 6.283185307179586<f32> * (i - 1f32) / n
d := 0.1<f32>
v := 1f32 + 0.05<f32> * math/sin(p * 3f32)
w := 0.015<f32> * (1f32 + 0.1<f32> * math/sin(p * 2f32))
z := -0.55<f32> + 0.01<f32> * math/sin(p * 7f32) + 0.005<f32> * math/sin(p * 11f32)
r := 0.25<f32>
L := 1e30<f32>
T := 0.0001<f32>

S @compute
-------------------------------------------------------------------------------
q := [140f32; 12f32]
Q := [0.01<f32> 0f32
      0f32 0.0025<f32>]
E := [1f32 0f32 0f32
      0f32 1f32 0f32
      0f32 0f32 1f32]
C := [1f32 0f32 0f32
      0f32 1f32 0f32]
u := [1f32; 0f32]
v2 := [0f32; 1f32]
t := [0f32; 0f32; 1f32]
~x := [55f32; 25f32; 0.4<f32>]
~P := [100f32 0f32 0f32
       0f32 100f32 0f32
       0f32 0f32 0.15<f32>]
a := x · t
s := math/sin(a)
c := math/cos(a)
h := v * d
y := x + [h * c
           h * s
           w * d]
F := [1f32 0f32 0f32 - d * s
      0f32 1f32 h * c
      0f32 0f32 1f32]
G := [c * d 0f32
      s * d 0f32
      0f32 d]
R := F ** P ** F' + G ** Q ** G'
e := q - C ** y
e0 := e · u
e1 := e · v2
b := e · e
m := math/atan2(e1, e0) - y · t
n1 := z - m
n2 := math/atan2(math/sin(n1), math/cos(n1))
H := [e1 / b, -e0 / b, -1f32]
V := H ** R · H + r
K := R ** H' / V
X := y + K * n2
A := E - K ** H
Y := A ** R ** A' + (K ** K') * r
x0 := X · u
x1 := X · v2
x2 := X · t
p0 := Y[1, 1]
p1 := Y[2, 1]
p2 := Y[3, 1]
p3 := Y[1, 2]
p4 := Y[2, 2]
p5 := Y[3, 2]
p6 := Y[1, 3]
p7 := Y[2, 3]
p8 := Y[3, 3]
f := math/abs(x0) <= L && math/abs(x1) <= L && math/abs(x2) <= L
g := math/abs(p0) <= L && math/abs(p1) <= L && math/abs(p2) <= L && math/abs(p3) <= L && math/abs(p4) <= L && math/abs(p5) <= L && math/abs(p6) <= L && math/abs(p7) <= L && math/abs(p8) <= L
f! := f && g
g! := p0 > 0f32 && p4 > 0f32 && p8 > 0f32
h! := math/abs(p3 - p1) <= T && math/abs(p6 - p2) <= T && math/abs(p7 - p5) <= T
x = X
P = Y
(x, P)
