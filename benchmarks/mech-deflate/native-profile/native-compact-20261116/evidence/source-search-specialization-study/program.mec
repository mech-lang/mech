    | false => step).

block-write-compressed(bytes<[u8]>, bitbuf<u64>, bitcount<u64>, input<[u8]>, begin<u64>, length<u64>, items<[u64]>, use-items<u64>, final<u64>, use-static<bool>, precode<block-precode>, litlen-codewords<[u32]>, offset-codewords<[u32]>, static-litlen-codewords<[u32]>, static-offset-codewords<[u32]>, permutation<[u8]>, extra-precode<[u8]>, length-slots<[u8]>, length-bases<[u32]>, length-extra<[u8]>, offset-slots<[u8]>, offset-bases<[u32]>, offset-extra<[u8]>) => (out<path-written>) :=
  header := (use-static? | true => block-write-static-header(bytes, bitbuf, bitcount, final) | false => block-write-dynamic-header(bytes, bitbuf, bitcount, final, precode, permutation, extra-precode))
  w-litlen-words := (use-static? | true => static-litlen-codewords | false => litlen-codewords)
  w-offset-words := (use-static? | true => static-offset-codewords | false => offset-codewords)
  top := bits/wrapping-sub(sequence/length(items), 1u64)
  payload := block-stream-payload(header.bytes, header.bitbuf, header.bitcount, input, begin, length, items, top, 0u64, use-items == 0u64, w-litlen-words, w-offset-words, length-slots, length-bases, length-extra, offset-slots, offset-bases, offset-extra)
  entry<u64> := huff-get32(w-litlen-words, 256u64)
  word := bits/and(entry, 65535u64)
  buf := bits/or(payload.bitbuf, bits/shift-left-wrap(word, bits/and(payload.bitcount, 255u64)))
  width := bits/shift-right-wrap(entry, 16u64)
  out := path-write-flush(payload.bytes, buf, payload.bitcount + width).

block-write-combined(bytes<[u8]>, bitbuf<u64>, bitcount<u64>, input<[u8]>, begin<u64>, length<u64>, items<[u64]>, use-items<u64>, final<u64>, use-static<bool>, precode<block-precode>, codewords<[u32]>, static-codewords<[u32]>, permutation<[u8]>, extra-precode<[u8]>, recipes<[u32]>, offset-slots<[u8]>) => (out<path-written>) :=
  header := (use-static? | true => block-write-static-header(bytes, bitbuf, bitcount, final) | false => block-write-dynamic-header(bytes, bitbuf, bitcount, final, precode, permutation, extra-precode))
  words := (use-static? | true => static-codewords | false => codewords)
  top := bits/wrapping-sub(sequence/length(items), 1u64)
  payload := block-stream-combined-payload(header.bytes, header.bitbuf, header.bitcount, input, begin, length, items, top, 0u64, use-items == 0u64, words, recipes, offset-slots)
  entry<u64> := huff-get32(words, 256u64)
  word := bits/and(entry, 65535u64)
  buf := bits/or(payload.bitbuf, bits/shift-left-wrap(word, bits/and(payload.bitcount, 255u64)))
  width := bits/shift-right-wrap(entry, 16u64)
  out := path-write-flush(payload.bytes, buf, payload.bitcount + width).
fixed-litlen-price := [8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 0u8 7u8 7u8 7u8 7u8 7u8 7u8 7u8 7u8 8u8 8u8 8u8 8u8 9u8 9u8 9u8 9u8 10u8 10u8 10u8 10u8 11u8 11u8 11u8 12u8 13u8 13u8 13u8 13u8 8u8 0u8 0u8]
fixed-distance-price := [5u8 5u8 5u8 5u8 6u8 6u8 7u8 7u8 8u8 8u8 9u8 9u8 10u8 10u8 11u8 11u8 12u8 12u8 13u8 13u8 14u8 14u8 15u8 15u8 16u8 16u8 17u8 17u8 18u8 18u8 0u8 0u8]

block-fixed-litlen-cost(freqs<[u32]>, prices<[u8]>, sym<u64>, cost<u64>) => (out<u64>) :=
  more := sym < 288u64
  frequency := (more? | true => huff-word(huff-get32(freqs, sym)) | false => 0u64)
  width<u64> := (more? | true => huff-get8(prices, sym) | false => 0u8)
  next := cost + frequency * width
  out := (more? | true => block-fixed-litlen-cost(freqs, prices, sym + 1u64, next) | false => cost).

block-fixed-distance-cost(freqs<[u32]>, prices<[u8]>, sym<u64>, cost<u64>) => (out<u64>) :=
  more := sym < 32u64
  frequency := (more? | true => huff-word(huff-get32(freqs, sym)) | false => 0u64)
  width<u64> := (more? | true => huff-get8(prices, sym) | false => 0u8)
  next := cost + frequency * width
  out := (more? | true => block-fixed-distance-cost(freqs, prices, sym + 1u64, next) | false => cost).

// The selected parse includes exactly one end marker and every legal distance
// is in slots 0 through 29. The block header adds three bits to its price.
block-compute-priced-costs(dynamic-price<u64>, freqs-litlen<[u32]>, freqs-offset<[u32]>, block-length<u64>, bitcount<u64>) => (out<block-costs>) :=
  dynamic := dynamic-price + 3u64
  litlen := block-fixed-litlen-cost(freqs-litlen, fixed-litlen-price, 0u64, 10u64)
  fixed := block-fixed-distance-cost(freqs-offset, fixed-distance-price, 0u64, litlen)
  blocks := (block-length + 65534u64) / 65535u64
  stored := 3u64 + bits/and(bits/wrapping-sub(0u64, bitcount + 3u64), 7u64) + 32u64 + 40u64 * (blocks - 1u64) + 8u64 * block-length
  out := {dynamic: dynamic, fixed: fixed, stored: stored, kind: block-choose-kind(dynamic, fixed, stored)}.

block-flush(bytes<[u8]>, bitbuf<u64>, bitcount<u64>, input<[u8]>, begin<u64>, length<u64>, freqs-litlen<[u32]>, freqs-offset<[u32]>, litlen-codewords<[u32]>, offset-codewords<[u32]>, static-litlen-codewords<[u32]>, static-offset-codewords<[u32]>, items<[u64]>, use-items<u64>, final<u64>, precode<block-precode>, priced<u64>, permutation<[u8]>, extra-precode<[u8]>, length-slots<[u8]>, length-bases<[u32]>, length-extra<[u8]>, offset-slots<[u8]>, offset-bases<[u32]>, offset-extra<[u8]>) => (out<path-written>) :=
  costs := block-compute-priced-costs(priced, freqs-litlen, freqs-offset, length, bitcount)
  in-end := begin + length
  out := ((costs.kind == 0u64)? | true => block-store-at(bytes, bitbuf, bitcount, input, begin, in-end, final) | false => block-write-compressed(bytes, bitbuf, bitcount, input, begin, length, items, use-items, final, costs.kind == 1u64, precode, litlen-codewords, offset-codewords, static-litlen-codewords, static-offset-codewords, permutation, extra-precode, length-slots, length-bases, length-extra, offset-slots, offset-bases, offset-extra)).

// Final level-12 parse selection from CompressOptimal.roc:1107-1201,
// pinned at 671077457ff7ef3a3d44caf715a3fc595addf379.
// Include literal choice, cost models, optimal path, tally and optimization.
// See deflate-huffman-LICENSES.md for attribution and licenses.
<optimal-selected-block> := <{nodes<[u64]> costs<optimal-costs> tallied<optimal-tally> seqs<[block-sequence]> use-items<u64> used-only-literals<u64>}>

optimal-select-literals(relits<optimal-literal-choice>, length<u64>, nodes<[u64]>, costs<optimal-costs>, seqs<[block-sequence]>, length-slots<[u8]>, extra-lengths<[u8]>, extra-offsets<[u8]>) => (out<optimal-selected-block>) :=
  next-costs := optimal-set-costs-from-codes(relits.litlen-lens, relits.offset-lens, costs.literal, costs.length, costs.offset-slot, length-slots, extra-lengths, extra-offsets)
  ~next-seqs := seqs
  next-seqs[1u64] = {litrunlen-and-length: bt-narrow32(length), offset: 0u16, offset-slot: 0u16}
  tallied := {freqs-litlen: relits.freqs-litlen, freqs-offset: relits.freqs-offset, litlen-lens: relits.litlen-lens, litlen-codewords: relits.litlen-codewords, offset-lens: relits.offset-lens, offset-codewords: relits.offset-codewords}
  out := {nodes: nodes, costs: next-costs, tallied: tallied, seqs: next-seqs, use-items: 0u64, used-only-literals: 1u64}.

optimal-select-static(length<u64>, cache<[u32]>, cache-end<u64>, nodes<[u64]>, costs<optimal-costs>, seqs<[block-sequence]>, static-litlen-lens<[u8]>, static-offset-lens<[u8]>, length-slots<[u8]>, extra-lengths<[u8]>, extra-offsets<[u8]>, offset-slots<[u8]>, reversed<[u8]>) => (out<optimal-selected-block>) :=
  next-costs := optimal-set-costs-from-codes(static-litlen-lens, static-offset-lens, costs.literal, costs.length, costs.offset-slot, length-slots, extra-lengths, extra-offsets)
  path := optimal-find-min-cost-path(length, cache, cache-end, nodes, next-costs.literal, next-costs.length, next-costs.offset-slot, offset-slots)
  tallied := optimal-tally-and-build-codes(path.nodes, length, length-slots, offset-slots, reversed)
  out := {nodes: path.nodes, costs: next-costs, tallied: tallied, seqs: seqs, use-items: 1u64, used-only-literals: 0u64}.

optimal-select-saved(length<u64>, cache<[u32]>, cache-end<u64>, nodes<[u64]>, saved<optimal-costs>, seqs<[block-sequence]>, length-slots<[u8]>, extra-lengths<[u8]>, extra-offsets<[u8]>, offset-slots<[u8]>, reversed<[u8]>) => (out<optimal-selected-block>) :=
  path := optimal-find-min-cost-path(length, cache, cache-end, nodes, saved.literal, saved.length, saved.offset-slot, offset-slots)
  tallied := optimal-tally-and-build-codes(path.nodes, length, length-slots, offset-slots, reversed)
  next-costs := optimal-set-costs-from-codes(tallied.litlen-lens, tallied.offset-lens, saved.literal, saved.length, saved.offset-slot, length-slots, extra-lengths, extra-offsets)
  out := {nodes: path.nodes, costs: next-costs, tallied: tallied, seqs: seqs, use-items: 1u64, used-only-literals: 0u64}.

optimal-select-block(relits<optimal-literal-choice>, length<u64>, cache<[u32]>, cache-end<u64>, optimized<optimal-optimization>, seqs<[block-sequence]>, only-literals-cost<u64>, static-cost<u64>, static-litlen-lens<[u8]>, static-offset-lens<[u8]>, length-slots<[u8]>, extra-lengths<[u8]>, extra-offsets<[u8]>, offset-slots<[u8]>, reversed<[u8]>) => (out<optimal-selected-block>) :=
  alternative := bt-minimum(only-literals-cost, static-cost) < optimized.best-true-cost
  out := (alternative?
    | true => ((only-literals-cost < static-cost)?
      | true => optimal-select-literals(relits, length, optimized.nodes, optimized.costs, seqs, length-slots, extra-lengths, extra-offsets)
      | false => optimal-select-static(length, cache, cache-end, optimized.nodes, optimized.costs, seqs, static-litlen-lens, static-offset-lens, length-slots, extra-lengths, extra-offsets, offset-slots, reversed))
    | false => ((optimized.actual-cost >= optimized.best-true-cost + 1u64)?
      | true => optimal-select-saved(length, cache, cache-end, optimized.nodes, optimized.saved, seqs, length-slots, extra-lengths, extra-offsets, offset-slots, reversed)
      | false => {nodes: optimized.nodes, costs: optimized.costs, tallied: optimized.tallied, seqs: seqs, use-items: 1u64, used-only-literals: 0u64})).

// Level-12 candidate setup and model carryover from CompressOptimal.roc:970-1106
// and 1319-1349, pinned at 671077457ff7ef3a3d44caf715a3fc595addf379.
// Include block heuristics, cost/path/tally/header/optimization and selection.
// See deflate-huffman-LICENSES.md for attribution and licenses.
<optimal-static-pass> := <{nodes<[u64]> cost<u64>}>
<optimal-stream-selection> := <{nodes<[u64]> costs<[u32]> tallied<optimal-parse-tally> use-items<u64> used-only-literals<u64>}>
<optimal-planned-block> := <{selected<optimal-stream-selection> saved<[u32]> precode<block-precode> priced<u64>}>

optimal-static-candidate(length<u64>, cache<[u32]>, cache-end<u64>, nodes<[u64]>, static-litlen-lens<[u8]>, static-offset-lens<[u8]>, length-slots<[u8]>, extra-lengths<[u8]>, extra-offsets<[u8]>, offset-slots<[u8]>) => (out<optimal-static-pass>) :=
  literal0 := [0u32 | i <- 0u64..=256u64, i < 256u64]
  length0 := [0u32 | i <- 0u64..=259u64, i < 259u64]
  offset0 := [0u32 | i <- 0u64..=32u64, i < 32u64]
  costs := optimal-set-costs-from-codes(static-litlen-lens, static-offset-lens, literal0, length0, offset0, length-slots, extra-lengths, extra-offsets)
  path := optimal-find-min-cost-path(length, cache, cache-end, nodes, costs.literal, costs.length, costs.offset-slot, offset-slots)
  count := sequence/length(path.nodes)
  last := ((count != 0u64)? | true => path.nodes[count] | false => 0u64)
  cost := bits/and(last, 4294967295u64) / 16u64 + 7u64
  out := {nodes: path.nodes, cost: cost}.


optimal-packed-code-literal-step(values<[u32]>, lens<[u8]>, i<u64>) => (out<[u32]>) :=
  cost := optimal-cost-bits(huff-get8(lens, i), 13u64)
  out := huff-set32(values, bits/wrapping-add(i, 259u64), huff-packed(cost * 16u64)).
optimal-packed-code-literals(values<[u32]>, lens<[u8]>, i<u64>) => <[u32]>
  | (values, lens, i) => ((i < 256u64)? | true => optimal-packed-code-literals(optimal-packed-code-literal-step(values, lens, i), lens, i + 1u64) | false => values).

optimal-packed-code-length-step(values<[u32]>, lens<[u8]>, i<u64>, slots<[u8]>, extras<[u8]>) => (out<[u32]>) :=
  slot<u64> := huff-get8(slots, i)
  sym := 257u64 + slot
  cost := optimal-cost-bits(huff-get8(lens, sym), 13u64)
  extra<u64> := huff-get8(extras, slot)
  total := cost + extra
  out := huff-set32(values, i, huff-packed(total * 16u64)).
optimal-packed-code-lengths(values<[u32]>, lens<[u8]>, i<u64>, slots<[u8]>, extras<[u8]>) => <[u32]>
  | (values, lens, i, slots, extras) => ((i <= 258u64)? | true => optimal-packed-code-lengths(optimal-packed-code-length-step(values, lens, i, slots, extras), lens, i + 1u64, slots, extras) | false => values).

optimal-packed-code-offset-step(values<[u32]>, lens<[u8]>, i<u64>, extras<[u8]>) => (out<[u32]>) :=
  cost := optimal-cost-bits(huff-get8(lens, i), 10u64)
  extra<u64> := huff-get8(extras, i)
  total := cost + extra
  out := huff-set32(values, bits/wrapping-add(i, 515u64), huff-packed(total * 16u64)).
optimal-packed-code-offsets(values<[u32]>, lens<[u8]>, i<u64>, extras<[u8]>) => <[u32]>
  | (values, lens, i, extras) => ((i < 32u64)? | true => optimal-packed-code-offsets(optimal-packed-code-offset-step(values, lens, i, extras), lens, i + 1u64, extras) | false => values).

optimal-packed-blend-literal-step(values<[u32]>, cost<u64>, weight<u64>, i<u64>) => (out<[u32]>) :=
  cur := huff-get32(values, bits/wrapping-add(i, 259u64))
  out := huff-set32(values, bits/wrapping-add(i, 259u64), optimal-blend-cost(cur, cost, weight)).
optimal-packed-blend-literals(values<[u32]>, cost<u64>, weight<u64>, i<u64>) => <[u32]>
  | (values, cost, weight, i) => ((i < 256u64)? | true => optimal-packed-blend-literals(optimal-packed-blend-literal-step(values, cost, weight, i), cost, weight, i + 1u64) | false => values).

optimal-packed-blend-length-step(values<[u32]>, cost<u64>, weight<u64>, i<u64>, slots<[u8]>, extras<[u8]>) => (out<[u32]>) :=
  cur := huff-get32(values, i)
  default-cost := optimal-default-length-cost(i, cost, slots, extras)
  out := huff-set32(values, i, optimal-blend-cost(cur, default-cost, weight)).
optimal-packed-blend-lengths(values<[u32]>, cost<u64>, weight<u64>, i<u64>, slots<[u8]>, extras<[u8]>) => <[u32]>
  | (values, cost, weight, i, slots, extras) => ((i <= 258u64)? | true => optimal-packed-blend-lengths(optimal-packed-blend-length-step(values, cost, weight, i, slots, extras), cost, weight, i + 1u64, slots, extras) | false => values).

optimal-packed-blend-offset-step(values<[u32]>, weight<u64>, i<u64>, extras<[u8]>) => (out<[u32]>) :=
  cur := huff-get32(values, bits/wrapping-add(i, 515u64))
  default-cost := optimal-default-offset-cost(i, extras)
  out := huff-set32(values, bits/wrapping-add(i, 515u64), optimal-blend-cost(cur, default-cost, weight)).
optimal-packed-blend-offsets(values<[u32]>, weight<u64>, i<u64>, extras<[u8]>) => <[u32]>
  | (values, weight, i, extras) => ((i < 32u64)? | true => optimal-packed-blend-offsets(optimal-packed-blend-offset-step(values, weight, i, extras), weight, i + 1u64, extras) | false => values).

optimal-update-packed-code-prices(values<[u32]>, words<[u32]>, entries<[u16]>, at<u64>) => (out<[u32]>) :=
  more := at < 547u64
  entry<u64> := (more? | true => entries[at + 1u64] | false => 0u16)
  sym := bits/and(entry, 511u64)
  extra := bits/shift-right-wrap(entry, 9u64)
  width := (more? | true => block-precode-width(words, sym) | false => 0u64)
  fallback := ((sym < 288u64)? | true => 13u64 | false => 10u64)
  cost := ((width != 0u64)? | true => width | false => fallback)
  next := (more? | true => huff-set32(values, at, huff-packed((cost + extra) * 16u64)) | false => values)
  out := (more? | true => optimal-update-packed-code-prices(next, words, entries, at + 1u64) | false => values).

optimal-set-packed-costs-from-codes(words<[u32]>, costs<[u32]>) => (out<[u32]>) :=
  out := optimal-update-packed-code-prices(costs, words, deflate-main-price-entries, 3u64).

optimal-blend-packed-costs(literal-price<u64>, length-price<u64>, weight<u64>, costs<[u32]>, slots<[u8]>, extra-lengths<[u8]>, extra-offsets<[u8]>) => (out<[u32]>) :=
  literals := optimal-packed-blend-literals(costs, literal-price, weight, 0u64)
  lengths := optimal-packed-blend-lengths(literals, length-price, weight, 3u64, slots, extra-lengths)
  out := optimal-packed-blend-offsets(lengths, weight, 0u64, extra-offsets).

deflate-fixed-packed-price := [0u32 0u32 0u32 112u32 112u32 112u32 112u32 112u32 112u32 112u32 112u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 80u32 80u32 80u32 80u32 96u32 96u32 112u32 112u32 128u32 128u32 144u32 144u32 160u32 160u32 176u32 176u32 192u32 192u32 208u32 208u32 224u32 224u32 240u32 240u32 256u32 256u32 272u32 272u32 288u32 288u32 80u32 80u32]

optimal-read-fixed-packed-costs() => (out<[u32]>) :=
  out := sequence/reserve(deflate-fixed-packed-price, 0u64).

optimal-complete-path(nodes<[u64]>, costs<[u32]>, tallied<optimal-parse-tally>, saved<[u32]>, precode<block-precode>, priced<u64>) => (out<optimal-planned-block>) :=
  selected := {nodes: nodes, costs: costs, tallied: tallied, use-items: 1u64, used-only-literals: 0u64}
  out := {selected: selected, saved: saved, precode: precode, priced: priced}.

// Final path replays use the same scan and tally as ordinary optimization passes.
optimal-same-parse-costs(previous<optimal-costs>, current<optimal-costs>) => (out<bool>) :=
  out := (optimal-frequency-equal(previous.literal, current.literal, 0u64, 256u64)?
    | true => (optimal-frequency-equal(previous.length, current.length, 3u64, 259u64)?
      | true => optimal-frequency-equal(previous.offset-slot, current.offset-slot, 0u64, 32u64)
      | false => false)
    | false => false).

optimal-packed-tally-match(freqs<[u32]>, length<u64>, offset<u64>, lengths<[u8]>, slots<[u8]>) => (out<[u32]>) :=
  length-slot<u64> := huff-get8(lengths, length)
  next := optimal-tally-increment(freqs, bits/wrapping-add(257u64, length-slot))
  slot := optimal-offset-slot(offset, slots)
  out := optimal-tally-increment(next, bits/wrapping-add(288u64, slot)).

optimal-packed-tally-step(nodes<[u64]>, top<u64>, at<u64>, freqs<[u32]>, lengths<[u8]>, slots<[u8]>) => (out<([u32],u64)>) :=
  item := huff-packed(bits/shift-right-wrap(optimal-get64(nodes, bits/wrapping-sub(top, at)), 32u64))
  length := bits/and(huff-word(item), 511u64)
  offset := bits/shift-right-wrap(huff-word(item), 9u64)
  next := ((length == 1u64)?
    | true => optimal-tally-increment(freqs, bits/and(offset, 255u64))
    | false => optimal-packed-tally-match(freqs, length, offset, lengths, slots))
  out := (next, bits/wrapping-add(at, length)).

optimal-packed-tally-loop(nodes<[u64]>, top<u64>, at<u64>, end<u64>, freqs<[u32]>, lengths<[u8]>, slots<[u8]>) => (out<[u32]>) :=
  more := at != end
  step := (more? | true => optimal-packed-tally-step(nodes, top, at, freqs, lengths, slots) | false => (freqs, at))
  (next, next-at) := step
  out := (more? | true => optimal-packed-tally-loop(nodes, top, next-at, end, next, lengths, slots) | false => freqs).

optimal-count-packed-path(nodes<[u64]>, block-length<u64>, lengths<[u8]>, slots<[u8]>) => (out<[u32]>) :=
  zero := [0u32 | i <- 0u64..=320u64, i < 320u64]
  counts := optimal-packed-tally-loop(nodes, optimal-node-top(block-length), 0u64, block-length, zero, lengths, slots)
  out := optimal-tally-increment(counts, 256u64).

optimal-count-packed-literals(input<[u8]>, begin<u64>, length<u64>) => (out<[u32]>) :=
  zero := [0u32 | i <- 0u64..=320u64, i < 320u64]
  counts := optimal-literal-counts(input, begin, length, 0u64, zero)
  out := optimal-tally-increment(counts, 256u64).

huff-packed-count-step(freqs<[u32]>, freq-start<u64>, counts<[u64]>, sym<u64>, top<u64>) => (out<[u64]>) :=
  frequency := huff-word(huff-get32(freqs, bits/wrapping-add(freq-start, sym)))
  out := ((frequency == 0u64)? | true => counts | false => huff-count-active(counts, frequency, top)).

huff-packed-count-symbols(freqs<[u32]>, freq-start<u64>, n<u64>, counts<[u64]>, sym<u64>, top<u64>) => <[u64]>
  | (freqs, freq-start, n, counts, sym, top) => ((sym < n)? | true => huff-packed-count-symbols(freqs, freq-start, n, huff-packed-count-step(freqs, freq-start, counts, sym, top), sym + 1u64, top) | false => counts).

huff-packed-place-step(freqs<[u32]>, freq-start<u64>, counts<[u64]>, words<[u32]>, sym<u64>, top<u64>) => (out<([u64],[u32])>) :=
  freq := huff-get32(freqs, bits/wrapping-add(freq-start, sym))
  out := ((freq != 0u32)? | true => huff-place-nonzero(counts, words, freq, sym, top) | false => (counts, words)).

huff-packed-place-symbols(freqs<[u32]>, freq-start<u64>, n<u64>, counts<[u64]>, words<[u32]>, sym<u64>, top<u64>) => (out<([u64],[u32])>) :=
  more := sym < n
  step := (more? | true => huff-packed-place-step(freqs, freq-start, counts, words, sym, top) | false => (counts, words))
  (next-counts, next-words) := step
  out := (more? | true => huff-packed-place-symbols(freqs, freq-start, n, next-counts, next-words, sym + 1u64, top) | false => (counts, words)).

huff-pack-active-symbols(freqs<[u32]>, freq-start<u64>, n<u64>, sym<u64>, words<[u32]>, used<u64>) => (out<([u32],u64)>) :=
  more := sym < n
  frequency<u64> := (more? | true => huff-get32(freqs, bits/wrapping-add(freq-start, sym)) | false => 0u32)
  active := frequency != 0u64
  key := huff-packed(bits/or(sym, bits/shift-left-wrap(frequency, 10u64)))
  next := (active? | true => huff-set32(words, used, key) | false => words)
  next-used := (active? | true => used + 1u64 | false => used)
  out := (more? | true => huff-pack-active-symbols(freqs, freq-start, n, sym + 1u64, next, next-used) | false => (next, next-used)).

huff-insert-gapped-key(words<[u32]>, gap<u64>, at<u64>, key<u32>) => (out<[u32]>) :=
  can-move := at >= gap
  previous := (can-move? | true => at - gap | false => at)
  prior := (can-move? | true => huff-get32(words, previous) | false => key)
  moving := prior > key
  value := (moving? | true => prior | false => key)
  updated := huff-set32(words, at, value)
  out := (moving? | true => huff-insert-gapped-key(updated, gap, previous, key) | false => updated).

huff-sort-key-gap(words<[u32]>, used<u64>, gap<u64>, at<u64>) => (out<[u32]>) :=
  more := at < used
  next := (more?
    | true => huff-insert-gapped-key(words, gap, at, huff-get32(words, at))
    | false => words)
  out := (more? | true => huff-sort-key-gap(next, used, gap, at + 1u64) | false => next).

huff-sort-key-gaps(words<[u32]>, used<u64>, gaps<u64>) => (out<[u32]>) :=
  gap := bits/and(gaps, 255u64)
  more := gap != 0u64
  next := ((more && (gap < used))? | true => huff-sort-key-gap(words, used, gap, gap) | false => words)
  out := (more? | true => huff-sort-key-gaps(next, used, bits/shift-right-wrap(gaps, 8u64)) | false => next).

huff-packed-sort-symbols(n<u64>, freqs<[u32]>, freq-start<u64>, scratch<[u32]>) => (out<([u32],u64)>) :=
  (words, used) := huff-pack-active-symbols(freqs, freq-start, n, 0u64, scratch, 0u64)
  sorted := huff-sort-key-gaps(words, used, 4362938489u64)
  out := (sorted, used).

huff-count-width-entry(sorted<[u32]>, entries<[u32]>, width<u64>, at<u64>) => (out<[u32]>) :=
  sym := bits/and(huff-word(huff-get32(sorted, at)), 1023u64)
  entry := huff-packed(bits/shift-left-wrap(width, 16u64))
  out := huff-set32(entries, sym, entry).

huff-assign-packed-symbols(sorted<[u32]>, entries<[u32]>, width<u64>, at<u64>, left<u64>) => <([u32],u64)>
  | (sorted, entries, width, at, left) => ((left > 0u64)?
      | true => huff-assign-packed-symbols(sorted, huff-count-width-entry(sorted, entries, width, at), width, at + 1u64, left - 1u64)
      | false => (entries, at)).

huff-assign-packed-widths(sorted<[u32]>, entries<[u32]>, counts<[u64]>, width<u64>, at<u64>) => (out<[u32]>) :=
  more := width >= 1u64
  (next, next-at) := (more? | true => huff-assign-packed-symbols(sorted, entries, width, at, huff-get64(counts, width)) | false => (entries, at))
  out := (more? | true => huff-assign-packed-widths(sorted, next, counts, width - 1u64, next-at) | false => next).

// Assign the canonical next code in ascending symbol order, as before.
huff-canonicalize-packed-entry(entries<[u32]>, next-code<[u32]>, reversed<[u8]>, sym<u64>, width<u64>) => (out<([u32],[u32])>) :=
  (updated, entry) := huff-generate-active(next-code, width, reversed)
  out := (huff-set32(entries, sym, entry), updated).

huff-canonicalize-packed-words(entries<[u32]>, next-code<[u32]>, reversed<[u8]>, n<u64>, sym<u64>) => (out<[u32]>) :=
  more := sym < n
  width := (more? | true => block-precode-width(entries, sym) | false => 0u64)
  (updated, next) := ((width == 0u64)? | true => (entries, next-code) | false => huff-canonicalize-packed-entry(entries, next-code, reversed, sym, width))
  out := (more? | true => huff-canonicalize-packed-words(updated, next, reversed, n, sym + 1u64) | false => updated).

huff-make-packed-normal(sorted<[u32]>, used<u64>, maximum<u64>, n<u64>, entries<[u32]>, reversed<[u8]>) => (out<[u32]>) :=
  tree := huff-build-tree(sorted, used)
  counted := huff-compute-length-counts(tree, used - 2u64, maximum)
  widths := huff-assign-packed-widths(counted.a, entries, counted.len-counts, maximum, 0u64)
  zero := [0u32 | i <- 0u64..=17u64, i < 17u64]
  next := huff-next-codes(counted.len-counts, zero, maximum, 2u64)
  out := huff-canonicalize-packed-words(widths, next, reversed, n, 0u64).

huff-make-packed-degenerate(sorted<[u32]>, used<u64>, entries<[u32]>) => (out<[u32]>) :=
  sym := ((used == 1u64)? | true => bits/and(huff-word(huff-get32(sorted, 0u64)), 1023u64) | false => 0u64)
  nonzero := ((sym != 0u64)? | true => sym | false => 1u64)
  out := huff-set32(huff-set32(entries, 0u64, 65536u32), nonzero, 65537u32).

huff-packed-make-code-selected(n<u64>, maximum<u64>, freqs<[u32]>, freq-start<u64>, entries<[u32]>, scratch<[u32]>, reversed<[u8]>, empty<bool>) => (out<[u32]>) :=
  (sorted, used) := (empty? | true => (scratch, 0u64) | false => huff-packed-sort-symbols(n, freqs, freq-start, scratch))
  out := ((used < 2u64)?
    | true => huff-make-packed-degenerate(sorted, used, entries)
    | false => huff-make-packed-normal(sorted, used, maximum, n, entries, reversed)).

optimal-price-extra-with-start(freqs<[u32]>, lens<[u8]>, extras<[u8]>, base<u64>, freq-start<u64>, sym<u64>, end<u64>, cost<u64>) => (out<u64>) :=
  more := sym < end
  extra<u64> := (more? | true => huff-get8(extras, sym - base) | false => 0u8)
  frequency := (more? | true => huff-word(huff-get32(freqs, bits/wrapping-add(freq-start, sym))) | false => 0u64)
  width<u64> := (more? | true => huff-get8(lens, sym) | false => 0u8)
  next := cost + frequency * (width + extra)
  out := (more? | true => optimal-price-extra-with-start(freqs, lens, extras, base, freq-start, sym + 1u64, end, next) | false => cost).

optimal-packed-symbol-price(freqs<[u32]>, words<[u32]>, extras<[u8]>, sym<u64>, cost<u64>) => (out<u64>) :=
  more := sym < 320u64
  extra<u64> := (more? | true => huff-get8(extras, sym) | false => 0u8)
  frequency := (more? | true => huff-word(huff-get32(freqs, sym)) | false => 0u64)
  width := (more? | true => block-precode-width(words, sym) | false => 0u64)
  next := cost + frequency * (width + extra)
  out := (more? | true => optimal-packed-symbol-price(freqs, words, extras, sym + 1u64, next) | false => cost).

optimal-price-packed-header(precode<block-precode>, words<[u32]>, freqs<[u32]>, extra-precode<[u8]>) => (out<u64>) :=
  cost0 := 5u64 + 5u64 + 4u64 + 3u64 * precode.num-explicit-lens
  cost1 := block-price-precode(precode.freqs, precode.codewords, extra-precode, 0u64, cost0)
  out := optimal-packed-symbol-price(freqs, words, deflate-main-code-extra, 0u64, cost1).

fixed-packed-price := [8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 8u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 9u8 0u8 7u8 7u8 7u8 7u8 7u8 7u8 7u8 7u8 8u8 8u8 8u8 8u8 9u8 9u8 9u8 9u8 10u8 10u8 10u8 10u8 11u8 11u8 11u8 12u8 13u8 13u8 13u8 13u8 8u8 0u8 0u8 5u8 5u8 5u8 5u8 6u8 6u8 7u8 7u8 8u8 8u8 9u8 9u8 10u8 10u8 11u8 11u8 12u8 12u8 13u8 13u8 14u8 14u8 15u8 15u8 16u8 16u8 17u8 17u8 18u8 18u8 0u8 0u8]

block-fixed-packed-cost(freqs<[u32]>, prices<[u8]>, sym<u64>, cost<u64>) => (out<u64>) :=
  more := sym < 320u64
  frequency := (more? | true => huff-word(huff-get32(freqs, sym)) | false => 0u64)
  width<u64> := (more? | true => huff-get8(prices, sym) | false => 0u8)
  next := cost + frequency * width
  out := (more? | true => block-fixed-packed-cost(freqs, prices, sym + 1u64, next) | false => cost).

block-compute-packed-prices(dynamic-price<u64>, freqs<[u32]>, block-length<u64>, bitcount<u64>) => (out<block-costs>) :=
  dynamic := dynamic-price + 3u64
  fixed := block-fixed-packed-cost(freqs, fixed-packed-price, 0u64, 10u64)
  blocks := (block-length + 65534u64) / 65535u64
  stored := 3u64 + bits/and(bits/wrapping-sub(0u64, bitcount + 3u64), 7u64) + 32u64 + 40u64 * (blocks - 1u64) + 8u64 * block-length
  out := {dynamic: dynamic, fixed: fixed, stored: stored, kind: block-choose-kind(dynamic, fixed, stored)}.

block-flush-packed(bytes<[u8]>, bitbuf<u64>, bitcount<u64>, input<[u8]>, begin<u64>, length<u64>, freqs<[u32]>, codewords<[u32]>, static-codewords<[u32]>, items<[u64]>, use-items<u64>, final<u64>, precode<block-precode>, priced<u64>, permutation<[u8]>, extra-precode<[u8]>, recipes<[u32]>, offset-slots<[u8]>) => (out<path-written>) :=
  costs := block-compute-packed-prices(priced, freqs, length, bitcount)
  in-end := begin + length
  out := ((costs.kind == 0u64)? | true => block-store-at(bytes, bitbuf, bitcount, input, begin, in-end, final) | false => block-write-combined(bytes, bitbuf, bitcount, input, begin, length, items, use-items, final, costs.kind == 1u64, precode, codewords, static-codewords, permutation, extra-precode, recipes, offset-slots)).

<optimal-parse-tally> := <{freqs<[u32]> codewords<[u32]>}>
<optimal-parse-codes> := <{tallied<optimal-parse-tally> precode<block-precode>}>

optimal-build-parse-alphabet(alphabet<u64>, literals-only<bool>, freqs<[u32]>, all-freqs<[u32]>, words<[u32]>, precode-freqs<[u32]>, items<[u32]>, num-items<u64>, num-litlen-syms<u64>, num-offset-syms<u64>, permutation<[u8]>, reversed<[u8]>) => (out<optimal-parse-codes>) :=
  offset-alphabet := alphabet == 1u64
  symbols := (alphabet? | 0u64 => 288u64 | 1u64 => 32u64 | * => 19u64)
  maximum := (alphabet? | 0u64 => 14u64 | 1u64 => 15u64 | * => 7u64)
  entries := [0u32 | i <- 0u64..=symbols, i < symbols]
  words0 := [0u32 | i <- 0u64..=symbols, i < symbols]
  freq-start := (offset-alphabet? | true => 288u64 | false => 0u64)
  code := huff-packed-make-code-selected(symbols, maximum, freqs, freq-start, entries, words0, reversed, literals-only && offset-alphabet)
  literal-alphabet := alphabet == 0u64
  next-words := (literal-alphabet? | true => code | false => (offset-alphabet? | true => sequence/append-sublist(words, code, 0u64, 32u64) | false => words))
  carried := {freqs: precode-freqs, items: items, num-items: num-items, num-litlen-syms: num-litlen-syms, num-offset-syms: num-offset-syms}
  prepared := (offset-alphabet? | true => block-prepare-packed-header(next-words) | false => carried)
  next-freqs := (literal-alphabet? | true => all-freqs | false => prepared.freqs)
  out := ((alphabet < 2u64)?
    | true => optimal-build-parse-alphabet(alphabet + 1u64, literals-only, next-freqs, all-freqs, next-words, prepared.freqs, prepared.items, prepared.num-items, prepared.num-litlen-syms, prepared.num-offset-syms, permutation, reversed)
    | false => {tallied: {freqs: all-freqs, codewords: words}, precode: block-finish-header(carried, code, permutation)}).

optimal-build-parse-codes(freqs<[u32]>, permutation<[u8]>, reversed<[u8]>, literals-only<bool>) => (out<optimal-parse-codes>) :=
  out := optimal-build-parse-alphabet(0u64, literals-only, freqs, freqs, freqs, freqs, freqs, 0u64, 0u64, 0u64, permutation, reversed).

deflate-fixed-price-literal := [128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32]
deflate-fixed-price-length := [0u32 0u32 0u32 112u32 112u32 112u32 112u32 112u32 112u32 112u32 112u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 128u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 144u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 160u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 176u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 192u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 208u32 128u32]
deflate-fixed-price-offset := [80u32 80u32 80u32 80u32 96u32 96u32 112u32 112u32 128u32 128u32 144u32 144u32 160u32 160u32 176u32 176u32 192u32 192u32 208u32 208u32 224u32 224u32 240u32 240u32 256u32 256u32 272u32 272u32 288u32 288u32 80u32 80u32]

optimal-read-fixed-costs() => (out<optimal-costs>) :=
  literal := sequence/reserve(deflate-fixed-price-literal, 0u64)
  length := sequence/reserve(deflate-fixed-price-length, 0u64)
  offset := sequence/reserve(deflate-fixed-price-offset, 0u64)
  out := {literal: literal, length: length, offset-slot: offset}.

optimal-price-fixed-nodes(nodes<[u64]>) => (out<u64>) :=
  count := sequence/length(nodes)
  last := ((count != 0u64)? | true => nodes[count] | false => 0u64)
  out := bits/and(last, 4294967295u64) / 16u64 + 7u64.

optimal-blend-packed-price-at(values<[u32]>, entries<[u16]>, literal-price<u64>, length-price<u64>, weight<u64>, at<u64>) => (out<[u32]>) :=
  more := at < 547u64
  entry<u64> := (more? | true => entries[at + 1u64] | false => 0u16)
  extra := bits/shift-right-wrap(entry, 9u64)
  base := ((at < 259u64)? | true => length-price | false => ((at < 515u64)? | true => literal-price | false => 78u64))
  current := (more? | true => huff-get32(values, at) | false => 0u32)
  price := optimal-blend-cost(current, base + extra * 16u64, weight)
  next := (more? | true => huff-set32(values, at, price) | false => values)
  out := (more? | true => optimal-blend-packed-price-at(next, entries, literal-price, length-price, weight, at + 1u64) | false => values).

optimal-initialize-parse(first<u64>, frequencies<[u32]>, previous-observations<[u32]>, previous-number<u64>, observations<[u32]>, number<u64>, table0<[u8]>, table1<[u8]>, table2<[u8]>, symbol-costs<[u8]>, freqs-litlen<[u32]>, length<u64>, costs<[u32]>) => (out<[u32]>) :=
  defaults := optimal-choose-default-costs-from-counts(freqs-litlen, length, frequencies, 300u64, table0, table1, table2, symbol-costs)
  weight := ((first == 1u64)? | true => 8u64 | false => optimal-default-weight(previous-observations, previous-number, observations, number))
  out := optimal-blend-packed-price-at(costs, deflate-main-price-entries, defaults.lit-cost, defaults.len-sym-cost, weight, 3u64).

// Kind 1 builds the literal model. Kind 2 prices the fixed path.
// Kinds 3 and 4 select the fixed path and restore the literal model.
// Kind 0 runs the dynamic model.
optimal-solve-and-select(pass-kind<u64>, final-literals<bool>, first<u64>, frequencies<[u32]>, previous-observations<[u32]>, previous-number<u64>, observations<[u32]>, number<u64>, table0<[u8]>, table1<[u8]>, table2<[u8]>, symbol-costs<[u8]>, optimizing<bool>, rebuild<bool>, nodes<[u64]>, model-costs<[u32]>, saved-costs<[u32]>, best<u64>, remaining<u64>, previous-freqs<[u32]>, previous-codewords<[u32]>, previous-valid<bool>, length<u64>, cache<[u32]>, cache-end<u64>, literal-freqs<[u32]>, only-literals-cost<u64>, static-cost<u64>, length-slots<[u8]>, offset-slots<[u8]>, permutation<[u8]>, extra-precode<[u8]>, reversed<[u8]>, previous-header-freqs<[u32]>, previous-header-codewords<[u32]>, previous-header-items<[u32]>, previous-header-num-items<u64>, previous-header-num-litlen-syms<u64>, previous-header-num-offset-syms<u64>, previous-header-num-explicit-lens<u64>) => (out<optimal-planned-block>) :=
  seed := pass-kind == 1u64
  pricing := pass-kind == 2u64
  restoring-literals := pass-kind == 4u64
  fixed := pricing || (pass-kind == 3u64)
  model := (fixed? | true => optimal-read-fixed-packed-costs() | false => model-costs)
  path := ((seed || restoring-literals)?
    | true => {nodes: nodes}
    | false => optimal-find-packed-cost-path(length, cache, cache-end, nodes, model, offset-slots))
  counted := ((seed || pricing || restoring-literals)?
    | true => literal-freqs
    | false => optimal-count-packed-path(path.nodes, length, length-slots, offset-slots))
  same := ((seed || restoring-literals)?
    | true => false
    | false => (pricing?
      | true => true
      | false => ((previous-valid)? | true => optimal-frequency-equal(counted, previous-freqs, 0u64, 320u64) | false => false)))
  codes := (same?
    | true => {tallied: {freqs: counted, codewords: previous-codewords},
        precode: {freqs: previous-header-freqs, codewords: previous-header-codewords, items: previous-header-items, num-items: previous-header-num-items, num-litlen-syms: previous-header-num-litlen-syms, num-offset-syms: previous-header-num-offset-syms, num-explicit-lens: previous-header-num-explicit-lens}}
    | false => optimal-build-parse-codes(counted, permutation, reversed, seed || restoring-literals))
  tallied := codes.tallied
  precode := codes.precode
  cached-price := ((best == 18446744073709551615u64)? | true => only-literals-cost | false => best)
  model-price := (restoring-literals? | true => only-literals-cost | false => cached-price)
  actual := ((same || restoring-literals)? | true => model-price | false => optimal-price-packed-header(precode, tallied.codewords, tallied.freqs, extra-precode))
  improving := ((optimizing && !seed)? | true => actual + 1u64 <= best | false => false)
  next-best := (improving? | true => actual | false => best)
  next-saved := (improving? | true => model | false => saved-costs)
  next-costs := ((improving || rebuild)?
    | true => optimal-set-packed-costs-from-codes(tallied.codewords, model)
    | false => model)
  passes := (improving? | true => remaining - 1u64 | false => remaining)
  can-repeat := improving && (passes != 0u64)
  stable := ((can-repeat && (length >= 16384u64))?
    | true => optimal-frequency-equal(model, next-costs, 0u64, 547u64)
    | false => false)
  more := can-repeat && !stable
  alternative := optimizing && !seed && !more && (bt-minimum(only-literals-cost, static-cost) < next-best)
  use-literals := only-literals-cost < static-cost
  replay-fixed := alternative && !use-literals
  restore-saved := ((optimizing && !seed && !more && !alternative)? | true => actual >= next-best + 1u64 | false => false)
  replay-literals := alternative && use-literals
  replay-model := (restore-saved? | true => next-saved | false => next-costs)
  price-first := seed && !final-literals && (length <= 10000u64)
  start-parse := (seed && !final-literals && !price-first) || pricing
  next-model := (start-parse?
    | true => optimal-initialize-parse(first, frequencies, previous-observations, previous-number, observations, number, table0, table1, table2, symbol-costs, tallied.freqs, length, model-costs)
    | false => replay-model)
  fixed-price := (pricing? | true => optimal-price-fixed-nodes(path.nodes) | false => static-cost)
  next-stage := (price-first?
    | true => 2u64
    | false => (replay-fixed? | true => 3u64 | false => (replay-literals? | true => 4u64 | false => 0u64)))
  literal-price := (seed? | true => actual | false => only-literals-cost)
  next-optimizing := start-parse || more
  rerun := price-first || start-parse || more || replay-fixed || restore-saved || replay-literals
  next-rebuild := restore-saved || replay-literals
  out := (rerun?
    | true => optimal-solve-and-select(next-stage, final-literals, first, frequencies, previous-observations, previous-number, observations, number, table0, table1, table2, symbol-costs, next-optimizing, next-rebuild, path.nodes, next-model, next-saved, next-best, passes, tallied.freqs, tallied.codewords, next-optimizing, length, cache, cache-end, literal-freqs, literal-price, fixed-price, length-slots, offset-slots, permutation, extra-precode, reversed, precode.freqs, precode.codewords, precode.items, precode.num-items, precode.num-litlen-syms, precode.num-offset-syms, precode.num-explicit-lens)
    | false => ((seed || restoring-literals)?
      | true => optimal-final-literal-block(tallied, precode, actual, path.nodes, next-costs, next-saved)
      | false => optimal-complete-path(path.nodes, next-costs, tallied, next-saved, precode, actual))).

optimal-default-weight(previous-observations<[u32]>, previous-number<u64>, observations<[u32]>, number<u64>) => (out<u64>) :=
  delta := optimal-observation-delta(observations, previous-observations, number, previous-number, 0u64, 0u64)
  cutoff := previous-number * number * 200u64 / 512u64
  out := ((delta > 3u64 * cutoff)? | true => 8u64
    | false => ((4u64 * delta > 9u64 * cutoff)? | true => 6u64
      | false => ((2u64 * delta > 3u64 * cutoff)? | true => 5u64
        | false => ((2u64 * delta > cutoff)? | true => 4u64 | false => 2u64)))).

optimal-final-literal-block(tallied<optimal-parse-tally>, precode<block-precode>, price<u64>, nodes<[u64]>, costs<[u32]>, saved<[u32]>) => (out<optimal-planned-block>) :=
  selected := {nodes: nodes, costs: costs, tallied: tallied, use-items: 0u64, used-only-literals: 1u64}
  out := {selected: selected, saved: saved, precode: precode, priced: price}.

optimal-plan-block(input<[u8]>, begin<u64>, length<u64>, first<u64>, frequencies<[u32]>, cache<[u32]>, cache-end<u64>, nodes<[u64]>, costs<[u32]>, saved<[u32]>, previous-observations<[u32]>, previous-number<u64>, observations<[u32]>, number<u64>, length-slots<[u8]>, offset-slots<[u8]>, table0<[u8]>, table1<[u8]>, table2<[u8]>, symbol-costs<[u8]>, permutation<[u8]>, extra-precode<[u8]>, reversed<[u8]>, final-literals<bool>) => (out<optimal-planned-block>) :=
  counts := optimal-count-packed-literals(input, begin, length)
  out := optimal-solve-and-select(1u64, final-literals, first, frequencies, previous-observations, previous-number, observations, number, table0, table1, table2, symbol-costs, false, false, nodes, costs, saved, 18446744073709551615u64, 10u64, counts, counts, false, length, cache, cache-end, counts, 0u64, 18446744073709551615u64, length-slots, offset-slots, permutation, extra-precode, reversed, counts, counts, counts, 0u64, 0u64, 0u64, 0u64).

