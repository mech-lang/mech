deflate-packed-writer-recipes := [0u32 0u32 0u32 257u32 258u32 259u32 260u32 261u32 262u32 263u32 264u32 777u32 4873u32 778u32 4874u32 779u32 4875u32 780u32 4876u32 1293u32 5389u32 9485u32 13581u32 1294u32 5390u32 9486u32 13582u32 1295u32 5391u32 9487u32 13583u32 1296u32 5392u32 9488u32 13584u32 1809u32 5905u32 10001u32 14097u32 18193u32 22289u32 26385u32 30481u32 1810u32 5906u32 10002u32 14098u32 18194u32 22290u32 26386u32 30482u32 1811u32 5907u32 10003u32 14099u32 18195u32 22291u32 26387u32 30483u32 1812u32 5908u32 10004u32 14100u32 18196u32 22292u32 26388u32 30484u32 2325u32 6421u32 10517u32 14613u32 18709u32 22805u32 26901u32 30997u32 35093u32 39189u32 43285u32 47381u32 51477u32 55573u32 59669u32 63765u32 2326u32 6422u32 10518u32 14614u32 18710u32 22806u32 26902u32 30998u32 35094u32 39190u32 43286u32 47382u32 51478u32 55574u32 59670u32 63766u32 2327u32 6423u32 10519u32 14615u32 18711u32 22807u32 26903u32 30999u32 35095u32 39191u32 43287u32 47383u32 51479u32 55575u32 59671u32 63767u32 2328u32 6424u32 10520u32 14616u32 18712u32 22808u32 26904u32 31000u32 35096u32 39192u32 43288u32 47384u32 51480u32 55576u32 59672u32 63768u32 2841u32 6937u32 11033u32 15129u32 19225u32 23321u32 27417u32 31513u32 35609u32 39705u32 43801u32 47897u32 51993u32 56089u32 60185u32 64281u32 68377u32 72473u32 76569u32 80665u32 84761u32 88857u32 92953u32 97049u32 101145u32 105241u32 109337u32 113433u32 117529u32 121625u32 125721u32 129817u32 2842u32 6938u32 11034u32 15130u32 19226u32 23322u32 27418u32 31514u32 35610u32 39706u32 43802u32 47898u32 51994u32 56090u32 60186u32 64282u32 68378u32 72474u32 76570u32 80666u32 84762u32 88858u32 92954u32 97050u32 101146u32 105242u32 109338u32 113434u32 117530u32 121626u32 125722u32 129818u32 2843u32 6939u32 11035u32 15131u32 19227u32 23323u32 27419u32 31515u32 35611u32 39707u32 43803u32 47899u32 51995u32 56091u32 60187u32 64283u32 68379u32 72475u32 76571u32 80667u32 84763u32 88859u32 92955u32 97051u32 101147u32 105243u32 109339u32 113435u32 117531u32 121627u32 125723u32 129819u32 2844u32 6940u32 11036u32 15132u32 19228u32 23324u32 27420u32 31516u32 35612u32 39708u32 43804u32 47900u32 51996u32 56092u32 60188u32 64284u32 68380u32 72476u32 76572u32 80668u32 84764u32 88860u32 92956u32 97052u32 101148u32 105244u32 109340u32 113436u32 117532u32 121628u32 125724u32 285u32 1u32 2u32 3u32 4u32 65541u32 65543u32 131081u32 131085u32 196625u32 196633u32 262177u32 262193u32 327745u32 327777u32 393345u32 393409u32 459009u32 459137u32 524801u32 525057u32 590849u32 591361u32 657409u32 658433u32 724993u32 727041u32 794625u32 798721u32 868353u32 876545u32 0u32 0u32]

<block-fixed-words> := <{litlen-codewords<[u32]> offset-codewords<[u32]>}>
block-read-fixed-codes() => (out<block-fixed-words>) :=
  litlen-codewords := sequence/reserve(deflate-fixed-litlen-codewords, 0u64)
  offset-codewords := sequence/reserve(deflate-fixed-offset-codewords, 0u64)
  out := {litlen-codewords: litlen-codewords, offset-codewords: offset-codewords}.

optimal-compress(input<[u8]>, output<[u8]>) => (out<[u8]>) :=
  n := sequence/length(input)
  static := sequence/reserve(deflate-fixed-main-codewords, 0u64)
  bytes := sequence/reserve(output, deflate-compress-bound(n))
  tables := initial-nodes(262144u64)
  cache-positions := bt-minimum(n, 6000u64)
  cache-size := bt-minimum(1500513u64, bits/wrapping-mul(cache-positions, 257u64))
  cache := [0u32 | i <- 0u64..=cache-size, i < cache-size]
  node-capacity := bits/wrapping-add(bt-minimum(n, 304999u64), 258u64)
  nodes := sequence/with-capacity(0u64, node-capacity)
  costs := [0u32 | i <- 0u64..=547u64, i < 547u64]
  saved := [0u32 | i <- 0u64..=547u64, i < 547u64]
  frequencies := [0u32 | i <- 0u64..=259u64, i < 259u64]
  fresh-frequencies := [0u32 | i <- 0u64..=259u64, i < 259u64]
  previous-observations := [0u32 | i <- 0u64..=10u64, i < 10u64]
  fresh-observations := [0u32 | i <- 0u64..=10u64, i < 10u64]
  observations := [0u32 | i <- 0u64..=10u64, i < 10u64]
  stream := optimal-compress-blocks(input, bytes, 0u64, 0u64, tables, cache, nodes, 0u64, 0u64, 0u64, 0u64, 0u64, bt-minimum(n, 32768u64), 0u64, costs, saved, frequencies, fresh-frequencies, previous-observations, 0u64, observations, fresh-observations, 0u64, 0u64, 0u64, static)
  out := ((stream.bitcount > 0u64)? | true => sequence/append(stream.bytes, huff-byte(stream.bitbuf)) | false => stream.bytes).

deflate-store-uncompressed(input<[u8]>, output<[u8]>) => (out<[u8]>) :=
  n := sequence/length(input)
  bytes := sequence/reserve(output, n + 5u64 * (n / 65535u64 + 1u64))
  stored := ((n == 0u64)?
    | true => {bytes: sequence/append-le-bytes(sequence/append(bytes, 1u8), 4294901760u64, 4u8), bitbuf: 0u64, bitcount: 0u64}
    | false => block-write-stored(bytes, 0u64, 0u64, input, 0u64, n, 1u64))
  out := stored.bytes.

deflate-compress-into(input<[u8]>, output<[u8]>) => (out<[u8]>) :=
  out := ((sequence/length(input) <= 7u64)? | true => deflate-store-uncompressed(input, output) | false => optimal-compress(input, output)).

deflate-compress-into(input<[u8]>, output<[u8]>)
