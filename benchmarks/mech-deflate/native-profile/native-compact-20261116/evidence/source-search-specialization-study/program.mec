  block-length := collected.block-end - collected.block-begin
  first := ((collected.block-begin == 0u64)? | true => 1u64 | false => 0u64)
  final-literals := (first == 1u64) && (collected.is-final == 1u64) && (collected.cache-end == block-length)
  planned := optimal-plan-block(input, collected.block-begin, block-length, first, collected.frequencies, collected.cache, collected.cache-end, nodes, costs, saved, previous-observations, previous-number, collected.observations, collected.number-observations, deflate-table-length-slots, deflate-table-offset-slots, deflate-table-default0, deflate-table-default1, deflate-table-default2, deflate-table-symbol-costs, deflate-table-permutation, deflate-table-precode-extra, deflate-table-reversed, final-literals)
  selected := planned.selected
  tallied := selected.tallied
  flushed := block-flush-packed(bytes, bitbuf, bitcount, input, collected.block-begin, block-length, tallied.freqs, tallied.codewords, static-codewords, selected.nodes, selected.use-items, collected.is-final, planned.precode, planned.priced, deflate-table-permutation, deflate-table-precode-extra, deflate-packed-writer-recipes, deflate-table-offset-slots)
  carried := optimal-carry-block(collected.cache, collected.cache-end, collected.rewound, collected.changed, collected.have-previous-check, collected.fresh-frequencies, collected.fresh-observations, collected.number-fresh, collected.next-position, collected.block-end)
  next-tables := collected.tables
  next-cache := carried.cache
  next-nodes := selected.nodes
  next-hash3 := collected.next-hash3
  next-hash4 := collected.next-hash4
  next-position := collected.next-position
  next-begin := carried.block-begin
  next-base := collected.base
  next-slide-at := collected.next-slide
  next-pointer := carried.cache-ptr
  next-frequencies := carried.frequencies
  next-fresh-frequencies := carried.fresh-frequencies
  next-previous := collected.observations
  next-previous-number := collected.number-observations
  next-observations := carried.observations
  next-fresh-observations := carried.fresh-observations
  next-number := carried.number-observations
  next-fresh-number := carried.number-fresh
  next-only-literals := selected.used-only-literals
  next-bytes := flushed.bytes
  next-bitbuf := flushed.bitbuf
  next-bitcount := flushed.bitcount
  out := ((next-position == sequence/length(input))?
    | true => {bytes: next-bytes, bitbuf: next-bitbuf, bitcount: next-bitcount}
    | false => optimal-compress-blocks(input, next-bytes, next-bitbuf, next-bitcount, next-tables, next-cache, next-nodes, next-hash3, next-hash4, next-position, next-begin, next-base, next-slide-at, next-pointer, selected.costs, planned.saved, next-frequencies, next-fresh-frequencies, next-previous, next-previous-number, next-observations, next-fresh-observations, next-number, next-fresh-number, next-only-literals, static-codewords)).

