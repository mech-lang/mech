deflate-compress-bound(length<u64>) => (out<u64>) :=
  blocks := (length + 4999u64) / 5000u64
  nonzero := ((blocks == 0u64)? | true => 1u64 | false => blocks)
  out := 5u64 * nonzero + length.

optimal-compress-blocks(input<[u8]>, bytes<[u8]>, bitbuf<u64>, bitcount<u64>, tables<[u16]>, cache<[u32]>, nodes<[u64]>, hash3<u64>, hash4<u64>, position<u64>, begin<u64>, base<u64>, next-slide<u64>, pointer<u64>, costs<[u32]>, saved<[u32]>, frequencies<[u32]>, fresh-frequencies<[u32]>, previous-observations<[u32]>, previous-number<u64>, observations<[u32]>, fresh-observations<[u32]>, number-observations<u64>, number-fresh<u64>, previous-only-literals<u64>, static-codewords<[u32]>) => (out<path-written>) :=
