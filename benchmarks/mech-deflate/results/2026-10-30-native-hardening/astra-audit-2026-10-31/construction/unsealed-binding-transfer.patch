+    fn unsealed_binding_transfers_its_existing_descriptors() {
+        let binding = Binding::scalar(NativeScalarOp::U64Add);
+        let request = binding.request();
+        let kernel = custom_factory(&request).unwrap();
+        assert!(kernel.lowering_witness::<CandidateWitness>().is_none());
+        let accounting = kernel.work_accounting();
+        let call = binding.call("math", "add");
