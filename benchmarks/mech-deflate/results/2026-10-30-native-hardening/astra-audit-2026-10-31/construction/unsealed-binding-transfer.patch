+        let output_descriptors = call.outputs().as_ptr();
+        let bound = bind_call(kernel, &request, call);
+        assert!(validated_scalar(&bound).is_none());
+        assert_eq!(bound.work_accounting(), accounting);
+        let retained = bound.bound_call().unwrap();
+        assert_eq!(retained.inputs().as_ptr(), input_descriptors);
