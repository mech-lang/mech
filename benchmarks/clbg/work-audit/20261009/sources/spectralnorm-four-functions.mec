n := io/argument-u64(1)
indices := 0..n
coefficient(i<u64>, j<u64>) => <f64> := 1.0 / number/to-f64((i + j) * (i + j + 1) / 2 + i + 1)
A := [[coefficient(i, j) | j <- indices]' | i <- indices]'
apply(x<[f64]>) => <[f64]> := A ** x
apply-transpose(x<[f64]>) => <[f64]> := A' ** x
step(x<[f64]>) => <[f64]> := x |> apply |> apply-transpose
seed := [1.0 | i <- indices]'
v := sequence/iterate(seed, 19, step)
u := v |> step
norm := math/sqrt((u · v) / (v · v))
io/write(string/concat(number/format(norm, 9), "\n"))
