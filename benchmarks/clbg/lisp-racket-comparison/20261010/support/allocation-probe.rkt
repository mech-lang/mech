#lang racket/base
(require racket/cmdline racket/port)
(define source (vector-ref (current-command-line-arguments) 0))
(parameterize ([current-command-line-arguments #("6")]
               [current-output-port (open-output-nowhere)])
  (dynamic-require `(file ,source) #f))
(define space (module->namespace `(file ,source)))
(define constructor (parameterize ([current-namespace space]) (eval 'make)))
(define (make d) (if (procedure-arity-includes? constructor 1) (constructor d) (constructor 0 d)))
(define node-left (parameterize ([current-namespace space]) (eval 'node-left)))
(define node-right (parameterize ([current-namespace space]) (eval 'node-right)))
(define root (make 5))
(define seen (make-hasheq))
(define (walk tree)
  (when (hash-has-key? seen tree) (error 'allocation "shared node"))
  (hash-set! seen tree #t)
  (define left (if (pair? tree) (car tree) (node-left tree)))
  (define right (if (pair? tree) (cdr tree) (node-right tree)))
  (when left (walk left) (walk right)))
(when (eq? (make 0) (make 0)) (error 'allocation "shared leaf"))
(walk root)
(unless (= (hash-count seen) 63) (error 'allocation "wrong count"))
(collect-garbage)
(displayln "FRESH 63 NODES, EACH WITH AT LEAST TWO CHILD SLOTS")
