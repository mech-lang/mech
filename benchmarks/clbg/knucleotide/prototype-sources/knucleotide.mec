sequence := bytes/encode(text/record(io/read(), ">THREE", ">"), "ACGT", "ignore-ascii-case")
eighteen := map/histogram(sequence/packed-windows(sequence, 2, 18))
twelve := map/histogram(sequence/packed-windows(sequence, 2, 12))
six := map/histogram(sequence/packed-windows(sequence, 2, 6))
four := map/histogram(sequence/packed-windows(sequence, 2, 4))
three := map/histogram(sequence/packed-windows(sequence, 2, 3))
two := map/histogram(sequence/packed-windows(sequence, 2, 2))
one := map/histogram(sequence/packed-windows(sequence, 2, 1))
io/write(format/frequencies(one, "ACGT", 100, 3))
io/write(format/frequencies(two, "ACGT", 100, 3))
io/write(format/lookup(three, "GGT", "ACGT", "\t"))
io/write(format/lookup(four, "GGTA", "ACGT", "\t"))
io/write(format/lookup(six, "GGTATT", "ACGT", "\t"))
io/write(format/lookup(twelve, "GGTATTTTAATT", "ACGT", "\t"))
io/write(format/lookup(eighteen, "GGTATTTTAATTTATAGT", "ACGT", "\t"))
