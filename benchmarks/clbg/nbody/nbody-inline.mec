-- Benchmarks Game: Sun, Jupiter, Saturn, Uranus, Neptune; dt = 0.01.
+> combinatorics
+> stats

solar-mass := 4 * 3.141592653589793 * 3.141592653589793
planet-x := [4.84143144246472090 -1.16032004402742839 -0.103622044471123109;
             8.34336671824457987 4.12479856412430479 -0.403523417114321381;
             12.8943695621391310 -15.1111514016986312 -0.223307578892655734;
             15.3796971148509165 -25.9193146099879641 0.179258772950371181]
planet-v := [0.00166007664274403694 0.00769901118419740425 -0.0000690460016972063023;
             -0.00276742510726862411 0.00499852801234917238 0.0000230417297573763929;
             0.00296460137564761618 0.00237847173959480950 -0.0000296589568540237556;
             0.00268067772490389322 0.00162824170038242295 -0.000095159225451971587] * 365.24
planet-m := [0.000954791938424326609; 0.000285885980666130812;
             0.0000436624404335156298; 0.0000515138902046611451] * solar-mass
~x := [0 0 0; planet-x]
~v := [-stats/sum/row(planet-v * planet-m) / solar-mass; planet-v]
m := [solar-mass; planet-m]
pairs := combinatorics/n-choose-k(1..=5,2)
d := x[pairs[1,:],:] - x[pairs[2,:],:]
distance² := stats/sum/column(d ^ 2)
energy := stats/sum/row(0.5 * m * stats/sum/column(v ^ 2)) - stats/sum/row(m[pairs[1,:]] * m[pairs[2,:]] / distance² ^ 0.5)

mag := 0.01 / (distance² * distance² ^ 0.5)
v[pairs[1,:],:] -= d * m[pairs[2,:]] * mag
v[pairs[2,:],:] += d * m[pairs[1,:]] * mag
x += v * 0.01
energy
