<node> := <{left<ref>, right<ref>}>
Leaf(depth<u64>) => <ref> := memory/allocate({left: memory/null(), right: memory/null()})
Branch(depth<u64>) = (root<ref>) :=
  left := Make(depth - 1)
  right := Make(depth - 1)
  root := memory/allocate({left: left, right: right}).
Make(depth<u64>) => <ref> := control/if(depth == 0, Leaf, Branch, depth)
One(left<ref>, right<ref>) => <u64> := 1
CountChildren(left<ref>, right<ref>) => <u64> := 1 + Count(left) + Count(right)
Count(root<ref>) = (count<u64>) :=
  node := memory/read(root, <node>)
  count := control/if(node.left == memory/null(), One, CountChildren, (node.left, node.right)).
Tree(depth<u64>) => <u64> := depth |> Make |> Count
More(index<u64>, end<u64>, depth<u64>, sum<u64>) => <bool> := index < end
Step(index<u64>, end<u64>, depth<u64>, sum<u64>) = (next<u64>, stop<u64>, d<u64>, check<u64>) :=
  count := memory/with-frame(Tree, depth)
  next := index + 1
  stop := end
  d := depth
  check := sum + count.
AllocatedChunk(start<u64>, end<u64>, depth<u64>) = (check<u64>) :=
  (index, stop, d, check) := control/while((start, end, depth, 0), More, Step).
Chunk(start<u64>, end<u64>, depth<u64>) = (check<u64>) :=
  capacity := number/shift-left(1, depth + 1) - 1
  check := memory/with-arena(capacity, <node>, AllocatedChunk, (start, end, depth)).
MoreDepths(depth<u64>, maximum<u64>) => <bool> := depth <= maximum
Depth(depth<u64>, maximum<u64>) = (next<u64>, stop<u64>) :=
  iterations := number/shift-left(1, maximum - depth + 4)
  check := parallel/reduce-ranges(0, iterations, number/max(1, iterations / 64), Chunk, depth, "sum")
  printed := io/print("{}\t trees of depth {}\t check: {}\n", iterations, depth, check)
  next := depth + 2
  stop := maximum.
Long(maximum<u64>) = (check<u64>) :=
  long-lived := Make(maximum)
  (done, stop) := control/while((4, maximum), MoreDepths, Depth)
  check := Count(long-lived).
n := number/bounded(io/argument-u64(1), 0, 21)
maximum := number/max(6, n)
stretch-count := memory/with-arena(number/shift-left(1, maximum + 2) - 1, <node>, Tree, maximum + 1)
stretch-line := io/print("stretch tree of depth {}\t check: {}\n", maximum + 1, stretch-count)
long-count := memory/with-arena(number/shift-left(1, maximum + 1) - 1, <node>, Long, maximum)
long-line := io/print("long lived tree of depth {}\t check: {}\n", maximum, long-count)
