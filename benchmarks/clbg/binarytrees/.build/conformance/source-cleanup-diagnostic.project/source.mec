<node> := <{left<ref>, right<ref>}>
Make(depth<u64>) => <ref>
  | 0 => memory/allocate({left: memory/null(), right: memory/null()})
  | d => memory/allocate({left: Make(d - 1), right: Make(d - 1)}).
Count(root<ref>) = (count<u64>) :=
  node := memory/read(root, <node>)
  count := (node.left ? | memory/null() => 1 | * => 1 + Count(node.left) + Count(node.right)).
Tree(depth<u64>) = (check<u64>) :=
  check := Count(Make(depth)).
AllocatedChunk(start<u64>, end<u64>, depth<u64>) = (check<u64>) :=
  check := stats/sum([memory/with-frame(Tree, depth) | i <- start..end]).
Chunk(start<u64>, end<u64>, depth<u64>) = (check<u64>) :=
  check := memory/with-arena(number/shift-left(1, depth + 1) - 1, <node>, AllocatedChunk, (start, end, depth)).
Depth(depth<u64>, maximum<u64>) = (check<u64>) :=
  iterations := number/shift-left(1, maximum - depth + 4)
  check := parallel/reduce-ranges(0, iterations, number/max(1, iterations / 64), Chunk, depth, "sum")
  printed := io/print("{}\t trees of depth {}\t check: {}\n", iterations, depth, check).
Long(maximum<u64>) = (check<u64>) :=
  long-lived := Make(maximum)
  done := stats/sum([Depth(d, maximum) | d <- 4..2..=maximum])
  check := Count(long-lived).
n := number/bounded(io/argument-u64(1), 0, 21)
maximum := number/max(6, n)
stretch-count := memory/with-arena(number/shift-left(1, maximum + 2) - 1, <node>, Tree, maximum + 1)
stretch-line := io/print("stretch tree of depth {}\t check: {}\n", maximum + 1, stretch-count)
long-count := memory/with-arena(number/shift-left(1, maximum + 1) - 1, <node>, Long, maximum)
long-line := io/print("long lived tree of depth {}\t check: {}\n", maximum, long-count)
