a := heap/new-refs((heap/null(), heap/null()))
b := heap/new-refs((heap/null(), heap/null()))
c := heap/new-refs((a, b))
(l, r) := heap/read-refs(c, 2)
line := io/print("{} {}\n", control/select(a != b, 1, 0), control/select(l == a && r == b, 1, 0))
(x, y) := heap/take-refs(c, 2)
(al, ar) := heap/take-refs(a, 2)
(bl, br) := heap/take-refs(b, 2)
(allocated, freed, live, peak) := heap/stats()
io/print("{} {} {} {}\n", allocated, freed, live, peak)
