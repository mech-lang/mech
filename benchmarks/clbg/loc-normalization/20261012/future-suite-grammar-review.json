  "api_plan": {
    "modules": [
      "foreign_nim.py",
      "foreign_crystal.py",
      "foreign_pony.py"
    ],
    "entry_points": [
      "mask_<family>(source)",
      "classify_scopes(cleaned, language, literal_spans=(), directives=())",
      "binding_counter",
      "normalize"
    ],
    "mask_contract": [
      "offset-preserving cleaned text",
      "literal/comment/identifier spans",
      "retained directives",
      "diagnostics"
    ],
    "grammar_selection": "language/source syntax only; no benchmark/input/helper-name selector",
    "shared_event_model": "foreign_core; ownership must be proved before integration",
    "no_raw_producer_loc_fallback": true
  },
  "fixture_groups": [
    {
      "id": "mask-offsets",
      "families": [
        "nim",
        "crystal",
        "pony"
      ],
      "checks": [
        "same character count and exact CR/LF positions",
        "comments opaque",
        "strings/characters opaque",
        "unclosed literal/comment diagnostics",
        "no original-source mutation"
      ]
    },
    {
      "id": "nim-lexical",
      "families": [
        "nim"
      ],
      "checks": [
        "nested #[ ]#",
        "re-prefixed/generalized raw string",
        "triple string",
        "'A' versus 0'u64",
        "backtick identifier",
        "retain {.inline/thread/acyclic.} and pragma evidence"
      ]
    },
    {
      "id": "crystal-lexical",
      "families": [
        "crystal"
      ],
      "checks": [
        "/regex/ versus / and // division",
        "nested #{...} containing quoted expression",
        "character versus string",
        "percent/heredoc ambiguity gates",
        "member .end versus scope end"
      ]
    },
    {
      "id": "pony-lexical",
      "families": [
        "pony"
      ],
      "checks": [
        "// versus strings",
        "nested /* */",
        "triple string",
        "'A' versus word' identifier",
        "partial ? retained",
        "=> retained"
      ]
    },
    {
      "id": "section-type-field-formals",
      "families": [
        "nim",
        "crystal",
        "pony"
      ],
      "checks": [
        "declaration section opener zero",
        "actual named type header",
        "independent type fields",
        "formal grouped names/defaults structural",
        "constructor data fields structural",
        "@field shorthand pending review"
      ]
    },
    {
      "id": "binding-versus-producer",
      "families": [
        "nim",
        "crystal",
        "pony"
      ],
      "checks": [
        "independent declaration groups",
        "explicit tuple/destructuring producer",
        "multiple independent assignments",
        "where named args structural",
        "destructive read receiving binding plus reset"
      ]
    },
    {
      "id": "callbacks-versus-data",
      "families": [
        "crystal",
        "pony"
      ],
      "checks": [
        "explicit callback header/body/written close",
        "pure explicit callback stays expanded",
        "literal tuple/hash/type brackets structural",
        "nested executable owner inside constructor"
      ]
    },
    {
      "id": "value-versus-imperative",
      "families": [
        "nim",
        "crystal",
        "pony"
      ],
      "checks": [
        "proven value-only conditional operand",
        "actual expression-only method",
        "imperative locals not collapsed",
        "raise/error/transfer not assumed pure",
        "recover pending explicit policy"
      ]
    },
    {
      "id": "layout-and-written-close",
      "families": [
        "nim",
        "pony"
      ],
      "checks": [
        "dedent closes owner without synthetic source token",
        "sibling method header ends prior member owner",
        "written control end counts once",
        "nested fields/formals/loop patterns not body actions"
      ]
    },
    {
      "id": "pragma-ffi-helper-boundary",
      "families": [
        "nim",
        "crystal",
        "pony"
      ],
      "checks": [
        "meaningful pragmas retained",
        "FFI prototypes versus bodies gated",
        "generic stdlib/package support needs provenance",
        "application workload helpers always retained"
      ]
    }
  ],
