a := bigint/new(3)
b := bigint/new(7)
x := bigint/multiply-u64-into(a, a, 4)
y := bigint/subtract-multiple-u64(x, b, 3)
negative := control/select(bigint/less-equal(y, bigint/new(0)), 1, 0)
io/print("{}:", negative)
z := bigint/add-multiple-u64(y, b, 2)
quotient := bigint/floor-u64(z, b)
io/print("{}\n", quotient)
