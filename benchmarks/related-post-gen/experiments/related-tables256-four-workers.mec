// All query state is five scalar ranks. Duplicate candidates are detected
// against those ranks; no per-query array or state shared across queries.
top-only-quad-visit(post<u64>, query<u64>, query-mask<u64>, masks<[u64]>, top<subset-top>) => (out<subset-top>) :=
  out := ((post != query)? | true => top-only-quad-candidate(post, query-mask, masks, top) | false => top).
top-only-quad-candidate(post<u64>, query-mask<u64>, masks<[u64]>, top<subset-top>) => (out<subset-top>) :=
