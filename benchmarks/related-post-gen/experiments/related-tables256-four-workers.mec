tier-fast(offsets<[u64]>, ids<[u64]>, vocabulary<u64>, sub-offsets<[u64]>, sub-ids<[u64]>, sub-boundaries<[u64]>, sub-postings<[u64]>, posts<u64>, buckets<u64>, masks<[u64]>) => (out<[u64]>) :=
  quads := quartet-build(offsets, ids, 0u64, posts, sequence/append(sequence/with-capacity(0u64, posts + 1u64), 0u64), (sequence/with-capacity(0u64, sequence/length(sub-ids) * 2u64), [0u64 | i <- 1u64..=buckets]))
