tier-posts(sub-offsets<[u64]>, sub-ids<[u64]>, sub-boundaries<[u64]>, sub-postings<[u64]>, quad-offsets<[u64]>, quad-ids<[u64]>, quad-boundaries<[u64]>, quad-postings<[u64]>, masks<[u64]>, post<u64>, posts<u64>, stamps<[u64]>, output<[u64]>) => (out<[u64]>) :=
