top-only-three-candidate(post<u64>, rank<u64>, top<subset-top>) => (out<subset-top>) :=
  inverse := bits/xor(288230376151711743u64, post)
  fresh := (inverse != bits/and(top.1, 288230376151711743u64)) && (inverse != bits/and(top.2, 288230376151711743u64)) && (inverse != bits/and(top.3, 288230376151711743u64)) && (inverse != bits/and(top.4, 288230376151711743u64))
