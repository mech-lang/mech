// Source composition: reuse the histogram map as the interning map, current IR291/fused generators.
// Independent IR282 source experiment: both-fusion.
// Source experiment: specialize checked four/five-tag rows; all other row sizes retain the generic loops.
// Unselected source experiment: check row ordering once, then avoid repeated subset sorting.
// Source experiment: replace pairwise duplicate checks with a native bitmask/popcount proof.
// Four native numeric query workers with direct enumeration of unique keys.
// Source experiment: directly enumerate already-unique sorted tags; no membership test or FSM state.
// Source experiment: combine early query exclusion with scalar compare/swap insertion.
// Source experiment: exclude the query before scoring and candidate duplicate checks.
// Source experiment: independent queries with five scalar ranks and no epoch array.
// Source experiment: exact quartet scoring, then bounded ascending triple candidates.
// Source experiment: score each distinct triple candidate once using tag masks and query epochs.
// Source experiment: reuse CSR boundaries as mutable positions; the final sentinel is unused.
// Source experiment: load each touched-chain word once before splitting link and score.
// Source experiment: encode each (score, inverse post index) in one unsigned rank.
// Source experiment: prove complete triple candidate coverage before building fallback state.
// Source variant: bulk distinct-tag discovery before dictionary interning.
// Existing generic histogram/keys operations; all indexing and scoring remain Mech.
// Isolated algorithm experiment: adaptive triple-subset postings with sparse linked counters.
// Original scoring remains the exact fallback for duplicate/long tags and sparse queries.
// Port of the Rust algorithm in zupat/related_post_gen (MIT); see LICENSE.upstream.
// Related posts: zero-based CSR boundaries into flattened string tags. Mech
// performs string interning, builds a numeric CSR inverted index, scores posts,
// and returns five zero-based post indices per post. The host parses JSON only.
// This preserves Rust's u8 counters, chunk64 precheck, strict top-five ties,
// and index-zero defaults when fewer than five posts share a tag.
+> map
+> sequence
+> bits

related-set64(values<[u64]>, at<u64>, value<u64>) => (out<[u64]>) :=
  ~next := values
  next[at] = value
  out := next.
related-set8(values<[u8]>, at<u64>, value<u8>) => (out<[u8]>) :=
  ~next := values
  next[at] = value
  out := next.

<related-words> := <{index<{string:u64}> count<u64>}>
<related-top> := <(u8,u8,u8,u8,u8,u64,u64,u64,u64,u64)>
<related-scan> := <([u8],related-top)>
<related-output> := <([u8],[u64])>

#RelatedIntern(tags<[string]>, tag-count<u64>, initial<{string:u64}>) => <related-words>
  | :Next(at<u64>, index<{string:u64}>, count<u64>)
  | :Done(index<{string:u64}>, count<u64>).
#RelatedIntern(tags, tag-count, initial) -> :Next(0u64, initial, 0u64)
  :Next(at, index, count)
    | at < tag-count -> {
        tag := tags[at + 1u64]
        found := tag ∈ index
        next-index := (found? | true => index | false => map/insert(index, tag, count))
        next-count := (found? | true => count | false => count + 1u64)
      } -> :Next(at + 1u64, next-index, next-count)
    | * -> :Done(index, count)
  :Done(index, count) => {index: index, count: count}.

related-tag-counts(ids<[u64]>, at<u64>, counts<[u64]>) => (out<[u64]>) :=
  more := at < sequence/length(ids)
  next := (more? | true => related-tag-count-step(ids, at, counts) | false => counts)
  out := (more? | true => related-tag-counts(ids, at + 1u64, next) | false => counts).
related-tag-count-step(ids<[u64]>, at<u64>, counts<[u64]>) => (out<[u64]>) :=
  id := ids[at + 1u64]
  out := related-set64(counts, id + 1u64, counts[id + 1u64] + 1u64).

related-offsets(counts<[u64]>, at<u64>, total<u64>, offsets<[u64]>) => (out<[u64]>) :=
  more := at < sequence/length(counts)
  next-total := (more? | true => total + counts[at + 1u64] | false => total)
  out := (more?
    | true => related-offsets(counts, at + 1u64, next-total, sequence/append(offsets, next-total))
    | false => offsets).

<related-index> := <([u64],[u64])>
// Fused emission retains each key and increments its checked dense count.
<subset-counted-index> := <([u64],[u64],[u64])>
counted-key(state<related-index>, key<u64>) => (out<related-index>) :=
  next-keys := sequence/append(state.1, key)
  next-counts := related-set64(state.2, key + 1u64, state.2[key + 1u64] + 1u64)
  out := (next-keys, next-counts).

related-index-tags(ids<[u64]>, at<u64>, end<u64>, post<u64>, positions<[u64]>, postings<[u64]>) => (out<related-index>) :=
  more := at < end
  step := (more?
    | true => related-index-tag-step(ids, at, end, post, positions, postings)
    | false => (positions, postings))
  (next-positions, next-postings) := step
  out := (more?
    | true => related-index-tags(ids, at + 1u64, end, post, next-positions, next-postings)
    | false => (next-positions, next-postings)).
related-index-tag-step(ids<[u64]>, at<u64>, end<u64>, post<u64>, positions<[u64]>, postings<[u64]>) => (out<related-index>) :=
  id := ids[at + 1u64]
  destination := positions[id + 1u64]
  next-postings := related-set64(postings, destination + 1u64, post)
  next-positions := related-set64(positions, id + 1u64, destination + 1u64)
  out := (next-positions, next-postings).
related-index-posts(offsets<[u64]>, ids<[u64]>, post<u64>, posts<u64>, positions<[u64]>, postings<[u64]>) => (out<[u64]>) :=
  more := post < posts
  step := (more?
    | true => related-index-tags(ids, offsets[post + 1u64], offsets[post + 2u64], post, positions, postings)
    | false => (positions, postings))
  (next-positions, next-postings) := step
  out := (more?
    | true => related-index-posts(offsets, ids, post + 1u64, posts, next-positions, next-postings)
    | false => postings).

related-hits(postings<[u64]>, at<u64>, end<u64>, counts<[u8]>) => (out<[u8]>) :=
  more := at < end
  next := (more? | true => related-hit-step(postings, at, end, counts) | false => counts)
  out := (more? | true => related-hits(postings, at + 1u64, end, next) | false => counts).
// Rust release counters wrap; Mech arithmetic is checked, so encode modulo256.
related-hit-step(postings<[u64]>, at<u64>, end<u64>, counts<[u8]>) => (out<[u8]>) :=
  slot := postings[at + 1u64] + 1u64
  previous := counts[slot]
  value := ((previous == 255u8)? | true => 0u8 | false => previous + 1u8)
  next := related-set8(counts, slot, value)
  out := next.
related-count(ids<[u64]>, tag-offsets<[u64]>, postings<[u64]>, at<u64>, end<u64>, counts<[u8]>) => (out<[u8]>) :=
  more := at < end
  next := (more? | true => related-count-step(ids, tag-offsets, postings, at, end, counts) | false => counts)
  out := (more? | true => related-count(ids, tag-offsets, postings, at + 1u64, end, next) | false => counts).
related-count-step(ids<[u64]>, tag-offsets<[u64]>, postings<[u64]>, at<u64>, end<u64>, counts<[u8]>) => (out<[u8]>) :=
  id := ids[at + 1u64]
  next := related-hits(postings, tag-offsets[id + 1u64], tag-offsets[id + 2u64], counts)
  out := next.

// Strict comparisons preserve Rust's ascending post-index order for ties.
related-insert(top<related-top>, count<u8>, post<u64>) => (out<related-top>) :=
  out := ((count > top.1)?
    | true => (count, top.1, top.2, top.3, top.4, post, top.6, top.7, top.8, top.9)
    | false => ((count > top.2)?
      | true => (top.1, count, top.2, top.3, top.4, top.6, post, top.7, top.8, top.9)
      | false => ((count > top.3)?
        | true => (top.1, top.2, count, top.3, top.4, top.6, top.7, post, top.8, top.9)
        | false => ((count > top.4)?
          | true => (top.1, top.2, top.3, count, top.4, top.6, top.7, top.8, post, top.9)
          | false => (top.1, top.2, top.3, top.4, count, top.6, top.7, top.8, top.9, post))))).

// Scalar-only FSM captures the read-only counter array.
#RelatedChunkCheck(counts<[u8]>, base<u64>, minimum<u8>) => <bool>
  | :Check(lane<u64>, process<bool>)
  | :Done(process<bool>).
#RelatedChunkCheck(counts, base, minimum) -> :Check(0u64, false)
  :Check(lane, process)
    | lane < 64u64 -> :Check(lane + 1u64, process || (counts[base + lane + 1u64] > minimum))
    | * -> :Done(process)
  :Done(process) => process.

related-scan-chunk(counts<[u8]>, base<u64>, lane<u64>, process<bool>, top<related-top>) => (out<related-scan>) :=
  more := lane < 64u64
  step := (more?
    | true => related-scan-lane(counts, base, lane, process, top)
    | false => (counts, top))
  (next-counts, next-top) := step
  out := (more?
    | true => related-scan-chunk(next-counts, base, lane + 1u64, process, next-top)
    | false => (next-counts, next-top)).
related-scan-lane(counts<[u8]>, base<u64>, lane<u64>, process<bool>, top<related-top>) => (out<related-scan>) :=
  post := base + lane
  count := counts[post + 1u64]
  next-top := ((process && (count > top.5))? | true => related-insert(top, count, post) | false => top)
  next-counts := related-set8(counts, post + 1u64, 0u8)
  out := (next-counts, next-top).
related-top(counts<[u8]>, base<u64>, top<related-top>) => (out<related-scan>) :=
  more := base < sequence/length(counts)
  step := (more?
    | true => related-scan-chunk(counts, base, 0u64, #RelatedChunkCheck(counts, base, top.5), top)
    | false => (counts, top))
  (next-counts, next-top) := step
  out := (more? | true => related-top(next-counts, base + 64u64, next-top) | false => (next-counts, next-top)).

related-append-top(output<[u64]>, top<related-top>) => (out<[u64]>) :=
  a := sequence/append(output, top.6)
  b := sequence/append(a, top.7)
  c := sequence/append(b, top.8)
  d := sequence/append(c, top.9)
  out := sequence/append(d, top.10).

related-posts(offsets<[u64]>, ids<[u64]>, tag-offsets<[u64]>, postings<[u64]>, post<u64>, posts<u64>, empty<related-top>, counts<[u8]>, output<[u64]>) => (out<[u64]>) :=
  more := post < posts
  step := (more?
    | true => related-post-step(offsets, ids, tag-offsets, postings, post, posts, empty, counts, output)
    | false => (counts, output))
  (next-counts, next-output) := step
  out := (more?
    | true => related-posts(offsets, ids, tag-offsets, postings, post + 1u64, posts, empty, next-counts, next-output)
    | false => output).
related-post-step(offsets<[u64]>, ids<[u64]>, tag-offsets<[u64]>, postings<[u64]>, post<u64>, posts<u64>, empty<related-top>, counts<[u8]>, output<[u64]>) => (out<related-output>) :=
  hits := related-count(ids, tag-offsets, postings, offsets[post + 1u64], offsets[post + 2u64], counts)
  without-self := related-set8(hits, post + 1u64, 0u8)
  selected := related-top(without-self, 0u64, empty)
  next-output := related-append-top(output, selected.2)
  out := (selected.1, next-output).

// map/keys(histogram) supplies sorted distinct keys. The loop index is its ID.
intern-unique(tags<[string]>, at<u64>, end<u64>, index<{string:u64}>) => (out<{string:u64}>) :=
  more := at < end
  next := (more? | true => map/insert(index, tags[at + 1u64], at) | false => index)
  out := (more? | true => intern-unique(tags, at + 1u64, end, next) | false => index).

related-with-tags(offsets<[u64]>, tags<[string]>) => (out<[u64]>) :=
  posts := sequence/length(offsets) - 1u64
  empty-index<{string:u64}> := map/new()
  unique-tags := map/keys(map/histogram(tags))
  vocabulary := sequence/length(unique-tags)
  index := intern-unique(unique-tags, 0u64, vocabulary, empty-index)
  ids := [index{tag} | tag <- tags]
  empty-tag-counts := [0u64 | i <- 1u64..=vocabulary]
  tag-counts := related-tag-counts(ids, 0u64, empty-tag-counts)
  offset-buffer := sequence/with-capacity(0u64, vocabulary + 1u64)
  offset-zero := sequence/append(offset-buffer, 0u64)
  tag-offsets := related-offsets(tag-counts, 0u64, 0u64, offset-zero)
  positions := tag-offsets
  posting-buffer := [0u64 | i <- 1u64..=sequence/length(tags)]
  postings := related-index-posts(offsets, ids, 0u64, posts, positions, posting-buffer)
  padded := ((posts + 63u64) / 64u64) * 64u64
  counts := [0u8 | i <- 1u64..=padded]
  empty<related-top> := (0u8, 0u8, 0u8, 0u8, 0u8, 0u64, 0u64, 0u64, 0u64, 0u64)
  output := sequence/with-capacity(0u64, posts * 5u64)
  out := related-posts(offsets, ids, tag-offsets, postings, 0u64, posts, empty, counts, output).

related-empty(posts<u64>) => (out<[u64]>) :=
  out := ((posts == 0u64)?
    | true => sequence/with-capacity(0u64, 0u64)
    | false => [0u64 | i <- 1u64..=(posts * 5u64)]).

related(offsets<[u64]>, tags<[string]>) => (out<[u64]>) :=
  out := ((sequence/length(tags) == 0u64)?
    | true => related-empty(sequence/length(offsets) - 1u64)
    | false => subset-adaptive(offsets, tags)).

// A triple match contributes C(shared-tags,3): 1,4,10,20,35,56 for
// 3..8 shared tags. This is strictly rank-equivalent when tags are distinct.
// A zero fifth score triggers exact original scoring for that one query.
// Vocabulary<=64 bounds the dense C(vocabulary,3) index to41664 buckets;
// max8 tags bounds the linked counter's six-bit score to56. These capacity
// guards are independent of the number of posts and dataset vocabulary text.
<subset-chain> := <([u64],u64)>
<subset-scan> := <([u64],(u64,u64,u64,u64,u64))>
<subset-top> := <(u64,u64,u64,u64,u64)>
<subset-post-result> := <([u64],[u8],[u64])>

// Return the already checked masks with eligibility. For interned IDs<64,
// bit>mask proves strict ordering and uniqueness in the same per-tag scan.
<subset-row-mask> := <(u64,bool)>
<subset-prepared> := <([u64],bool)>
subset-row-mask(ids<[u64]>, at<u64>, end<u64>, mask<u64>) => (out<subset-row-mask>) :=
  more := at < end
  bit := (more? | true => bits/shift-left-wrap(1u64, ids[at + 1u64]) | false => 0u64)
  increasing := bit > mask
  next := bits/or(mask, bit)
  out := (more? | true => (increasing? | true => subset-row-mask(ids, at + 1u64, end, next) | false => (mask,false)) | false => (mask,true)).
subset-prepare(offsets<[u64]>, ids<[u64]>, post<u64>, posts<u64>, output<[u64]>) => (out<subset-prepared>) :=
  more := post < posts
  valid := (more? | true => (offsets[post + 2u64] - offsets[post + 1u64]) <= 8u64 | false => true)
  row := ((more && valid)? | true => subset-row-mask(ids, offsets[post + 1u64], offsets[post + 2u64], 0u64) | false => (0u64,valid))
  next := ((more && row.2)? | true => sequence/append(output, row.1) | false => output)
  out := (more? | true => (row.2? | true => subset-prepare(offsets, ids, post + 1u64, posts, next) | false => (output,false)) | false => (output,true)).

// Generic compile-time binomial tables for every possible byte value.
combinadic-c2 := [0u32,0u32,1u32,3u32,6u32,10u32,15u32,21u32,28u32,36u32,45u32,55u32,66u32,78u32,91u32,105u32,120u32,136u32,153u32,171u32,190u32,210u32,231u32,253u32,276u32,300u32,325u32,351u32,378u32,406u32,435u32,465u32,496u32,528u32,561u32,595u32,630u32,666u32,703u32,741u32,780u32,820u32,861u32,903u32,946u32,990u32,1035u32,1081u32,1128u32,1176u32,1225u32,1275u32,1326u32,1378u32,1431u32,1485u32,1540u32,1596u32,1653u32,1711u32,1770u32,1830u32,1891u32,1953u32,2016u32,2080u32,2145u32,2211u32,2278u32,2346u32,2415u32,2485u32,2556u32,2628u32,2701u32,2775u32,2850u32,2926u32,3003u32,3081u32,3160u32,3240u32,3321u32,3403u32,3486u32,3570u32,3655u32,3741u32,3828u32,3916u32,4005u32,4095u32,4186u32,4278u32,4371u32,4465u32,4560u32,4656u32,4753u32,4851u32,4950u32,5050u32,5151u32,5253u32,5356u32,5460u32,5565u32,5671u32,5778u32,5886u32,5995u32,6105u32,6216u32,6328u32,6441u32,6555u32,6670u32,6786u32,6903u32,7021u32,7140u32,7260u32,7381u32,7503u32,7626u32,7750u32,7875u32,8001u32,8128u32,8256u32,8385u32,8515u32,8646u32,8778u32,8911u32,9045u32,9180u32,9316u32,9453u32,9591u32,9730u32,9870u32,10011u32,10153u32,10296u32,10440u32,10585u32,10731u32,10878u32,11026u32,11175u32,11325u32,11476u32,11628u32,11781u32,11935u32,12090u32,12246u32,12403u32,12561u32,12720u32,12880u32,13041u32,13203u32,13366u32,13530u32,13695u32,13861u32,14028u32,14196u32,14365u32,14535u32,14706u32,14878u32,15051u32,15225u32,15400u32,15576u32,15753u32,15931u32,16110u32,16290u32,16471u32,16653u32,16836u32,17020u32,17205u32,17391u32,17578u32,17766u32,17955u32,18145u32,18336u32,18528u32,18721u32,18915u32,19110u32,19306u32,19503u32,19701u32,19900u32,20100u32,20301u32,20503u32,20706u32,20910u32,21115u32,21321u32,21528u32,21736u32,21945u32,22155u32,22366u32,22578u32,22791u32,23005u32,23220u32,23436u32,23653u32,23871u32,24090u32,24310u32,24531u32,24753u32,24976u32,25200u32,25425u32,25651u32,25878u32,26106u32,26335u32,26565u32,26796u32,27028u32,27261u32,27495u32,27730u32,27966u32,28203u32,28441u32,28680u32,28920u32,29161u32,29403u32,29646u32,29890u32,30135u32,30381u32,30628u32,30876u32,31125u32,31375u32,31626u32,31878u32,32131u32,32385u32]
combinadic-2(id<u64>) => (out<u64>) :=
  term := combinadic-c2[id + 1u64]
  widened<u64> := term
  out := widened.
combinadic-c3 := [0u32,0u32,0u32,1u32,4u32,10u32,20u32,35u32,56u32,84u32,120u32,165u32,220u32,286u32,364u32,455u32,560u32,680u32,816u32,969u32,1140u32,1330u32,1540u32,1771u32,2024u32,2300u32,2600u32,2925u32,3276u32,3654u32,4060u32,4495u32,4960u32,5456u32,5984u32,6545u32,7140u32,7770u32,8436u32,9139u32,9880u32,10660u32,11480u32,12341u32,13244u32,14190u32,15180u32,16215u32,17296u32,18424u32,19600u32,20825u32,22100u32,23426u32,24804u32,26235u32,27720u32,29260u32,30856u32,32509u32,34220u32,35990u32,37820u32,39711u32,41664u32,43680u32,45760u32,47905u32,50116u32,52394u32,54740u32,57155u32,59640u32,62196u32,64824u32,67525u32,70300u32,73150u32,76076u32,79079u32,82160u32,85320u32,88560u32,91881u32,95284u32,98770u32,102340u32,105995u32,109736u32,113564u32,117480u32,121485u32,125580u32,129766u32,134044u32,138415u32,142880u32,147440u32,152096u32,156849u32,161700u32,166650u32,171700u32,176851u32,182104u32,187460u32,192920u32,198485u32,204156u32,209934u32,215820u32,221815u32,227920u32,234136u32,240464u32,246905u32,253460u32,260130u32,266916u32,273819u32,280840u32,287980u32,295240u32,302621u32,310124u32,317750u32,325500u32,333375u32,341376u32,349504u32,357760u32,366145u32,374660u32,383306u32,392084u32,400995u32,410040u32,419220u32,428536u32,437989u32,447580u32,457310u32,467180u32,477191u32,487344u32,497640u32,508080u32,518665u32,529396u32,540274u32,551300u32,562475u32,573800u32,585276u32,596904u32,608685u32,620620u32,632710u32,644956u32,657359u32,669920u32,682640u32,695520u32,708561u32,721764u32,735130u32,748660u32,762355u32,776216u32,790244u32,804440u32,818805u32,833340u32,848046u32,862924u32,877975u32,893200u32,908600u32,924176u32,939929u32,955860u32,971970u32,988260u32,1004731u32,1021384u32,1038220u32,1055240u32,1072445u32,1089836u32,1107414u32,1125180u32,1143135u32,1161280u32,1179616u32,1198144u32,1216865u32,1235780u32,1254890u32,1274196u32,1293699u32,1313400u32,1333300u32,1353400u32,1373701u32,1394204u32,1414910u32,1435820u32,1456935u32,1478256u32,1499784u32,1521520u32,1543465u32,1565620u32,1587986u32,1610564u32,1633355u32,1656360u32,1679580u32,1703016u32,1726669u32,1750540u32,1774630u32,1798940u32,1823471u32,1848224u32,1873200u32,1898400u32,1923825u32,1949476u32,1975354u32,2001460u32,2027795u32,2054360u32,2081156u32,2108184u32,2135445u32,2162940u32,2190670u32,2218636u32,2246839u32,2275280u32,2303960u32,2332880u32,2362041u32,2391444u32,2421090u32,2450980u32,2481115u32,2511496u32,2542124u32,2573000u32,2604125u32,2635500u32,2667126u32,2699004u32,2731135u32]
combinadic-3(id<u64>) => (out<u64>) :=
  term := combinadic-c3[id + 1u64]
  widened<u64> := term
  out := widened.
combinadic-c4 := [0u32,0u32,0u32,0u32,1u32,5u32,15u32,35u32,70u32,126u32,210u32,330u32,495u32,715u32,1001u32,1365u32,1820u32,2380u32,3060u32,3876u32,4845u32,5985u32,7315u32,8855u32,10626u32,12650u32,14950u32,17550u32,20475u32,23751u32,27405u32,31465u32,35960u32,40920u32,46376u32,52360u32,58905u32,66045u32,73815u32,82251u32,91390u32,101270u32,111930u32,123410u32,135751u32,148995u32,163185u32,178365u32,194580u32,211876u32,230300u32,249900u32,270725u32,292825u32,316251u32,341055u32,367290u32,395010u32,424270u32,455126u32,487635u32,521855u32,557845u32,595665u32,635376u32,677040u32,720720u32,766480u32,814385u32,864501u32,916895u32,971635u32,1028790u32,1088430u32,1150626u32,1215450u32,1282975u32,1353275u32,1426425u32,1502501u32,1581580u32,1663740u32,1749060u32,1837620u32,1929501u32,2024785u32,2123555u32,2225895u32,2331890u32,2441626u32,2555190u32,2672670u32,2794155u32,2919735u32,3049501u32,3183545u32,3321960u32,3464840u32,3612280u32,3764376u32,3921225u32,4082925u32,4249575u32,4421275u32,4598126u32,4780230u32,4967690u32,5160610u32,5359095u32,5563251u32,5773185u32,5989005u32,6210820u32,6438740u32,6672876u32,6913340u32,7160245u32,7413705u32,7673835u32,7940751u32,8214570u32,8495410u32,8783390u32,9078630u32,9381251u32,9691375u32,10009125u32,10334625u32,10668000u32,11009376u32,11358880u32,11716640u32,12082785u32,12457445u32,12840751u32,13232835u32,13633830u32,14043870u32,14463090u32,14891626u32,15329615u32,15777195u32,16234505u32,16701685u32,17178876u32,17666220u32,18163860u32,18671940u32,19190605u32,19720001u32,20260275u32,20811575u32,21374050u32,21947850u32,22533126u32,23130030u32,23738715u32,24359335u32,24992045u32,25637001u32,26294360u32,26964280u32,27646920u32,28342440u32,29051001u32,29772765u32,30507895u32,31256555u32,32018910u32,32795126u32,33585370u32,34389810u32,35208615u32,36041955u32,36890001u32,37752925u32,38630900u32,39524100u32,40432700u32,41356876u32,42296805u32,43252665u32,44224635u32,45212895u32,46217626u32,47239010u32,48277230u32,49332470u32,50404915u32,51494751u32,52602165u32,53727345u32,54870480u32,56031760u32,57211376u32,58409520u32,59626385u32,60862165u32,62117055u32,63391251u32,64684950u32,65998350u32,67331650u32,68685050u32,70058751u32,71452955u32,72867865u32,74303685u32,75760620u32,77238876u32,78738660u32,80260180u32,81803645u32,83369265u32,84957251u32,86567815u32,88201170u32,89857530u32,91537110u32,93240126u32,94966795u32,96717335u32,98491965u32,100290905u32,102114376u32,103962600u32,105835800u32,107734200u32,109658025u32,111607501u32,113582855u32,115584315u32,117612110u32,119666470u32,121747626u32,123855810u32,125991255u32,128154195u32,130344865u32,132563501u32,134810340u32,137085620u32,139389580u32,141722460u32,144084501u32,146475945u32,148897035u32,151348015u32,153829130u32,156340626u32,158882750u32,161455750u32,164059875u32,166695375u32,169362501u32,172061505u32]
combinadic-4(id<u64>) => (out<u64>) :=
  term := combinadic-c4[id + 1u64]
  widened<u64> := term
  out := widened.

subset-key(a<u64>, b<u64>, c<u64>) => (out<u64>) :=
  out := a + combinadic-2(b) + combinadic-3(c).
subset-third(ids<[u64]>, first<u64>, second<u64>, third<u64>, end<u64>, output<related-index>) => (out<related-index>) :=
  more := third < end
  next := (more? | true => counted-key(output, subset-key(ids[first + 1u64], ids[second + 1u64], ids[third + 1u64])) | false => output)
  out := (more? | true => subset-third(ids, first, second, third + 1u64, end, next) | false => output).
subset-second(ids<[u64]>, first<u64>, second<u64>, end<u64>, output<related-index>) => (out<related-index>) :=
  more := second + 1u64 < end
  next := (more? | true => subset-third(ids, first, second, second + 1u64, end, output) | false => output)
  out := (more? | true => subset-second(ids, first, second + 1u64, end, next) | false => output).
subset-first-generic(ids<[u64]>, first<u64>, end<u64>, output<related-index>) => (out<related-index>) :=
  more := first + 2u64 < end
  next := (more? | true => subset-second(ids, first, first + 1u64, end, output) | false => output)
  out := (more? | true => subset-first-generic(ids, first + 1u64, end, next) | false => output).
subset-row-4(ids<[u64]>, first<u64>, output<related-index>) => (out<related-index>) :=
  a := ids[first + 1u64]
  b := ids[first + 2u64]
  c := ids[first + 3u64]
  d := ids[first + 4u64]
  b2 := combinadic-2(b)
  c2 := combinadic-2(c)
  c3 := combinadic-3(c)
  d3 := combinadic-3(d)
  row0 := counted-key(output, a + b2 + c3)
  row1 := counted-key(row0, a + b2 + d3)
  row2 := counted-key(row1, a + c2 + d3)
  row3 := counted-key(row2, b + c2 + d3)
  out := row3.

subset-row-5(ids<[u64]>, first<u64>, output<related-index>) => (out<related-index>) :=
  a := ids[first + 1u64]
  b := ids[first + 2u64]
  c := ids[first + 3u64]
  d := ids[first + 4u64]
  e := ids[first + 5u64]
  b2 := combinadic-2(b)
  c2 := combinadic-2(c)
  d2 := combinadic-2(d)
  c3 := combinadic-3(c)
  d3 := combinadic-3(d)
  e3 := combinadic-3(e)
  row0 := counted-key(output, a + b2 + c3)
  row1 := counted-key(row0, a + b2 + d3)
  row2 := counted-key(row1, a + b2 + e3)
  row3 := counted-key(row2, a + c2 + d3)
  row4 := counted-key(row3, a + c2 + e3)
  row5 := counted-key(row4, a + d2 + e3)
  row6 := counted-key(row5, b + c2 + d3)
  row7 := counted-key(row6, b + c2 + e3)
  row8 := counted-key(row7, b + d2 + e3)
  row9 := counted-key(row8, c + d2 + e3)
  out := row9.

subset-first(ids<[u64]>, first<u64>, end<u64>, output<related-index>) => (out<related-index>) :=
  ordered := end >= first
  count := (ordered? | true => end - first | false => 0u64)
  out := ((count == 4u64)?
    | true => subset-row-4(ids, first, output)
    | false => ((count == 5u64)?
      | true => subset-row-5(ids, first, output)
      | false => subset-first-generic(ids, first, end, output))).

subset-build(offsets<[u64]>, ids<[u64]>, post<u64>, posts<u64>, boundaries<[u64]>, output<related-index>) => (out<subset-counted-index>) :=
  more := post < posts
  next := (more? | true => subset-first(ids, offsets[post + 1u64], offsets[post + 2u64], output) | false => output)
  next-boundaries := (more? | true => sequence/append(boundaries, sequence/length(next.1)) | false => boundaries)
  out := (more? | true => subset-build(offsets, ids, post + 1u64, posts, next-boundaries, next) | false => (boundaries, output.1, output.2)).

// One u64 per post stores (next-touched-post-plus-one)*64 + triple-hit-count.
// The first hit links that post; later hits change only its low six bits.
subset-hit(postings<[u64]>, at<u64>, chain<[u64]>, head<u64>) => (out<subset-chain>) :=
  slot := postings[at + 1u64] + 1u64
  old := chain[slot]
  fresh := old == 0u64
  value := (fresh? | true => head * 64u64 + 1u64 | false => old + 1u64)
  next := related-set64(chain, slot, value)
  out := (next, (fresh? | true => slot | false => head)).
subset-hits(postings<[u64]>, at<u64>, end<u64>, chain<[u64]>, head<u64>) => (out<subset-chain>) :=
  more := at < end
  next := (more? | true => subset-hit(postings, at, chain, head) | false => (chain, head))
  (next-chain, next-head) := next
  out := (more? | true => subset-hits(postings, at + 1u64, end, next-chain, next-head) | false => (chain, head)).
subset-count(ids<[u64]>, boundaries<[u64]>, postings<[u64]>, at<u64>, end<u64>, chain<[u64]>, head<u64>) => (out<subset-chain>) :=
  more := at < end
  next := (more? | true => subset-count-step(ids, boundaries, postings, at, chain, head) | false => (chain, head))
  (next-chain, next-head) := next
  out := (more? | true => subset-count(ids, boundaries, postings, at + 1u64, end, next-chain, next-head) | false => (chain, head)).
subset-count-step(ids<[u64]>, boundaries<[u64]>, postings<[u64]>, at<u64>, chain<[u64]>, head<u64>) => (out<subset-chain>) :=
  id := ids[at + 1u64]
  out := subset-hits(postings, boundaries[id + 1u64], boundaries[id + 2u64], chain, head).

// Eligibility bounds scores to56 and post indices to58 bits. A larger rank
// means a larger score, then a smaller post index. Zero is the empty sentinel.
// Five ranks replace five scores plus five post indices and explicit tie tests.
subset-rank(score<u64>, post<u64>) => (out<u64>) :=
  out := bits/or(bits/shift-left-wrap(score, 58u64), bits/xor(288230376151711743u64, post)).
subset-unrank(rank<u64>) => (out<u64>) :=
  out := bits/xor(288230376151711743u64, bits/and(rank, 288230376151711743u64)).
subset-insert(top<subset-top>, rank<u64>) => (out<subset-top>) :=
  first := ((rank > top.1)? | true => (rank, top.1) | false => (top.1, rank))
  second := ((first.2 > top.2)? | true => (first.2, top.2) | false => (top.2, first.2))
  third := ((second.2 > top.3)? | true => (second.2, top.3) | false => (top.3, second.2))
  fourth := ((third.2 > top.4)? | true => (third.2, top.4) | false => (top.4, third.2))
  out := (first.1, second.1, third.1, fourth.1, fourth.2).
subset-scan(chain<[u64]>, head<u64>, query<u64>, top<subset-top>) => (out<subset-scan>) :=
  more := head > 0u64
  word := (more? | true => chain[head] | false => 0u64)
  next-head := word / 64u64
  next := (more? | true => subset-scan-step(chain, head, word, query, top) | false => (chain, top))
  (next-chain, next-top) := next
  out := (more? | true => subset-scan(next-chain, next-head, query, next-top) | false => (chain, top)).
subset-scan-step(chain<[u64]>, head<u64>, word<u64>, query<u64>, top<subset-top>) => (out<subset-scan>) :=
  score := word % 64u64
  post := head - 1u64
  rank := subset-rank(score, post)
  better := (post != query) && (rank > top.5)
  next-top := (better? | true => subset-insert(top, rank) | false => top)
  next-chain := related-set64(chain, head, 0u64)
  out := (next-chain, next-top).
// Called only after proving that all five ranks are positive candidates.
subset-append(output<[u64]>, top<subset-top>) => (out<[u64]>) :=
  a := sequence/append(output, subset-unrank(top.1))
  b := sequence/append(a, subset-unrank(top.2))
  c := sequence/append(b, subset-unrank(top.3))
  d := sequence/append(c, subset-unrank(top.4))
  out := sequence/append(d, subset-unrank(top.5)).
subset-posts(offsets<[u64]>, ids<[u64]>, tag-boundaries<[u64]>, postings<[u64]>, sub-offsets<[u64]>, sub-ids<[u64]>, sub-boundaries<[u64]>, sub-postings<[u64]>, post<u64>, posts<u64>, chain<[u64]>, fallback<[u8]>, output<[u64]>) => (out<[u64]>) :=
  more := post < posts
  step := (more? | true => subset-post-step(offsets, ids, tag-boundaries, postings, sub-offsets, sub-ids, sub-boundaries, sub-postings, post, posts, chain, fallback, output) | false => (chain, fallback, output))
  (next-chain, next-fallback, next-output) := step
  out := (more? | true => subset-posts(offsets, ids, tag-boundaries, postings, sub-offsets, sub-ids, sub-boundaries, sub-postings, post + 1u64, posts, next-chain, next-fallback, next-output) | false => output).
subset-post-step(offsets<[u64]>, ids<[u64]>, tag-boundaries<[u64]>, postings<[u64]>, sub-offsets<[u64]>, sub-ids<[u64]>, sub-boundaries<[u64]>, sub-postings<[u64]>, post<u64>, posts<u64>, chain<[u64]>, fallback<[u8]>, output<[u64]>) => (out<subset-post-result>) :=
  hits := subset-count(sub-ids, sub-boundaries, sub-postings, sub-offsets[post + 1u64], sub-offsets[post + 2u64], chain, 0u64)
  empty<subset-top> := (0u64,0u64,0u64,0u64,0u64)
  selected := subset-scan(hits.1, hits.2, post, empty)
  (next-chain, selected-top) := selected
  full := selected-top.5 > 0u64
  ordinary := (full? | true => (fallback, output) | false => related-post-step(offsets, ids, tag-boundaries, postings, post, posts, (0u8,0u8,0u8,0u8,0u8,0u64,0u64,0u64,0u64,0u64), fallback, output))
  (next-fallback, ordinary-output) := ordinary
  next-output := (full? | true => subset-append(output, selected-top) | false => ordinary-output)
  out := (next-chain, next-fallback, next-output).

// If one triple occurs in at least six distinct posts, its query has five
// positive candidates after excluding itself. Eligibility has already proved
// distinct tags, so bucket frequency counts distinct posts exactly.
subset-covered-query(ids<[u64]>, counts<[u64]>, at<u64>, end<u64>) => (out<bool>) :=
  more := at < end
  covered := (more? | true => counts[ids[at + 1u64] + 1u64] >= 6u64 | false => false)
  out := (more? | true => (covered? | true => true | false => subset-covered-query(ids, counts, at + 1u64, end)) | false => false).
subset-covered(offsets<[u64]>, ids<[u64]>, counts<[u64]>, post<u64>, posts<u64>) => (out<bool>) :=
  more := post < posts
  covered := (more? | true => subset-covered-query(ids, counts, offsets[post + 1u64], offsets[post + 2u64]) | false => true)
  out := (more? | true => (covered? | true => subset-covered(offsets, ids, counts, post + 1u64, posts) | false => false) | false => true).

// A proved complete triple candidate set needs no ordinary tag index,
// counter array, per-query fallback branch or fallback state in its loop.
subset-fast-posts(offsets<[u64]>, ids<[u64]>, boundaries<[u64]>, postings<[u64]>, post<u64>, posts<u64>, chain<[u64]>, output<[u64]>) => (out<[u64]>) :=
  more := post < posts
  next := (more? | true => subset-fast-step(offsets, ids, boundaries, postings, post, chain, output) | false => (chain, output))
  (next-chain, next-output) := next
  out := (more? | true => subset-fast-posts(offsets, ids, boundaries, postings, post + 1u64, posts, next-chain, next-output) | false => output).
subset-fast-step(offsets<[u64]>, ids<[u64]>, boundaries<[u64]>, postings<[u64]>, post<u64>, chain<[u64]>, output<[u64]>) => (out<related-index>) :=
  hits := subset-count(ids, boundaries, postings, offsets[post + 1u64], offsets[post + 2u64], chain, 0u64)
  empty<subset-top> := (0u64,0u64,0u64,0u64,0u64)
  selected := subset-scan(hits.1, hits.2, post, empty)
  out := (selected.1, subset-append(output, selected.2)).

// Bitset candidate scoring. This source-only control expresses popcount with
// existing word operations; the compiler comparison will also use native popcount.
mask-popcount(value<u64>) => (out<u64>) :=
  a := bits/wrapping-sub(value, bits/and(bits/shift-right-wrap(value, 1u64), 6148914691236517205u64))
  b := bits/wrapping-add(bits/and(a, 3689348814741910323u64), bits/and(bits/shift-right-wrap(a, 2u64), 3689348814741910323u64))
  c := bits/and(bits/wrapping-add(b, bits/shift-right-wrap(b, 4u64)), 1085102592571150095u64)
  out := bits/shift-right-wrap(bits/wrapping-mul(c, 72340172838076673u64), 56u64).
mask-tags(ids<[u64]>, at<u64>, end<u64>, mask<u64>) => (out<u64>) :=
  more := at < end
  next := (more? | true => bits/or(mask, bits/shift-left-wrap(1u64, ids[at + 1u64])) | false => mask)
  out := (more? | true => mask-tags(ids, at + 1u64, end, next) | false => mask).
mask-build(offsets<[u64]>, ids<[u64]>, post<u64>, posts<u64>, output<[u64]>) => (out<[u64]>) :=
  more := post < posts
  next := (more? | true => sequence/append(output, mask-tags(ids, offsets[post + 1u64], offsets[post + 2u64], 0u64)) | false => output)
  out := (more? | true => mask-build(offsets, ids, post + 1u64, posts, next) | false => output).
mask-visit(masks<[u64]>, slot<u64>, epoch<u64>, query-mask<u64>, stamps<[u64]>, top<subset-top>) => (out<subset-scan>) :=
  score := mask-popcount(bits/and(query-mask, masks[slot]))
  rank := subset-rank(score, slot - 1u64)
  next-top := ((rank > top.5)? | true => subset-insert(top, rank) | false => top)
  out := (related-set64(stamps, slot, epoch), next-top).
mask-hit(postings<[u64]>, masks<[u64]>, at<u64>, epoch<u64>, query-mask<u64>, stamps<[u64]>, top<subset-top>) => (out<subset-scan>) :=
  slot := postings[at + 1u64] + 1u64
  fresh := (slot != epoch) && (stamps[slot] != epoch)
  out := (fresh? | true => mask-visit(masks, slot, epoch, query-mask, stamps, top) | false => (stamps, top)).
mask-hits(postings<[u64]>, masks<[u64]>, at<u64>, end<u64>, epoch<u64>, query-mask<u64>, stamps<[u64]>, top<subset-top>) => (out<subset-scan>) :=
  more := at < end
  next := (more? | true => mask-hit(postings, masks, at, epoch, query-mask, stamps, top) | false => (stamps, top))
  (next-stamps, next-top) := next
  out := (more? | true => mask-hits(postings, masks, at + 1u64, end, epoch, query-mask, next-stamps, next-top) | false => (stamps, top)).
mask-count(ids<[u64]>, boundaries<[u64]>, postings<[u64]>, masks<[u64]>, at<u64>, end<u64>, epoch<u64>, query-mask<u64>, stamps<[u64]>, top<subset-top>) => (out<subset-scan>) :=
  more := at < end
  next := (more? | true => mask-count-step(ids, boundaries, postings, masks, at, epoch, query-mask, stamps, top) | false => (stamps, top))
  (next-stamps, next-top) := next
  out := (more? | true => mask-count(ids, boundaries, postings, masks, at + 1u64, end, epoch, query-mask, next-stamps, next-top) | false => (stamps, top)).
mask-count-step(ids<[u64]>, boundaries<[u64]>, postings<[u64]>, masks<[u64]>, at<u64>, epoch<u64>, query-mask<u64>, stamps<[u64]>, top<subset-top>) => (out<subset-scan>) :=
  id := ids[at + 1u64]
  out := mask-hits(postings, masks, boundaries[id + 1u64], boundaries[id + 2u64], epoch, query-mask, stamps, top).
mask-posts(offsets<[u64]>, ids<[u64]>, boundaries<[u64]>, postings<[u64]>, masks<[u64]>, post<u64>, posts<u64>, stamps<[u64]>, output<[u64]>) => (out<[u64]>) :=
  more := post < posts
  next := (more? | true => mask-post-step(offsets, ids, boundaries, postings, masks, post, stamps, output) | false => (stamps, output))
  (next-stamps, next-output) := next
  out := (more? | true => mask-posts(offsets, ids, boundaries, postings, masks, post + 1u64, posts, next-stamps, next-output) | false => output).
mask-post-step(offsets<[u64]>, ids<[u64]>, boundaries<[u64]>, postings<[u64]>, masks<[u64]>, post<u64>, stamps<[u64]>, output<[u64]>) => (out<related-index>) :=
  empty<subset-top> := (0u64,0u64,0u64,0u64,0u64)
  selected := mask-count(ids, boundaries, postings, masks, offsets[post + 1u64], offsets[post + 2u64], post + 1u64, masks[post + 1u64], stamps, empty)
  out := (selected.1, subset-append(output, selected.2)).
mask-fast(offsets<[u64]>, ids<[u64]>, sub-offsets<[u64]>, sub-ids<[u64]>, sub-boundaries<[u64]>, sub-postings<[u64]>, posts<u64>) => (out<[u64]>) :=
  masks := mask-build(offsets, ids, 0u64, posts, sequence/with-capacity(0u64, posts))
  out := mask-posts(sub-offsets, sub-ids, sub-boundaries, sub-postings, masks, 0u64, posts, [0u64 | i <- 1u64..=posts], sequence/with-capacity(0u64, posts * 5u64)).

// Quartet candidates are scored exactly first. All remaining triple candidates
// have score exactly three, so their sorted posting lists can stop at the
// current fifth rank. Both passes share query-epoch stamps.
quartet-key(a<u64>, b<u64>, c<u64>, d<u64>) => (out<u64>) :=
  out := a + combinadic-2(b) + combinadic-3(c) + combinadic-4(d).
quartet-fourth(ids<[u64]>, first<u64>, second<u64>, third<u64>, fourth<u64>, end<u64>, output<related-index>) => (out<related-index>) :=
  more := fourth < end
  next := (more? | true => counted-key(output, quartet-key(ids[first + 1u64], ids[second + 1u64], ids[third + 1u64], ids[fourth + 1u64])) | false => output)
  out := (more? | true => quartet-fourth(ids, first, second, third, fourth + 1u64, end, next) | false => output).
quartet-third(ids<[u64]>, first<u64>, second<u64>, third<u64>, end<u64>, output<related-index>) => (out<related-index>) :=
  more := third + 1u64 < end
  next := (more? | true => quartet-fourth(ids, first, second, third, third + 1u64, end, output) | false => output)
  out := (more? | true => quartet-third(ids, first, second, third + 1u64, end, next) | false => output).
