function u0:0(i64, i64, i64, i64) -> i64 apple_aarch64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = icmp ne v0, v1
    v5 = icmp ne v2, v3
    v6 = uextend.i64 v4
    v7 = uextend.i64 v5
    v8 = bor v6, v7
    brif v8, block1, block2

block1:
    v9 = iconst.i64 1
    return v9  ; v9 = 1

block2:
    v10 = iconst.i64 0
    return v10  ; v10 = 0
}
