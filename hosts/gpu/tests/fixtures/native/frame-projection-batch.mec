projection-child(number<u64>, steps<u64>) => (out<u64>) :=
  out := ((steps > 0u64)? | true => projection-child(number + 1u64, steps - 1u64) | false => number).
projection-parent(a<[u8]>, b<[u16]>, c<[u32]>, d<[u64]>, left<u64>, number<u64>, flag<bool>, steps<u64>, allowed<bool>, divisor<u64>) => (out<u64>) :=
  permitted! := allowed
  av<u64> := a[1u64]
  bv<u64> := b[1u64]
  cv<u64> := c[1u64]
  total := av + bv * 10u64 + cv * 100u64 + d[1u64] * 1000u64
  next := projection-child(number + total, steps)
  marked := (flag? | true => next + 1u64 | false => next)
  out := ((left > 0u64)? | true => projection-parent(a, b, c, d, left - 1u64, next, flag == false, steps, allowed, divisor) | false => marked / divisor).
projection-parent(a<[u8]>, b<[u16]>, c<[u32]>, d<[u64]>, left<u64>, number<u64>, flag<bool>, steps<u64>, allowed<bool>, divisor<u64>)
