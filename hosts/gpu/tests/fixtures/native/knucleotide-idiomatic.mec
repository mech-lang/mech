+> map
+> number
+> sequence
+> stats
+> text
+> @in := cli/stdin
+> @out := cli/stdout

histogram(s<string>, width<u64>) => (counts<{string:u64}>) :=
  n := sequence/length(s)
  words := [
    s[(i + 1u64)..=(i + width)]
    | i <- 0u64..=n, width > 0u64, width <= n - i
  ]
  counts := map/histogram(words).

frequencies(h<{string:u64}>) => (output<string>) :=
  keys := h_keys
  counts := map/values(h)
  order := sequence/sort-indices(counts, "desc", keys, "asc")
  values<[f64]> := counts
  total<f64> := stats/sum/column(counts)[1u64]
  lines := [
    keys[i] + " " + number/format(100.0 * values[i] / total, 3u64)
    | i <- order
  ]
  output := text/join(lines, "\n") + "\n\n".

lookup(counts<{string:u64}>, query<string>) => (output<string>) :=
  keys<{string}> := counts_keys
  count := (query ∈ keys)?
    | true => counts{query}
    | false => 0u64.
  output := number/format(count, 0u64) + "\t" + query + "\n".

is-header(line<string>) => (found<bool>) :=
  found := (sequence/length(line)?
    | 0u64 => false
    | * => line[1u64] == ">"
  ).

is-three(line<string>) => (found<bool>) :=
  found := (sequence/length(line)?
    | size, size < 6u64 => false
    | 6u64 => line == ">THREE"
    | * => (line[1u64..=6u64] == ">THREE")?
      | false => false
      | true => line[7u64]?
        | " " => true
        | "\t" => true
        | * => false
  ).

#RecordBounds(lines<[string]>, count<u64>) => <(u64,u64)>
  | :Seek(index<u64>)
  | :Read(first<u64>, index<u64>)
  | :Done(first<u64>, end<u64>).
#RecordBounds(lines, count) -> :Seek(1u64)
  :Seek(index)
    | index > count -> :Done(1u64, 1u64)
    | is-three(lines[index]) -> :Read(index + 1u64, index + 1u64)
    | * -> :Seek(index + 1u64)
  :Read(first, index)
    | index > count -> :Done(first, count + 1u64)
    | is-header(lines[index]) -> :Done(first, index)
    | * -> :Read(first, index + 1u64)
  :Done(first, end) => (first, end).

uppercase := {
  "a": "A", "A": "A",
  "c": "C", "C": "C",
  "g": "G", "G": "G",
  "t": "T", "T": "T"
}

input-lines := text/lines(@in/text)
bounds := #RecordBounds(input-lines, sequence/length(input-lines))
record := bounds?
  | (first, end), first < end => text/join(input-lines[first..end], "")
  | * => "".
sequence := text/join([uppercase{char} | char <- record], "")

queries := ["GGT" "GGTA" "GGTATT" "GGTATTTTAATT" "GGTATTTTAATTTATAGT"]

frequency-text := text/join([
  frequencies(histogram(sequence, width))
  | width <- [1u64 2u64]
], "")
query-text := text/join([
  lookup(histogram(sequence, sequence/length(query)), query)
  | query <- queries
], "")
@out/text <- frequency-text + query-text
