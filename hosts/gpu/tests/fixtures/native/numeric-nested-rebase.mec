// Current buffers pass through nested Tail calls and real collection exits.
+> bits
rebase-node(node<u16>) => (out<u16>) :=
  wide<u64> := node
  out<u16> := ((wide < 32768u64)? | true => 0u64 | false => wide - 32768u64).
rebase-nodes(nodes<[u16]>) => (out<[u16]>) :=
  out := rebase-node(nodes).
poke(nodes<[u16]>) => (out<[u16]>) :=
  old<u64> := nodes[1u64]
  value<u16> := bits/and(old + 1u64, 65535u64)
  ~next := nodes
  next[1u64] = value
  out := next.
leaf(nodes<[u16]>, at<u64>, end<u64>) => (out<[u16]>) :=
  more := at < end
  next := (more? | true => poke(nodes) | false => nodes)
  out := (more? | true => leaf(next, at + 1u64, end) | false => nodes).
child(nodes<[u16]>, at<u64>, end<u64>, checkpoint<u64>, reject<u64>) => (out<[u16]>) :=
  allowed! := at != reject
  more := at < end
  next := (more? | true => leaf(nodes, 0u64, 1u64) | false => nodes)
  slide := more && (at == checkpoint)
  current := (slide? | true => rebase-nodes(next) | false => next)
  out := (more? | true => child(current, at + 1u64, end, checkpoint, reject) | false => current).
walk(nodes<[u16]>, cache<[u32]>, at<u64>, end<u64>, checkpoint<u64>, child-checkpoint<u64>, reject<u64>, child-reject<u64>) => (out<([u16],[u32],u64)>) :=
  allowed! := at != reject
  more := at < end
  next := (more? | true => child(nodes, 0u64, 2u64, child-checkpoint, child-reject) | false => nodes)
  slide := more && (at == checkpoint)
  current := (slide? | true => rebase-nodes(next) | false => next)
  ~counted := cache
  counted[1u64] = cache[1u64] + (more? | true => 1u32 | false => 0u32)
  out := (more?
    | true => walk(current, counted, at + 1u64, end, checkpoint, child-checkpoint, reject, child-reject)
    | false => (current, counted, at)).
inspect(nodes<[u16]>, cache<[u32]>, steps<u64>, checkpoint<u64>, child-checkpoint<u64>, reject<u64>, child-reject<u64>) => (out<([u16],[u32],u64)>) :=
  (tree, entries, position) := walk(nodes, cache, 0u64, steps, checkpoint, child-checkpoint, reject, child-reject)
  out := (tree, entries, position).
answer := inspect(nodes<[u16]>, cache<[u32]>, steps<u64>, checkpoint<u64>, child-checkpoint<u64>, reject<u64>, child-reject<u64>)
answer
