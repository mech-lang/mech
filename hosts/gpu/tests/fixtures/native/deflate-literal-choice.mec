// All-literals block alternative from CompressOptimal.roc:608-649,
// pinned at 671077457ff7ef3a3d44caf715a3fc595addf379.
// Include the qualified Huffman component first.
// See deflate-huffman-LICENSES.md for source attribution and licenses.
<optimal-literal-choice> := <{freqs-litlen<[u32]> freqs-offset<[u32]> litlen-lens<[u8]> litlen-codewords<[u32]> offset-lens<[u8]> offset-codewords<[u32]>}>

optimal-literal-count-step(input<[u8]>, begin<u64>, at<u64>, frequencies<[u32]>) => (out<[u32]>) :=
  position := begin + at
  symbol<u64> := huff-get8(input, position)
  count := huff-get32(frequencies, symbol) + 1u32
  out := huff-set32(frequencies, symbol, count).
optimal-literal-counts(input<[u8]>, begin<u64>, length<u64>, at<u64>, frequencies<[u32]>) => (out<[u32]>) :=
  more := at < length
  next := (more? | true => optimal-literal-count-step(input, begin, at, frequencies) | false => frequencies)
  out := (more? | true => optimal-literal-counts(input, begin, length, at + 1u64, next) | false => frequencies).
optimal-choose-all-literals(input<[u8]>, begin<u64>, length<u64>, reversed<[u8]>) => (out<optimal-literal-choice>) :=
  litlen0 := [0u32 | i <- 0u64..=288u64, i < 288u64]
  offsets := [0u32 | i <- 0u64..=32u64, i < 32u64]
  counts := optimal-literal-counts(input, begin, length, 0u64, litlen0)
  eof-count := huff-get32(counts, 256u64) + 1u32
  frequencies := huff-set32(counts, 256u64, eof-count)
  litlen-lens0 := [0u8 | i <- 0u64..=288u64, i < 288u64]
  litlen-words0 := [0u32 | i <- 0u64..=288u64, i < 288u64]
  litlen := huff-make-code(288u64, 14u64, frequencies, litlen-lens0, litlen-words0, reversed)
  offset-lens0 := [0u8 | i <- 0u64..=32u64, i < 32u64]
  offset-words0 := [0u32 | i <- 0u64..=32u64, i < 32u64]
  offset := huff-make-code(32u64, 15u64, offsets, offset-lens0, offset-words0, reversed)
  out := {freqs-litlen: frequencies, freqs-offset: offsets, litlen-lens: litlen.lens, litlen-codewords: litlen.codewords, offset-lens: offset.lens, offset-codewords: offset.codewords}.
