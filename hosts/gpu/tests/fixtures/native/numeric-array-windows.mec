// Forward and reverse views, like a read-only candidate-cost traversal.
+> sequence
+> bits
<choice> := <{best<u32> item<u64> k<u64>}>
#Window(costs<[u32]>, nodes<[u64]>, stop<u64>, start<u64>, best<u32>, item<u64>, fault<u64>) => <choice>
  | :Try(k<u64>, best<u32>, item<u64>)
  | :Done(k<u64>, best<u32>, item<u64>).
#Window(costs, nodes, stop, start, best, item, fault) -> :Try(start, best, item)
  :Try(k, best, item)
    | k < stop -> {
        at := bits/wrapping-add(k, 3u64)
        value := ((at < sequence/length(costs))? | true => costs[bits/wrapping-add(at, 1u64)] | false => 0u32)
        divisor := ((k == fault)? | true => 0u64 | false => 1u64)
        checked := 10u64 / divisor
        reverse := bits/wrapping-sub(sequence/length(nodes), at)
        node := ((reverse < sequence/length(nodes))? | true => nodes[bits/wrapping-add(reverse, 1u64)] | false => 0u64)
        wide<u64> := value
        sum := bits/and(bits/wrapping-add(wide, node), 4294967295u64)
        cost<u32> := sum
        next-best := ((cost < best)? | true => cost | false => best)
        next-item := ((cost < best)? | true => k + checked | false => item)
      } -> :Try(k + 1u64, next-best, next-item)
    | * -> :Done(k, best, item)
  :Done(k, best, item) => {best: best, item: item, k: k}.
walk(costs<[u32]>, nodes<[u64]>, left<u64>, stop<u64>, start<u64>, best<u32>, item<u64>, fault<u64>) => (out<choice>) :=
  more := left > 0u64
  selected := (more? | true => #Window(costs, nodes, stop, start, best, item, fault) | false => {best: best, item: item, k: start})
  out := (more? | true => walk(costs, nodes, left - 1u64, stop, selected.k, selected.best, selected.item, fault) | false => selected).
result := walk(prices<[u32]>, nodes<[u64]>, 2u64, stop<u64>, start<u64>, seed<u32>, nonce<u64>, fault<u64>)
(result.best, result.item, result.k)
