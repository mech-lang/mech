//! Same-Object image/symbol binding and compiled launcher dispatch.
use mech_gpu::native_artifact::{NativeProgramModule, launch::{BuildOwnedHostedBinding, @HOSTED_LAUNCHER@}};
unsafe extern "C" {
    #[link_name = "@COMPILED_MODULE_SYMBOL@"]
    static LINKED_MODULE: NativeProgramModule;
}
fn catalog() -> Result<mech_core::FunctionCatalog, String> {
    let mut builder = mech_core::FunctionCatalogBuilder::new();
@INSTALL_CANONICAL_FACTORIES@
    builder.build().map_err(|error| format!("{error:?}"))
}
fn main() {
    // SAFETY: build.rs verifies the unchanged Object/images and all generated
    // inputs. Entry, identity and images belong to that SAME checked build.
    let binding = unsafe { BuildOwnedHostedBinding::from_compiled_module(
        &LINKED_MODULE, include_bytes!("../native-resources.json"),
        catalog, @HOSTED_ROUTE_LITERAL@,
    ) };
    if let Err(error) = @HOSTED_LAUNCHER@(binding, std::env::args_os().skip(1)) {
        eprintln!("{error}"); std::process::exit(1);
    }
}
