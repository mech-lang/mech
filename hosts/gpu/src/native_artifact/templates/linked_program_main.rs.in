//! Linked managed CFG qualification shell, not a source evaluator or I/O host.
use mech_core::{ManagedMemoryBudget, snapshot::{SnapshotValidationContext, ValueDraft}};
use mech_gpu::native_artifact::{
    LinkedProgramArtifact, NATIVE_PROGRAM_LINK_IDENTITY_BYTES,
    NativeExecutionLimits, NativeProgramExecutionLimits,
};
use std::{ffi::{OsStr, c_void}, io::{Read, Write}, sync::Arc};

unsafe extern "C" {
    #[link_name = "mech_canonical_program_entry_v1"]
    fn linked_entry(frame: *mut c_void) -> u64;
    #[link_name = "@IDENTITY_SYMBOL@"]
    static LINKED_IDENTITY: [u8; NATIVE_PROGRAM_LINK_IDENTITY_BYTES];
}
fn hex(bytes: &[u8]) -> String {
    bytes.iter().map(|byte| format!("{byte:02x}")).collect()
}
fn unsigned(argument: &OsStr) -> Result<u64, String> {
    let text = argument.to_str().ok_or("policy is not Unicode")?;
    if text.is_empty() || !text.bytes().all(|byte| byte.is_ascii_digit()) {
        return Err("policy must be an exact U64".into());
    }
    text.parse().map_err(|_| "policy is outside U64".into())
}
fn run() -> Result<(), String> {
    let arguments = std::env::args_os().skip(1).collect::<Vec<_>>();
    if arguments.len() != 7 || arguments[5] != "--" {
        return Err("expected WORK BUDGET CALL_COMPUTE CALL_COMPARISON CALL_TEMPORARY -- INPUT_JSON".into());
    }
    let mut limits = NativeProgramExecutionLimits {
        execution: NativeExecutionLimits::default(),
        library: mech_core::TargetMemoryProfile::current_resident_cpu()
            .map_err(|error| format!("{error:?}"))?.limits,
    };
    limits.execution.max_work = unsigned(&arguments[0])?;
    let memory = ManagedMemoryBudget::new(unsigned(&arguments[1])?);
    limits.library.max_compute_work = Some(unsigned(&arguments[2])?);
    limits.library.max_comparison_work = Some(unsigned(&arguments[3])?);
    limits.library.max_temporary_bytes = Some(unsigned(&arguments[4])?);
    // Metadata/factory selection only; no frontend, JIT or graph execution.
    let catalog = std::thread::Builder::new()
        .name("canonical-native-catalog".into())
        .stack_size(64 * 1024 * 1024)
        .spawn(|| -> Result<_, String> {
            let mut builder = mech_core::FunctionCatalogBuilder::new();
            // Canonical artifacts bind through resident entries, not legacy
            // bytecode runtime factories. Do not retain their unused callees.
@INSTALL_CANONICAL_FACTORIES@
            builder.build().map_err(|error| format!("{error:?}"))
        })
        .map_err(|error| error.to_string())?
        .join().map_err(|_| "canonical metadata catalog construction panicked")??;
    // SAFETY: build.rs pins all generated inputs, including the exact Object.
    // The digest-qualified identity and entry are process-lifetime symbols
    // linked from that SAME unchanged checked emitter Object. The constructor
    // restores the exact build-prepared descriptor, verifies selected bindings
    // and checks the complete ABI/work/target/IR Object identity.
    let linked = unsafe {
        LinkedProgramArtifact::from_build_owned_image(
            include_bytes!("../native-descriptor.json"), &catalog, &LINKED_IDENTITY, linked_entry,
        )
    }.map_err(|error| error.to_string())?;
    // This explicit bounded transport is for linked qualification, not an
    // application-visible resource capability or an alternate Mech evaluator.
    const INPUT_BYTES: u64 = 16 * 1024 * 1024;
    let mut bytes = Vec::new();
    std::fs::File::open(&arguments[6]).map_err(|error| error.to_string())?
        .take(INPUT_BYTES + 1).read_to_end(&mut bytes).map_err(|error| error.to_string())?;
    if bytes.len() as u64 > INPUT_BYTES { return Err("qualification input is too large".into()); }
    let drafts: Vec<ValueDraft> = serde_json::from_slice(&bytes).map_err(|error| error.to_string())?;
    if drafts.len() != linked.descriptor().plan().inputs().len() {
        return Err("input count differs from canonical plan".into());
    }
    let schemas = Arc::new(linked.descriptor().schemas().clone());
    let mut inputs = Vec::with_capacity(drafts.len());
    for (draft, input) in drafts.into_iter().zip(linked.descriptor().plan().inputs()) {
        if draft.schema != input.ty().schema() { return Err("input schema differs from canonical plan".into()); }
        let value = draft.finalize(&SnapshotValidationContext::with_shared_schemas(&schemas))
            .map_err(|error| format!("{error:?}"))?;
        let mut reservation = memory.reserve_capacity(value.memory_budget_admission_bytes(&memory)
            .map_err(|error| format!("{error:?}"))?).map_err(|error| format!("{error:?}"))?;
        inputs.push(value.into_memory_budget(&mut reservation).map_err(|error| format!("{error:?}"))?);
    }
    let mut outputs = vec![None; linked.descriptor().plan().outputs().len()];
    linked.evaluate_into(&inputs, &mut outputs, limits, &memory).map_err(|error| error.to_string())?;
    // Complete canonical output after atomic native evaluation, not a checksum
    // or selected-result shortcut. The independent resident oracle uses the
    // same public export encoding, including exact schema, shape and payload.
    let mut output = String::new();
    for value in outputs {
        let value = value.ok_or("native output was not published")?;
        let bytes = value.canonical_snapshot_bytes(&schemas)
            .map_err(|error| format!("{error:?}"))?;
        output.push_str(&hex(&bytes)); output.push('\n');
    }
    let stdout = std::io::stdout(); let mut stdout = stdout.lock();
    stdout.write_all(output.as_bytes()).map_err(|error| error.to_string())?;
    stdout.flush().map_err(|error| error.to_string())
}
fn main() {
    if let Err(error) = run() { eprintln!("{error}"); std::process::exit(1); }
}
