index 0000000..f3ea65e
--- /dev/null
+++ b/src/engine/src/resident/general/native_matrix_templates.rs
@@ -0,0 +1,354 @@
+//! Symbolic metadata only. This module neither instantiates a ShapeInstance
+//! nor creates a BoundCall, native buffer, executor or executable plan.
+use super::{
+    NodeClass, ResidentActivationError, ResidentExternalAdmission, build_activation_schedule,
+    classify_nodes, node_inputs, node_output_slot,
+};
+use crate::{ArtifactSource, ExecutableNodeBody, ProgramArtifact, SlotRole};
+use mech_core::{
+    AccessMode, AliasPolicy, CellSlotId, ChangeDetectionPolicy, DeliveryMode, ExternalInteraction,
+    FloatWidth, FunctionCatalog, ImplementationMemoryClass, NodeId, OutputConstruction,
+    ProgramRevision, ResidentOperationKey, ResolvedOperationContract, Schema, SchemaBody, SchemaId,
+    ShapeRule,
+};
+
+/// Algorithm identity offered by the actual selected maintained registration.
+/// This public enum is not itself a reusable certificate or executable plan.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum NativeMatrixPrimitive {
+    TransposeF64,
+    MatmulF64,
+}
+
+/// A constructor-private symbolic certificate for one actual artifact node.
+/// Current shapes, native memory/work policies and execution are later work.
+#[derive(Clone, Debug)]
+pub struct NativeMatrixOperationTemplate {
+    revision: ProgramRevision,
+    node: NodeId,
+    target: CellSlotId,
+    selected_key: ResidentOperationKey,
+    primitive: NativeMatrixPrimitive,
+    sources: Box<[ArtifactSource]>,
+    inputs: Box<[Schema]>,
+    output: Schema,
+    contract: ResolvedOperationContract,
+    implementation_memory: ImplementationMemoryClass,
+}
+impl NativeMatrixOperationTemplate {
+    pub const fn program_revision(&self) -> ProgramRevision {
+        self.revision
+    }
+    pub const fn node(&self) -> NodeId {
+        self.node
+    }
+    pub const fn target(&self) -> CellSlotId {
+        self.target
+    }
+    pub fn selected_key(&self) -> &ResidentOperationKey {
+        &self.selected_key
+    }
+    pub const fn primitive(&self) -> NativeMatrixPrimitive {
+        self.primitive
+    }
+    pub fn sources(&self) -> &[ArtifactSource] {
+        &self.sources
+    }
+    pub fn inputs(&self) -> &[Schema] {
+        &self.inputs
+    }
+    pub fn output(&self) -> &Schema {
+        &self.output
+    }
+    pub fn contract(&self) -> &ResolvedOperationContract {
+        &self.contract
+    }
+    /// Source implementation metadata, not a native executor cost allowance.
+    pub const fn implementation_memory(&self) -> ImplementationMemoryClass {
+        self.implementation_memory
+    }
+    /// This relation must be evaluated from real current descriptors before a
+    /// later executor may construct a BoundCall or allocate any result.
+    pub const fn shape_rule(&self) -> ShapeRule {
+        match self.primitive {
+            NativeMatrixPrimitive::TransposeF64 => ShapeRule::TransposeOf { input: 0 },
+            NativeMatrixPrimitive::MatmulF64 => ShapeRule::MatrixProduct { lhs: 0, rhs: 1 },
+        }
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum NativeMatrixTemplateError {
+    UnsupportedProgram { feature: &'static str },
+    UnsupportedNode { node: NodeId, feature: &'static str },
+    UnsupportedSchema { schema: SchemaId },
+    InvalidBinding { node: NodeId },
+    MissingImplementationCertificate { node: NodeId },
+    UnsupportedContract { node: NodeId },
+    ArtifactBinding { error: ResidentActivationError },
+}
+impl std::fmt::Display for NativeMatrixTemplateError {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(formatter, "canonical native matrix template: {self:?}")
+    }
+}
+impl std::error::Error for NativeMatrixTemplateError {}
+impl From<ResidentActivationError> for NativeMatrixTemplateError {
+    fn from(error: ResidentActivationError) -> Self {
+        Self::ArtifactBinding { error }
+    }
+}
+
+fn matrix_schema(
+    artifact: &ProgramArtifact,
+    id: SchemaId,
+) -> Result<Schema, NativeMatrixTemplateError> {
+    let schema = artifact
+        .schemas()
+        .get(id)
+        .ok_or(NativeMatrixTemplateError::UnsupportedSchema { schema: id })?;
+    match schema.body() {
+        SchemaBody::Matrix {
+            element,
+            dimensions,
+        } if element.as_ref() == &SchemaBody::FloatingPoint(FloatWidth::W64)
+            && dimensions.len() == 2 =>
+        {
+            Ok(schema.clone())
+        }
+        _ => Err(NativeMatrixTemplateError::UnsupportedSchema { schema: id }),
+    }
+}
+
+fn source_schema(artifact: &ProgramArtifact, source: ArtifactSource) -> Option<SchemaId> {
+    match source {
+        ArtifactSource::Slot(slot) => artifact
+            .slots()
+            .get(slot.get() as usize)
+            .map(|slot| slot.schema),
+        ArtifactSource::Constant(constant) => artifact
+            .constants()
+            .get(constant)
+            .map(|value| value.schema()),
+    }
+}
+
+fn validate_contract(
+    node: NodeId,
+    primitive: NativeMatrixPrimitive,
+    contract: &ResolvedOperationContract,
+    input_ids: &[SchemaId],
+    output_id: SchemaId,
+) -> Result<(), NativeMatrixTemplateError> {
+    let ResolvedOperationContract::Declared(contract) = contract else {
+        return Err(NativeMatrixTemplateError::UnsupportedContract { node });
+    };
+    let arity = if primitive == NativeMatrixPrimitive::TransposeF64 {
+        1
+    } else {
+        2
+    };
+    let shape = if arity == 1 {
+        ShapeRule::TransposeOf { input: 0 }
+    } else {
+        ShapeRule::MatrixProduct { lhs: 0, rhs: 1 }
+    };
+    let valid = input_ids.len() == arity
+        && contract.inputs.len() == arity
+        && contract.interaction == ExternalInteraction::Pure
+        && contract.inputs.iter().zip(input_ids).all(|(port, id)| {
+            port.schema == *id
+                && port.access == AccessMode::Read
+                && port.delivery == DeliveryMode::Signal
+        })
+        && matches!(contract.outputs.as_ref(), [output]
+            if output.schema == output_id && output.access == AccessMode::Write
+                && output.delivery == DeliveryMode::Signal
+                && output.construction == (OutputConstruction::FullWrite { shape })
+                && output.alias == AliasPolicy::NoAlias
+                && output.change_detection == ChangeDetectionPolicy::KernelReported);
+    if valid {
+        Ok(())
+    } else {
+        Err(NativeMatrixTemplateError::UnsupportedContract { node })
+    }
+}
+
+/// Certifies a pure, stateless, matrix-only ordinary artifact without reading
+/// any live value or calling any factory/executor. Factory lookup selects the
+/// actual implementation; its engine-private certificate supplies semantics.
+/// No fallback program is run for any unsupported node or selected factory.
+pub fn matrix_operation_templates(
+    artifact: &ProgramArtifact,
+    catalog: &FunctionCatalog,
+) -> Result<Box<[NativeMatrixOperationTemplate]>, NativeMatrixTemplateError> {
+    if !artifact.requirements().is_empty()
+        || !artifact.constraints().is_empty()
+        || !artifact.compute_regions().is_empty()
+    {
+        return Err(NativeMatrixTemplateError::UnsupportedProgram {
+            feature: "resources, constraints or compute regions",
+        });
+    }
+    for slot in artifact.slots() {
+        if slot.role == SlotRole::State || slot.initializer.is_some() {
+            return Err(NativeMatrixTemplateError::UnsupportedProgram {
+                feature: "state or initializers",
+            });
+        }
+        matrix_schema(artifact, slot.schema)?;
+    }
+    for node in artifact.nodes() {
+        if !matches!(&node.body, ExecutableNodeBody::Operation(operation) if operation.requirement.is_none())
+        {
+            return Err(NativeMatrixTemplateError::UnsupportedNode {
+                node: node.node,
+                feature: "control or resource operation",
+            });
+        }
+    }
+    let classes = classify_nodes(artifact, ResidentExternalAdmission::StructuralOnly)?;
+    for node in artifact.nodes() {
+        if classes[node.node.get() as usize] != NodeClass::Turn {
+            return Err(NativeMatrixTemplateError::UnsupportedNode {
+                node: node.node,
+                feature: "non-Turn computation",
+            });
+        }
+    }
+    let schedule = build_activation_schedule(artifact, &classes)?;
+    let mut templates = Vec::with_capacity(schedule.nodes.len());
+    for node in schedule.nodes.iter().copied() {
+        let body = artifact.nodes()[node.get() as usize]
+            .as_operation()
+            .ok_or(NativeMatrixTemplateError::InvalidBinding { node })?;
+        let entry = catalog
+            .resident_factory(&body.operation.module_path, &body.operation.operation_name)
+            .ok_or(NativeMatrixTemplateError::MissingImplementationCertificate { node })?;
+        let primitive = super::super::native_matrix_semantics::primitive(entry)
+            .ok_or(NativeMatrixTemplateError::MissingImplementationCertificate { node })?;
+        let sources = node_inputs(artifact, node)?;
+        let input_ids = sources
+            .iter()
+            .map(|source| {
+                source_schema(artifact, *source)
+                    .ok_or(NativeMatrixTemplateError::InvalidBinding { node })
+            })
+            .collect::<Result<Vec<_>, _>>()?;
+        let target = node_output_slot(artifact, node)?;
+        let output_id = artifact.slots()[target.get() as usize].schema;
+        let contract = artifact
+            .contracts()
+            .get(body.contract)
+            .ok_or(NativeMatrixTemplateError::InvalidBinding { node })?;
+        validate_contract(node, primitive, contract, &input_ids, output_id)?;
+        templates.push(NativeMatrixOperationTemplate {
+            revision: artifact.revision(),
+            node,
+            target,
+            selected_key: entry.key().clone(),
+            primitive,
+            sources: sources.into_boxed_slice(),
+            inputs: input_ids
+                .iter()
+                .map(|id| matrix_schema(artifact, *id))
+                .collect::<Result<Box<[_]>, _>>()?,
+            output: matrix_schema(artifact, output_id)?,
+            contract: contract.clone(),
+            implementation_memory: entry.implementation_memory(),
+        });
+    }
+    Ok(templates.into_boxed_slice())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use mech_core::{DeclaredOperationContract, ResolvedInputPort, ResolvedOutputPort};
+
+    fn contract(
+        primitive: NativeMatrixPrimitive,
+    ) -> (Vec<SchemaId>, SchemaId, ResolvedOperationContract) {
+        let arity = if primitive == NativeMatrixPrimitive::TransposeF64 {
+            1
+        } else {
+            2
+        };
+        let ids = (0..arity)
+            .map(|ordinal| SchemaId::new(ordinal as u32))
+            .collect::<Vec<_>>();
+        let output = SchemaId::new(arity as u32);
+        let contract = ResolvedOperationContract::Declared(DeclaredOperationContract {
+            inputs: ids
+                .iter()
+                .map(|schema| ResolvedInputPort {
+                    schema: *schema,
+                    access: AccessMode::Read,
+                    delivery: DeliveryMode::Signal,
+                })
+                .collect(),
+            outputs: Box::new([ResolvedOutputPort {
+                schema: output,
+                access: AccessMode::Write,
+                delivery: DeliveryMode::Signal,
+                construction: OutputConstruction::FullWrite {
+                    shape: if arity == 1 {
+                        ShapeRule::TransposeOf { input: 0 }
+                    } else {
+                        ShapeRule::MatrixProduct { lhs: 0, rhs: 1 }
+                    },
+                },
+                alias: AliasPolicy::NoAlias,
+                change_detection: ChangeDetectionPolicy::KernelReported,
+            }]),
+            interaction: ExternalInteraction::Pure,
+        });
+        (ids, output, contract)
+    }
+
+    #[test]
+    fn symbolic_templates_require_exact_maintained_contract_without_concrete_shapes() {
+        for primitive in [
+            NativeMatrixPrimitive::TransposeF64,
+            NativeMatrixPrimitive::MatmulF64,
+        ] {
+            let (inputs, output, original) = contract(primitive);
+            let node = NodeId::new(7);
+            validate_contract(node, primitive, &original, &inputs, output).unwrap();
+            let mut replacements = Vec::new();
+            let mut changed = original.clone();
+            let ResolvedOperationContract::Declared(contract) = &mut changed else {
+                unreachable!()
+            };
+            contract.outputs[0].construction = OutputConstruction::FullWrite {
+                shape: ShapeRule::Declared,
+            };
+            replacements.push(changed);
+            let mut changed = original.clone();
+            let ResolvedOperationContract::Declared(contract) = &mut changed else {
+                unreachable!()
+            };
+            contract.outputs[0].alias = AliasPolicy::MayAlias { input: 0 };
+            replacements.push(changed);
+            let mut changed = original.clone();
+            let ResolvedOperationContract::Declared(contract) = &mut changed else {
+                unreachable!()
+            };
+            contract.inputs[0].delivery = DeliveryMode::Stream;
+            replacements.push(changed);
+            let mut changed = original.clone();
+            let ResolvedOperationContract::Declared(contract) = &mut changed else {
+                unreachable!()
+            };
+            contract.inputs[0].schema = output;
+            replacements.push(changed);
+            for changed in replacements {
+                assert_eq!(
+                    validate_contract(node, primitive, &changed, &inputs, output),
+                    Err(NativeMatrixTemplateError::UnsupportedContract { node })
+                );
+            }
+            assert!(validate_contract(node, primitive, &original, &inputs[..0], output).is_err());
+        }
+    }
+}
