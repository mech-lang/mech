+//! Private registration proof for two maintained symbolic matrix branches.
+//! The public factory entry's typed attachment is storage, not authority.
+use crate::native_artifact::NativeMatrixPrimitive;
+use mech_core::{
+    FunctionCatalogBuilder, ImplementationMemoryClass, MResult, ResidentKernelFactoryEntry,
+    ResidentOperationKey,
+};
+use std::sync::Arc;
+
+/// No state, callable, or public constructor can escape this defining module.
+/// Its only attach sites select the maintained functions directly below.
+struct MatrixFactoryWitness {
+    primitive: NativeMatrixPrimitive,
+}
+
+pub(super) fn register_matmul(
+    builder: &mut FunctionCatalogBuilder,
+    name: &'static str,
+) -> MResult<()> {
+    let key = ResidentOperationKey::new(Box::new(["matrix".into()]), name.into())
+        .expect("maintained matrix registration has a valid key");
+    builder.insert_resident_factory_entry(
+        ResidentKernelFactoryEntry::new(
+            key,
+            ImplementationMemoryClass::NoAdditionalScratch,
+            super::numeric::bind_matmul,
+        )
+        .with_lowering_witness(Arc::new(MatrixFactoryWitness {
+            primitive: NativeMatrixPrimitive::MatmulF64,
+        })),
+    )
+}
+
+pub(super) fn register_transpose(builder: &mut FunctionCatalogBuilder) -> MResult<()> {
+    let key = ResidentOperationKey::new(Box::new(["matrix".into()]), "transpose".into())
+        .expect("maintained matrix registration has a valid key");
+    builder.insert_resident_factory_entry(
+        ResidentKernelFactoryEntry::new(
+            key,
+            ImplementationMemoryClass::CanonicalFinalize,
+            super::numeric::bind_semantic_transpose,
+        )
+        .with_lowering_witness(Arc::new(MatrixFactoryWitness {
+            primitive: NativeMatrixPrimitive::TransposeF64,
+        })),
+    )
+}
+
+/// Only a read-only opcode escapes internally. The private witness cannot be
+/// extracted/re-attached by callers; all entry mutations clear it first.
+pub(super) fn primitive(entry: &ResidentKernelFactoryEntry) -> Option<NativeMatrixPrimitive> {
+    entry
+        .lowering_witness::<MatrixFactoryWitness>()
+        .map(|witness| witness.primitive)
+}
