+//! Typed, constructor-private dynamic Matrix<F64> native plan.
+//! Selected factory templates supply semantics; current descriptors and shapes
+//! are instantiated only from actual invocation values, never fake extents.
+use super::{NativeMatrixOperationTemplate, NativeMatrixPrimitive, NativeMatrixTemplateError};
+use crate::{ArtifactSource, ProducerReference, ProgramArtifact};
+use mech_core::{
+    BoundCall, CallMemoryPlan, CallMemoryPlanningRequest, CellSlotId, ConstantId,
+    CurrentMemoryFootprint, DimensionExpr, DimensionLifetime, ExecutionTarget, FloatWidth,
+    FunctionCatalog, FunctionMatrixElement, FunctionMatrixRepresentation,
+    FunctionMatrixStoragePattern, FunctionValueRepresentation, InputId, MemoryFootprintWitness,
+    MemoryLifetime, MemoryPlanPoint, NodeId, OutputId, ProgramRevision, RegionAccessPlan,
+    ResolvedOperationDescriptor, ResolvedValueDescriptor, Schema, SchemaBody, SchemaId, SchemaKey,
+    SchemaTable, TargetMemoryProfile, Value,
+};
+use std::{collections::BTreeMap, sync::Arc};
+
+/// Cost metadata, never semantic authority. Computed outside evaluation from
+/// the sealed finite schemas; the evaluator must admit it before cloning or
+/// traversing call descriptors and invoking the core memory planner.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct NativeMatrixPlanningDemand {
+    pub work: u64,
+    pub temporary_bytes: u64,
+    pub retained_nodes: u64,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub struct NativeMatrixValueId(u32);
+impl NativeMatrixValueId {
+    pub const fn get(self) -> u32 {
+        self.0
+    }
+}
+#[derive(Clone, Debug)]
+pub struct NativeMatrixType {
+    schema_id: SchemaId,
+    schema_key: SchemaKey,
+    schema: Schema,
+    metadata: NativeMatrixPlanningDemand,
+}
+impl NativeMatrixType {
+    pub const fn schema_id(&self) -> SchemaId {
+        self.schema_id
+    }
+    pub const fn schema_key(&self) -> SchemaKey {
+        self.schema_key
+    }
+    pub fn schema(&self) -> &Schema {
+        &self.schema
+    }
+    pub const fn planning_demand(&self) -> NativeMatrixPlanningDemand {
+        self.metadata
+    }
+}
+#[derive(Clone, Debug)]
+pub struct NativeMatrixInput {
+    id: InputId,
+    slot: CellSlotId,
+    name: String,
+    value: NativeMatrixValueId,
+}
+impl NativeMatrixInput {
+    pub const fn input(&self) -> InputId {
+        self.id
+    }
+    pub const fn slot(&self) -> CellSlotId {
+        self.slot
+    }
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+    pub const fn value(&self) -> NativeMatrixValueId {
+        self.value
+    }
+}
+#[derive(Clone, Debug)]
+pub struct NativeMatrixConstant {
+    constant: ConstantId,
+    value: NativeMatrixValueId,
+    canonical: Value,
+}
+impl NativeMatrixConstant {
+    pub const fn constant(&self) -> ConstantId {
+        self.constant
+    }
+    pub const fn value(&self) -> NativeMatrixValueId {
+        self.value
+    }
+    pub fn canonical(&self) -> &Value {
+        &self.canonical
+    }
+}
+#[derive(Clone, Debug)]
+pub struct NativeMatrixCall {
+    template: NativeMatrixOperationTemplate,
+    operands: Box<[NativeMatrixValueId]>,
+    output: NativeMatrixValueId,
+    demand: NativeMatrixPlanningDemand,
+}
+impl NativeMatrixCall {
+    pub fn template(&self) -> &NativeMatrixOperationTemplate {
+        &self.template
+    }
+    pub fn operands(&self) -> &[NativeMatrixValueId] {
+        &self.operands
+    }
+    pub const fn output(&self) -> NativeMatrixValueId {
+        self.output
+    }
+    pub const fn planning_demand(&self) -> NativeMatrixPlanningDemand {
+        self.demand
+    }
+}
+#[derive(Clone, Debug)]
+pub struct NativeMatrixOutput {
+    output: OutputId,
+    slot: CellSlotId,
+    name: String,
+    interactive_binding: Option<crate::InteractiveSymbolBinding>,
+    value: NativeMatrixValueId,
+}
+impl NativeMatrixOutput {
+    pub const fn output(&self) -> OutputId {
+        self.output
+    }
+    pub const fn slot(&self) -> CellSlotId {
+        self.slot
+    }
+    pub fn interactive_binding(&self) -> Option<&crate::InteractiveSymbolBinding> {
+        self.interactive_binding.as_ref()
+    }
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+    pub const fn value(&self) -> NativeMatrixValueId {
+        self.value
+    }
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct NativeMatrixCallBounds {
+    pub rows: u64,
+    pub inner: u64,
+    pub columns: u64,
+    pub output_elements: u64,
+    pub output_bytes: u64,
+    pub compute_work: u64,
+}
+/// No public unchecked constructor, deserializer, mutable plan view or erased
+/// certificate can manufacture this executable-lowering input.
+#[derive(Clone, Debug)]
+pub struct NativeMatrixArtifactPlan {
+    revision: ProgramRevision,
+    schemas: Arc<SchemaTable>,
+    values: Box<[NativeMatrixType]>,
+    inputs: Box<[NativeMatrixInput]>,
+    constants: Box<[NativeMatrixConstant]>,
+    calls: Box<[NativeMatrixCall]>,
+    outputs: Box<[NativeMatrixOutput]>,
+    setup_demand: NativeMatrixPlanningDemand,
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum NativeMatrixPlanError {
+    Template(NativeMatrixTemplateError),
+    InvalidBinding {
+        node: Option<NodeId>,
+        reason: &'static str,
+    },
+    UnsupportedSchema {
+        schema: SchemaId,
+    },
+    UnsupportedDimensionMetadata {
+        schema: SchemaId,
+    },
+    Shape {
+        node: NodeId,
+    },
+    Planning {
+        node: NodeId,
+    },
+    Limit {
+        reason: &'static str,
+    },
+}
+impl std::fmt::Display for NativeMatrixPlanError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "canonical native matrix plan: {self:?}")
+    }
+}
+impl std::error::Error for NativeMatrixPlanError {}
+impl From<NativeMatrixTemplateError> for NativeMatrixPlanError {
+    fn from(value: NativeMatrixTemplateError) -> Self {
+        Self::Template(value)
+    }
+}
+fn limit() -> NativeMatrixPlanError {
+    NativeMatrixPlanError::Limit {
+        reason: "native matrix metadata overflow",
+    }
+}
+fn add(a: u64, b: u64) -> Result<u64, NativeMatrixPlanError> {
+    a.checked_add(b).ok_or_else(limit)
+}
+fn mul(a: u64, b: u64) -> Result<u64, NativeMatrixPlanError> {
+    a.checked_mul(b).ok_or_else(limit)
+}
+/// Conservative allocation/work model for the bounded metadata accepted by
+/// `type_of`, not an estimate based on payload bytes. The corresponding core
+/// path is ResolvedValueDescriptor::from_schema/new -> ResolvedType::from_schema
+/// (two validations), BoundCall::artifact_operation_for_target, plan_call_memory.
+///
+/// Per descriptor, reserve 64 schema-sized metadata records: two descriptor
+/// construction passes each use fewer than 16 schema/kind/environment records;
+/// caller/BoundCall/PortMemoryPlan/result copies use fewer than 8 more. The
+/// remaining 24 cover Vec growth and declaration-vs-finalized type headers.
+/// Each record has at most two constant-bound parameters and a rank-two leaf;
+/// 256 logical units per record cover normalization, equality, bound evaluation
+/// and the two-axis capacity passes. 64 fixed planner records per call below
+/// separately cover requirements, allocations, aliases and transactions.
+fn descriptor_planning_demand(
+    schema: &Schema,
+    encoded_bytes: usize,
+) -> Result<NativeMatrixPlanningDemand, NativeMatrixPlanError> {
+    let heap = schema.clone_allocation_bound_bytes().ok_or_else(limit)?;
+    let parameters = u64::try_from(schema.dimension_parameters().len()).map_err(|_| limit())?;
+    let record = add(
+        add(heap, core::mem::size_of::<ResolvedValueDescriptor>() as u64)?,
+        add(
+            core::mem::size_of::<mech_core::ResolvedType>() as u64,
+            mul(
+                parameters,
+                core::mem::size_of::<mech_core::DimensionParameterDeclaration>() as u64,
+            )?,
+        )?,
+    )?;
+    let encoded = u64::try_from(encoded_bytes).map_err(|_| limit())?;
+    Ok(NativeMatrixPlanningDemand {
+        work: add(mul(64, 256)?, mul(add(record, encoded)?, 64)?)?,
+        temporary_bytes: mul(record, 64)?,
+        retained_nodes: mul(64, add(parameters, 4)?)?,
+    })
+}
+fn merge_demand(
+    left: NativeMatrixPlanningDemand,
+    right: NativeMatrixPlanningDemand,
+) -> Result<NativeMatrixPlanningDemand, NativeMatrixPlanError> {
+    Ok(NativeMatrixPlanningDemand {
+        work: add(left.work, right.work)?,
+        temporary_bytes: add(left.temporary_bytes, right.temporary_bytes)?,
+        retained_nodes: add(left.retained_nodes, right.retained_nodes)?,
+    })
+}
+fn call_planner_headers() -> Result<NativeMatrixPlanningDemand, NativeMatrixPlanError> {
+    // Unary/binary, one output: <= 3 ports, 3 values + one stage + at most
+    // canonical construction scratch. 64 records exceeds all live/growing
+    // planner Vec/BTreeMap entries; two root plans cover caller/result overlap.
+    let record = add(
+        core::mem::size_of::<mech_core::AllocationPlan>() as u64,
+        add(
+            core::mem::size_of::<mech_core::PortMemoryPlan>() as u64,
+            core::mem::size_of::<mech_core::PhysicalStorageDescriptor>() as u64,
+        )?,
+    )?;
+    Ok(NativeMatrixPlanningDemand {
+        work: 64 * 256,
+        temporary_bytes: add(
+            mul(record, 64)?,
+            mul(core::mem::size_of::<CallMemoryPlan>() as u64, 2)?,
+        )?,
+        retained_nodes: 64,
+    })
+}
+fn type_of(
+    artifact: &ProgramArtifact,
+    id: SchemaId,
+) -> Result<NativeMatrixType, NativeMatrixPlanError> {
+    let entry = artifact
+        .schemas()
+        .entry(id)
+        .ok_or(NativeMatrixPlanError::UnsupportedSchema { schema: id })?;
+    let schema = entry.schema();
+    if !matches!(schema.body(), SchemaBody::Matrix { element, dimensions }
+        if element.as_ref()==&SchemaBody::FloatingPoint(FloatWidth::W64) && dimensions.len()==2)
+    {
+        return Err(NativeMatrixPlanError::UnsupportedSchema { schema: id });
+    }
+    // This first executable slice has a *bounded metadata language*, separate
+    // from ordinary Mech's general dimension language. At most two parameters
+    // occur under the two Constant/Parameter axes, every parameter is Turn,
+    // and every bound is Constant. No activation fact is invented by evaluation.
+    // No capacity-bound dependency graph can expand during core planning.
+    if schema.dimension_parameters().len() > 2
+        || !matches!(schema.body(), SchemaBody::Matrix { dimensions, .. }
+            if dimensions.iter().all(|axis| matches!(axis,
+                DimensionExpr::Constant(_) | DimensionExpr::Parameter(_))))
+        || schema.dimension_parameters().iter().any(|parameter| {
+            parameter.lifetime() != DimensionLifetime::Turn
+                || !matches!(parameter.lower_bound(), DimensionExpr::Constant(_))
+                || parameter
+                    .upper_bound()
+                    .is_some_and(|upper| !matches!(upper, DimensionExpr::Constant(_)))
+        })
+    {
+        return Err(NativeMatrixPlanError::UnsupportedDimensionMetadata { schema: id });
+    }
+    let metadata = descriptor_planning_demand(schema, entry.canonical_bytes().len())?;
+    Ok(NativeMatrixType {
+        schema_id: id,
+        schema_key: entry.key(),
+        schema: schema.clone(),
+        metadata,
+    })
+}
+fn source_key(
+    artifact: &ProgramArtifact,
+    mut source: ArtifactSource,
+) -> Result<ArtifactSource, NativeMatrixPlanError> {
+    for _ in 0..=artifact.slots().len() {
+        let ArtifactSource::Slot(slot) = source else {
+            return Ok(source);
+        };
+        let declaration = artifact.slots().get(slot.get() as usize).ok_or(
+            NativeMatrixPlanError::InvalidBinding {
+                node: None,
+                reason: "unknown matrix source slot",
+            },
+        )?;
+        if let ProducerReference::Output {
+            source: forwarded, ..
+        } = declaration.producer
+        {
+            source = forwarded;
+        } else {
+            return Ok(source);
+        }
+    }
+    Err(NativeMatrixPlanError::InvalidBinding {
+        node: None,
+        reason: "cyclic matrix output forwarding",
+    })
+}
+/// Metadata-only adapter. Every scheduled call comes from the actual selected
+/// factory's private symbolic certificate. No initializer or kernel is run.
+pub fn lower_matrix_artifact(
+    artifact: &ProgramArtifact,
+    catalog: &FunctionCatalog,
+) -> Result<NativeMatrixArtifactPlan, NativeMatrixPlanError> {
+    let templates = super::matrix_operation_templates(artifact, catalog)?;
+    let mut values = Vec::new();
+    let mut inputs = Vec::new();
+    let mut constants = Vec::new();
+    let mut calls = Vec::new();
+    let mut bindings = BTreeMap::new();
+    fn insert(
+        values: &mut Vec<NativeMatrixType>,
+        ty: NativeMatrixType,
+    ) -> Result<NativeMatrixValueId, NativeMatrixPlanError> {
+        let id = NativeMatrixValueId(u32::try_from(values.len()).map_err(|_| limit())?);
+        values.push(ty);
+        Ok(id)
+    }
+    for input in artifact.inputs() {
+        let value = insert(&mut values, type_of(artifact, input.schema)?)?;
+        if bindings
+            .insert(ArtifactSource::Slot(input.slot), value)
+            .is_some()
+        {
+            return Err(NativeMatrixPlanError::InvalidBinding {
+                node: None,
+                reason: "duplicate matrix input slot",
+            });
+        }
+        inputs.push(NativeMatrixInput {
+            id: input.input,
+            slot: input.slot,
+            name: input.name.clone(),
+            value,
+        });
+    }
+    // Only referenced constants participate. This is immutable canonical data,
+    // not a computed Activation expression evaluated by the compiler.
+    let constant_sources = templates
+        .iter()
+        .flat_map(|template| template.sources().iter().copied())
+        .chain(
+            artifact
+                .outputs()
+                .iter()
+                .map(|output| ArtifactSource::Slot(output.source)),
+        );
+    for source in constant_sources {
+        let key = source_key(artifact, source)?;
+        if let ArtifactSource::Constant(id) = key {
+            if let std::collections::btree_map::Entry::Vacant(slot) = bindings.entry(key) {
+                let canonical =
+                    artifact
+                        .constants()
+                        .get(id)
+                        .ok_or(NativeMatrixPlanError::InvalidBinding {
+                            node: None,
+                            reason: "unknown matrix constant",
+                        })?;
+                let value = insert(&mut values, type_of(artifact, canonical.schema())?)?;
+                slot.insert(value);
+                constants.push(NativeMatrixConstant {
+                    constant: id,
+                    value,
+                    canonical: canonical.clone(),
+                });
+            }
+        }
+    }
+    for template in templates {
+        let operands = template
+            .sources()
+            .iter()
+            .map(|&source| {
+                bindings.get(&source_key(artifact, source)?).copied().ok_or(
+                    NativeMatrixPlanError::InvalidBinding {
+                        node: Some(template.node()),
+                        reason: "non-dominating matrix input",
+                    },
+                )
+            })
+            .collect::<Result<Box<[_]>, _>>()?;
+        let target = template.target();
+        let ty = type_of(artifact, artifact.slots()[target.get() as usize].schema)?;
+        let mut demand = merge_demand(ty.metadata, call_planner_headers()?)?;
+        for &operand in &operands {
+            let input = values.get(operand.get() as usize).ok_or_else(limit)?;
+            demand = merge_demand(demand, input.metadata)?;
+        }
+        let output = insert(&mut values, ty)?;
+        if bindings
+            .insert(ArtifactSource::Slot(target), output)
+            .is_some()
+        {
+            return Err(NativeMatrixPlanError::InvalidBinding {
+                node: Some(template.node()),
+                reason: "duplicate matrix result",
+            });
+        }
+        calls.push(NativeMatrixCall {
+            template,
+            operands,
+            output,
+            demand,
+        });
+    }
+    let outputs =
+        artifact
+            .outputs()
+            .iter()
+            .map(|output| {
+                let source = source_key(artifact, ArtifactSource::Slot(output.source))?;
+                let value = bindings.get(&source).copied().ok_or(
+                    NativeMatrixPlanError::InvalidBinding {
+                        node: None,
+                        reason: "unbound matrix output alias",
+                    },
+                )?;
+                Ok(NativeMatrixOutput {
+                    output: output.output,
+                    slot: output.source,
+                    name: output.name.clone(),
+                    interactive_binding: output.interactive_binding.clone(),
+                    value,
+                })
+            })
+            .collect::<Result<Box<[_]>, NativeMatrixPlanError>>()?;
+    let mut setup_demand = call_planner_headers()?;
+    for ty in &values {
+        setup_demand = merge_demand(setup_demand, ty.metadata)?;
+    }
+    let interface_entries = add(
+        inputs.len() as u64,
+        add(constants.len() as u64, outputs.len() as u64)?,
+    )?;
+    setup_demand.work = add(setup_demand.work, mul(interface_entries, 256)?)?;
+    setup_demand.temporary_bytes = add(
+        setup_demand.temporary_bytes,
+        mul(
+            interface_entries,
+            core::mem::size_of::<NativeMatrixValueId>() as u64,
+        )?,
+    )?;
+    setup_demand.retained_nodes = add(setup_demand.retained_nodes, interface_entries)?;
+    Ok(NativeMatrixArtifactPlan {
+        revision: artifact.revision(),
+        schemas: Arc::new(artifact.schemas().clone()),
+        values: values.into(),
+        inputs: inputs.into(),
+        constants: constants.into(),
+        calls: calls.into(),
+        outputs,
+        setup_demand,
+    })
+}
+impl NativeMatrixArtifactPlan {
+    pub const fn program_revision(&self) -> ProgramRevision {
+        self.revision
+    }
+    pub fn schemas(&self) -> &Arc<SchemaTable> {
+        &self.schemas
+    }
+    /// Admit before per-invocation descriptor/interface metadata construction.
+    /// Payload import, backing buffers and leaf arithmetic are separate bounds.
+    pub const fn setup_demand(&self) -> NativeMatrixPlanningDemand {
+        self.setup_demand
+    }
+    pub fn values(&self) -> &[NativeMatrixType] {
+        &self.values
+    }
+    pub fn inputs(&self) -> &[NativeMatrixInput] {
+        &self.inputs
+    }
+    pub fn constants(&self) -> &[NativeMatrixConstant] {
+        &self.constants
+    }
+    pub fn calls(&self) -> &[NativeMatrixCall] {
+        &self.calls
+    }
+    pub fn outputs(&self) -> &[NativeMatrixOutput] {
+        &self.outputs
+    }
+    pub fn call_bounds(
+        &self,
+        ordinal: usize,
+        inputs: &[[u64; 2]],
+    ) -> Result<NativeMatrixCallBounds, NativeMatrixPlanError> {
+        let call = self
+            .calls
+            .get(ordinal)
+            .ok_or(NativeMatrixPlanError::InvalidBinding {
+                node: None,
+                reason: "unknown matrix call",
+            })?;
+        let bad = || NativeMatrixPlanError::Shape {
+            node: call.template.node(),
+        };
+        let (rows, inner, columns, compute_work) = match (call.template.primitive(), inputs) {
+            (NativeMatrixPrimitive::TransposeF64, [[rows, columns]]) => (
+                *columns,
+                0,
+                *rows,
+                add(64, mul(mul(*rows, *columns)?, 32)?)?,
+            ),
+            (NativeMatrixPrimitive::MatmulF64, [[rows, inner], [rhs, columns]]) if inner == rhs => {
+                (
+                    *rows,
+                    *inner,
+                    *columns,
+                    add(64, mul(mul(*rows, *columns)?, add(32, mul(*inner, 16)?)?)?)?,
+                )
+            }
+            _ => return Err(bad()),
+        };
+        let output_elements = mul(rows, columns)?;
+        let output_bytes = mul(output_elements, 8)?;
+        Ok(NativeMatrixCallBounds {
+            rows,
+            inner,
+            columns,
+            output_elements,
+            output_bytes,
+            compute_work,
+        })
+    }
+    /// The caller must admit call.planning_demand before this complete metadata
+    /// planning pass. No payload pointer/view or result allocation is acquired.
+    pub fn instantiate_call(
+        &self,
+        ordinal: usize,
+        inputs: &[ResolvedValueDescriptor],
+    ) -> Result<CallMemoryPlan, NativeMatrixPlanError> {
+        let call = self
+            .calls
+            .get(ordinal)
+            .ok_or(NativeMatrixPlanError::InvalidBinding {
+                node: None,
+                reason: "unknown matrix call",
+            })?;
+        let bad = || NativeMatrixPlanError::Planning {
+            node: call.template.node(),
+        };
+        if inputs.len() != call.operands.len() {
+            return Err(bad());
+        }
+        let mut extents = Vec::with_capacity(inputs.len());
+        let mut normalized_inputs = Vec::with_capacity(inputs.len());
+        for (input, &operand) in inputs.iter().zip(&call.operands) {
+            let expected = &self.values[operand.get() as usize];
+            if input.schema() != &expected.schema {
+                return Err(bad());
+            }
+            let SchemaBody::Matrix { dimensions, .. } = input.schema().body() else {
+                return Err(bad());
+            };
+            extents.push([
+                input
+                    .shape()
+                    .resolve_dimension(&dimensions[0])
+                    .map_err(|_| bad())?,
+                input
+                    .shape()
+                    .resolve_dimension(&dimensions[1])
+                    .map_err(|_| bad())?,
+            ]);
+            normalized_inputs.push(
+                ResolvedValueDescriptor::from_schema(
+                    expected.schema.clone(),
+                    input.shape().clone(),
+                )
+                .map_err(|_| bad())?,
+            );
+        }
+        let bounds = self.call_bounds(ordinal, &extents)?;
+        let output_type = &self.values[call.output.get() as usize];
+        let shape = mech_core::shape_for_resolved_extents(
+            &output_type.schema,
+            &[bounds.rows, bounds.columns],
+        )
+        .map_err(|_| bad())?;
+        let output = ResolvedValueDescriptor::from_schema(output_type.schema.clone(), shape)
+            .map_err(|_| bad())?;
+        let operation = ResolvedOperationDescriptor::from_resolved_contract(
+            format!(
+                "{}/{}",
+                call.template.selected_key().module_path.join("/"),
+                call.template.selected_key().operation_name
+            ),
+            call.template.contract(),
+        )
+        .map_err(|_| bad())?;
+        let bound = BoundCall::artifact_operation_for_target(
+            operation,
+            normalized_inputs.into(),
+            Box::new([output]),
+            call.template.selected_key().clone(),
+            ExecutionTarget::Native,
+        )
+        .map_err(|_| bad())?;
+        let target = TargetMemoryProfile::current_native_host().map_err(|_| bad())?;
+        let lifetime = MemoryLifetime::Turn {
+            first: MemoryPlanPoint::new(0),
+            last: MemoryPlanPoint::new(1),
+        };
+        let storage = mech_core::physical_storage_descriptor(
+            FunctionValueRepresentation::Matrix {
+                element: FunctionMatrixElement::F64,
+                storage: FunctionMatrixStoragePattern::Exact(FunctionMatrixRepresentation::MatrixD),
+            },
+            &target,
+            lifetime,
+        );
+        let input_storage = vec![storage.clone(); inputs.len()];
+        let footprint = |descriptor: &ResolvedValueDescriptor| -> Result<MemoryFootprintWitness, NativeMatrixPlanError> {
+            let SchemaBody::Matrix { dimensions, .. } = descriptor.schema().body() else {
+                return Err(bad());
+            };
+            Ok(MemoryFootprintWitness::Known(CurrentMemoryFootprint {
+                logical_elements: mul(
+                    descriptor.shape().resolve_dimension(&dimensions[0]).map_err(|_| bad())?,
+                    descriptor.shape().resolve_dimension(&dimensions[1]).map_err(|_| bad())?,
+                )?,
+                shape_parameter_count: descriptor.shape().parameter_values().len() as u64,
+                ..CurrentMemoryFootprint::default()
+            }))
+        };
+        let input_witnesses = bound
+            .inputs()
+            .iter()
+            .map(footprint)
+            .collect::<Result<Vec<_>, _>>()?;
+        let output_witnesses = [footprint(&bound.outputs()[0])?];
+        mech_core::plan_call_memory(CallMemoryPlanningRequest {
+            bound_call: &bound,
+            input_storage: &input_storage,
+            output_storage: &[storage],
+            input_witnesses: &input_witnesses,
+            output_witnesses: &output_witnesses,
+            published_output_witnesses: &output_witnesses,
+            implementation_memory: call.template.implementation_memory(),
+            target: &target,
+            regions: &[RegionAccessPlan::WholeValue],
+        })
+        .map_err(|_| bad())
+    }
+}
