--- /dev/null
+++ b/src/engine/src/native_matrix_leaf.rs
@@ -0,0 +1,142 @@
+//! Allocation-free maintained dense F64 algorithms shared by resident wrappers
+//! and certified native library calls. These are Rust implementation leaves,
+//! not new source-language operations or a program executor. Callers own work
+//! and storage admission before entering either loop.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum NativeMatrixLeafError {
+    InvalidShape,
+}
+fn product(a: usize, b: usize) -> Result<usize, NativeMatrixLeafError> {
+    a.checked_mul(b).ok_or(NativeMatrixLeafError::InvalidShape)
+}
+/// Exact column-major transpose; copying never performs floating arithmetic.
+pub fn transpose_f64(
+    input: &[f64],
+    output: &mut [f64],
+    rows: usize,
+    columns: usize,
+) -> Result<bool, NativeMatrixLeafError> {
+    let count = product(rows, columns)?;
+    if input.len() != count || output.len() != count {
+        return Err(NativeMatrixLeafError::InvalidShape);
+    }
+    let mut changed = false;
+    for (index, target) in output.iter_mut().enumerate() {
+        // A nonempty result proves columns>0. Zero extents never divide or
+        // dereference; geometry is still retained by the caller's descriptor.
+        let output_row = index % columns;
+        let output_column = index / columns;
+        let next = input[output_column + output_row * rows];
+        changed |= target.to_bits() != next.to_bits();
+        *target = next;
+    }
+    Ok(changed)
+}
+/// Preserve the selected resident association exactly: each column-major
+/// output uses ascending-inner iterator multiplication and Sum<f64>, including
+/// its -0 empty-inner result. No reassociation, FMA or fast-math substitute.
+pub fn matmul_f64(
+    lhs: &[f64],
+    rhs: &[f64],
+    output: &mut [f64],
+    rows: usize,
+    inner: usize,
+    columns: usize,
+) -> Result<bool, NativeMatrixLeafError> {
+    if lhs.len() != product(rows, inner)?
+        || rhs.len() != product(inner, columns)?
+        || output.len() != product(rows, columns)?
+    {
+        return Err(NativeMatrixLeafError::InvalidShape);
+    }
+    let mut changed = false;
+    for (index, target) in output.iter_mut().enumerate() {
+        // A nonempty result proves rows>0; every multiply index is bounded by
+        // the checked exact source extents above.
+        let row = index % rows;
+        let column = index / rows;
+        let next = (0..inner)
+            .map(|offset| lhs[row + offset * rows] * rhs[offset + column * inner])
+            .sum::<f64>();
+        changed |= target.to_bits() != next.to_bits();
+        *target = next;
+    }
+    Ok(changed)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn transpose_preserves_column_major_order_and_every_ieee_bit() {
+        let bits = [
+            (-0.0_f64).to_bits(),
+            0x7ff8_0000_0000_0042,
+            f64::INFINITY.to_bits(),
+            1.0_f64.to_bits(),
+            1,
+            f64::NEG_INFINITY.to_bits(),
+        ];
+        let input = bits.map(f64::from_bits);
+        let mut output = [0.0; 6];
+        assert!(transpose_f64(&input, &mut output, 2, 3).unwrap());
+        assert_eq!(
+            output.map(f64::to_bits),
+            [bits[0], bits[2], bits[4], bits[1], bits[3], bits[5]]
+        );
+        // A NaN bit pattern is equal for the maintained change contract;
+        // numeric != would incorrectly report changed forever here.
+        assert!(!transpose_f64(&input, &mut output, 2, 3).unwrap());
+        assert_eq!(input.map(f64::to_bits), bits);
+    }
+
+    #[test]
+    fn product_preserves_selected_column_major_algorithm_and_inner_association() {
+        let lhs = [1., 4., 2., 5., 3., 6.];
+        let rhs = [7., 9., 11., 8., 10., 12.];
+        let mut output = [0.; 4];
+        assert!(matmul_f64(&lhs, &rhs, &mut output, 2, 3, 2).unwrap());
+        assert_eq!(output, [58., 139., 64., 154.]);
+        assert!(!matmul_f64(&lhs, &rhs, &mut output, 2, 3, 2).unwrap());
+        let mut scalar = [0.];
+        matmul_f64(&[1e16, -1e16, 1.], &[1., 1., 1.], &mut scalar, 1, 3, 1).unwrap();
+        assert_eq!(scalar, [1.]);
+    }
+
+    #[test]
+    fn empty_inner_retains_the_pinned_sum_negative_zero_identity() {
+        let mut output = [0.; 6];
+        assert!(matmul_f64(&[], &[], &mut output, 2, 0, 3).unwrap());
+        assert_eq!(output.map(f64::to_bits), [(-0.0_f64).to_bits(); 6]);
+        assert!(!matmul_f64(&[], &[], &mut output, 2, 0, 3).unwrap());
+        assert!(!matmul_f64(&[], &[0.; 12], &mut [], 0, 3, 4).unwrap());
+        assert!(!transpose_f64(&[], &mut [], 0, 3).unwrap());
+        assert!(!transpose_f64(&[], &mut [], 3, 0).unwrap());
+    }
+
+    #[test]
+    fn every_fallible_geometry_check_precedes_any_output_write() {
+        let sentinel = f64::from_bits(0x7ff8_0000_0000_00b1);
+        let mut output = [sentinel, -0.0];
+        let before = output.map(f64::to_bits);
+        assert_eq!(
+            transpose_f64(&[1., 2.], &mut output, 2, 2),
+            Err(NativeMatrixLeafError::InvalidShape)
+        );
+        assert_eq!(output.map(f64::to_bits), before);
+        assert_eq!(
+            matmul_f64(&[1., 2.], &[1., 2.], &mut output, 1, 2, 1),
+            Err(NativeMatrixLeafError::InvalidShape)
+        );
+        assert_eq!(output.map(f64::to_bits), before);
+        assert_eq!(
+            matmul_f64(&[], &[], &mut output, usize::MAX, 2, 1),
+            Err(NativeMatrixLeafError::InvalidShape)
+        );
+        assert_eq!(output.map(f64::to_bits), before);
+        // The same destination is usable after rejection.
+        assert!(transpose_f64(&[2., 3.], &mut output, 2, 1).unwrap());
+        assert_eq!(output, [2., 3.]);
+    }
+}
