+#[test]
+#[ignore = "internal worker; complete generation/build subtree is parent-owned"]
+fn canonical_matrix_link_build_worker() {
+    let name = std::env::var("MECH_CANONICAL_MATRIX_WORKER_NAME").unwrap();
+    assert!(matches!(
+        name.as_str(),
