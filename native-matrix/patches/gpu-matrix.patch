+//! Deterministic versioned matrix IR identity. Debug/serde text is not hashed.
+use super::abi::{MATRIX_ABI_VERSION, NativeMatrixDescriptor};
+use mech_core::ImplementationMemoryClass;
+use mech_engine::native_artifact::{
+    NativeMatrixArtifactPlan, NativeMatrixPlanningDemand, NativeMatrixPrimitive,
+};
+use sha2::{Digest, Sha256};
+pub const MATRIX_IDENTITY_BYTES: usize = 160;
+pub const MATRIX_TYPED_IR_VERSION: u64 = 1;
+pub const MATRIX_WORK_POLICY_VERSION: u64 = 1;
+const MAGIC: &[u8; 16] = b"MECHMATRIXOBJv1\0";
+
+#[derive(Clone, Debug)]
+pub struct NativeMatrixObjectIdentity {
+    bytes: [u8; MATRIX_IDENTITY_BYTES],
+    symbol: String,
+}
+fn word(h: &mut Sha256, value: u64) {
+    h.update(value.to_le_bytes());
+}
+fn bytes(h: &mut Sha256, value: &[u8]) {
+    word(h, value.len() as u64);
+    h.update(value);
+}
+fn demand(h: &mut Sha256, value: NativeMatrixPlanningDemand) {
+    word(h, value.work);
+    word(h, value.temporary_bytes);
+    word(h, value.retained_nodes);
+}
+fn memory(h: &mut Sha256, class: ImplementationMemoryClass) {
+    match class {
+        ImplementationMemoryClass::NoAdditionalScratch => word(h, 0),
+        ImplementationMemoryClass::CloneInput { input } => {
+            word(h, 1);
+            word(h, input as u64);
+        }
+        ImplementationMemoryClass::CanonicalCloneInput { input } => {
+            word(h, 2);
+            word(h, input as u64);
+        }
+        ImplementationMemoryClass::AbiContiguousBridge { input, output } => {
+            word(h, 3);
+            word(h, input as u64);
+            word(h, output as u64);
+        }
+        ImplementationMemoryClass::ExternalMarshalling => word(h, 4),
+        ImplementationMemoryClass::MatrixSolve => word(h, 5),
+        ImplementationMemoryClass::CanonicalFinalize => word(h, 6),
+        ImplementationMemoryClass::CanonicalSortUnique => word(h, 7),
+    }
+}
+pub(super) fn typed_ir_sha256(plan: &NativeMatrixArtifactPlan) -> [u8; 32] {
+    let mut h = Sha256::new();
+    h.update(b"mech.canonical-native-matrix-typed-ir\0");
+    word(&mut h, MATRIX_TYPED_IR_VERSION);
+    word(&mut h, MATRIX_ABI_VERSION);
+    word(&mut h, MATRIX_WORK_POLICY_VERSION);
+    h.update(plan.program_revision().as_bytes());
+    demand(&mut h, plan.setup_demand());
+    word(&mut h, plan.values().len() as u64);
+    for ty in plan.values() {
+        word(&mut h, ty.schema_id().get() as u64);
+        h.update(ty.schema_key().as_bytes());
+        demand(&mut h, ty.planning_demand());
+    }
+    word(&mut h, plan.inputs().len() as u64);
+    for input in plan.inputs() {
+        word(&mut h, input.input().get() as u64);
+        word(&mut h, input.slot().get() as u64);
+        bytes(&mut h, input.name().as_bytes());
+        word(&mut h, input.value().get() as u64);
+    }
+    word(&mut h, plan.constants().len() as u64);
+    for constant in plan.constants() {
+        word(&mut h, constant.constant().get() as u64);
+        word(&mut h, constant.value().get() as u64);
+        // Private plan construction obtained this genuine finalized constant
+        // from the validated artifact and exact schema identity.
+        let encoded = constant
+            .canonical()
+            .canonical_snapshot_bytes(plan.schemas())
+            .expect("sealed matrix constant retains exact canonical schema");
+        bytes(&mut h, &encoded);
+    }
+    word(&mut h, plan.calls().len() as u64);
+    for call in plan.calls() {
+        word(&mut h, call.template().node().get() as u64);
+        word(&mut h, call.template().target().get() as u64);
+        word(
+            &mut h,
+            match call.template().primitive() {
+                NativeMatrixPrimitive::TransposeF64 => 1,
+                NativeMatrixPrimitive::MatmulF64 => 2,
+            },
+        );
+        word(&mut h, call.operands().len() as u64);
+        for operand in call.operands() {
+            word(&mut h, operand.get() as u64);
+        }
+        word(&mut h, call.output().get() as u64);
+        demand(&mut h, call.planning_demand());
+        memory(&mut h, call.template().implementation_memory());
+        let selected = call.template().selected_key();
+        word(&mut h, selected.module_path.len() as u64);
+        for part in &selected.module_path {
+            bytes(&mut h, part.as_bytes());
+        }
+        bytes(&mut h, selected.operation_name.as_bytes());
+    }
+    word(&mut h, plan.outputs().len() as u64);
+    for output in plan.outputs() {
+        word(&mut h, output.output().get() as u64);
+        word(&mut h, output.slot().get() as u64);
+        bytes(&mut h, output.name().as_bytes());
+        word(&mut h, output.value().get() as u64);
+    }
+    h.finalize().into()
+}
+impl NativeMatrixObjectIdentity {
+    #[cfg(feature = "canonical-native")]
+    pub(super) fn from_descriptor(d: &NativeMatrixDescriptor) -> Option<Self> {
+        let mut result = [0; MATRIX_IDENTITY_BYTES];
+        result[..16].copy_from_slice(MAGIC);
+        let fields = [
+            (16, MATRIX_TYPED_IR_VERSION),
+            (24, MATRIX_ABI_VERSION),
+            (32, MATRIX_WORK_POLICY_VERSION),
+            (112, d.stack_bytes()),
+            (120, d.code_bytes()),
+            (128, d.plan().inputs().len() as u64),
+            (136, d.plan().calls().len() as u64),
+            (144, d.plan().outputs().len() as u64),
+            (152, d.plan().values().len() as u64),
+        ];
+        for (offset, value) in fields {
+            result[offset..offset + 8].copy_from_slice(&value.to_le_bytes());
+        }
+        result[40..72].copy_from_slice(d.plan().program_revision().as_bytes());
+        result[72..104].copy_from_slice(d.typed_ir_sha256());
+        result[104..112].copy_from_slice(&super::super::identity::host_target_tag()?);
+        Some(Self {
+            bytes: result,
+            symbol: format!(
+                "mech_canonical_matrix_identity_v1_{}",
+                hex(d.typed_ir_sha256())
+            ),
+        })
+    }
+    pub fn bytes(&self) -> &[u8; MATRIX_IDENTITY_BYTES] {
+        &self.bytes
+    }
+    pub fn symbol(&self) -> &str {
+        &self.symbol
+    }
+}
+fn get(data: &[u8], offset: usize) -> u64 {
+    u64::from_le_bytes(
+        data[offset..offset + 8]
+            .try_into()
+            .expect("fixed matrix identity field"),
+    )
+}
+pub(super) fn bind(
+    plan: &NativeMatrixArtifactPlan,
+    identity: &[u8; MATRIX_IDENTITY_BYTES],
+) -> Result<NativeMatrixDescriptor, &'static str> {
+    if &identity[..16] != MAGIC
+        || get(identity, 16) != MATRIX_TYPED_IR_VERSION
+        || get(identity, 24) != MATRIX_ABI_VERSION
+        || get(identity, 32) != MATRIX_WORK_POLICY_VERSION
+    {
+        return Err("unsupported matrix identity/ABI/work-policy version");
+    }
+    if identity[104..112]
+        != super::super::identity::host_target_tag().ok_or("unsupported matrix host")?
+    {
+        return Err("matrix object target differs");
+    }
+    if identity[40..72] != plan.program_revision().as_bytes()[..]
+        || get(identity, 128) != plan.inputs().len() as u64
+        || get(identity, 136) != plan.calls().len() as u64
+        || get(identity, 144) != plan.outputs().len() as u64
+        || get(identity, 152) != plan.values().len() as u64
+    {
+        return Err("matrix object canonical revision/counts differ");
+    }
+    if get(identity, 112) == 0 || get(identity, 120) == 0 {
+        return Err("matrix object lacks checked stack/code metadata");
+    }
+    let descriptor = NativeMatrixDescriptor::new(plan, get(identity, 112), get(identity, 120));
+    if identity[72..104] != descriptor.typed_ir_sha256()[..] {
+        return Err("matrix object typed IR differs");
+    }
+    Ok(descriptor)
+}
+#[cfg(feature = "canonical-native")]
+pub(super) fn hex(data: &[u8]) -> String {
+    data.iter().map(|b| format!("{b:02x}")).collect()
+}
