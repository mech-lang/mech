+//! Actual compact column-major backing, distinct from the selected call plan's
+//! possibly padded/capacity-reserved NativeHost layouts and workspace.
+use super::runtime::NativeMatrixExecutionError as Error;
+use mech_core::{
+    AllocationPlan, AllocationRole, ArenaBackingKind, ArenaPlacement, ArenaPlan, FloatWidth,
+    ManagedMemoryBudget, ManagedMemoryReservation, MemoryArenaId, MemoryBudgetLimits, MemoryDomain,
+    MemoryLifetime, MemoryObjectId, MemoryObjectOwner, MemorySpace, PlannedArenaProjection,
+    PlannedSlotKind, PortDirection, ResourceDemand, RuntimePlanView, ScalarMemoryKind,
+};
+
+pub(super) struct MatrixStorage {
+    values: PlannedArenaProjection<f64>,
+    _domain: MemoryDomain,
+    _headers: ManagedMemoryReservation,
+    budget: ManagedMemoryBudget,
+    bytes: u64,
+}
+impl MatrixStorage {
+    /// Caller funds zero-initialization and compact import/leaf work first.
+    pub(super) fn new(count: usize, budget: &ManagedMemoryBudget) -> Result<Self, Error> {
+        let bytes = u64::try_from(count)
+            .ok()
+            .and_then(|n| n.checked_mul(8))
+            .ok_or(Error::Descriptor("matrix backing overflow"))?;
+        // Domain/projection/Rc headers, allocation/arena lists and realization
+        // bookkeeping are held under a separate conservative metadata claim.
+        let headers = budget.reserve_capacity(Self::header_bytes())?;
+        let domain = MemoryDomain::with_memory_budget(budget.clone())?;
+        if count == 0 {
+            return Ok(Self {
+                values: PlannedArenaProjection::empty()?,
+                _domain: domain,
+                _headers: headers,
+                budget: budget.clone(),
+                bytes,
+            });
+        }
+        let revision = domain.issue_plan_revision()?;
+        let arena = MemoryArenaId::new(0);
+        let object = MemoryObjectId::new(0);
+        let allocation = [AllocationPlan {
+            id: object,
+            owner: MemoryObjectOwner::DirectCallPort {
+                call: 0,
+                direction: PortDirection::Output,
+                port: 0,
+            },
+            role: AllocationRole::FixedStorage,
+            slot: Some(PlannedSlotKind::FixedScalar(ScalarMemoryKind::Floating(
+                FloatWidth::W64,
+            ))),
+            space: MemorySpace::Host,
+            current_bytes: bytes,
+            capacity_bytes: bytes,
+            payload_block_capacity: 0,
+            alignment: core::mem::align_of::<f64>() as u32,
+            lifetime: MemoryLifetime::Program,
+            placement: ArenaPlacement { arena, offset: 0 },
+            reuse_group: None,
+        }];
+        let arenas = [ArenaPlan {
+            id: arena,
+            space: MemorySpace::Host,
+            backing: ArenaBackingKind::ContiguousBytes,
+            alignment: 8,
+            capacity_bytes: bytes,
+            members: Box::new([object]),
+        }];
+        let reservation = domain.prepare_realization(RuntimePlanView::for_aggregate(
+            revision,
+            &allocation,
+            &arenas,
+            ResourceDemand {
+                persistent_bytes: bytes,
+                turn_peak_bytes: bytes,
+                ..ResourceDemand::default()
+            },
+            MemoryBudgetLimits {
+                max_temporary_bytes: Some(bytes),
+                max_storage_buffer_bytes: Some(bytes),
+                ..MemoryBudgetLimits::default()
+            },
+            &[],
+            1,
+            &[],
+        ))?;
+        let realized = domain.materialize(reservation)?;
+        let values = domain.project_host_arena::<f64>(&realized, arena, count)?;
+        Ok(Self {
+            values,
+            _domain: domain,
+            _headers: headers,
+            budget: budget.clone(),
+            bytes,
+        })
+    }
+    pub(super) const fn header_bytes() -> u64 {
+        // Finite private realization metadata, no schema/payload in this bound.
+        64 * (core::mem::size_of::<MatrixStorage>()
+            + core::mem::size_of::<AllocationPlan>()
+            + core::mem::size_of::<ArenaPlan>()) as u64
+    }
+    pub(super) fn values(&self) -> &[f64] {
+        &self.values
+    }
+    pub(super) fn values_mut(&mut self) -> &mut [f64] {
+        &mut self.values
+    }
+    pub(super) fn budget(&self) -> &ManagedMemoryBudget {
+        &self.budget
+    }
+    pub(super) fn retained_bytes(&self) -> Result<u64, Error> {
+        self.bytes
+            .checked_add(Self::header_bytes())
+            .ok_or(Error::Descriptor("matrix retained backing overflow"))
+    }
+}
