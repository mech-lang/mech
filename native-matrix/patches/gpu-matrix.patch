+use core::ffi::c_void;
+use mech_engine::native_artifact::NativeMatrixArtifactPlan;
+
+pub const MATRIX_ABI_VERSION: u64 = 4;
+pub const MATRIX_ENTRY_SYMBOL: &str = "mech_canonical_matrix_entry_v1";
+pub(super) const OK: u64 = 0;
+pub(super) const ERROR: u64 = 1;
+pub(super) const BAD_ABI: u64 = 2;
+
+/// Constructed only at checked emission or unsafe same-object binding.
+/// The immutable plan is copied once outside evaluation, never per call.
+#[derive(Clone, Debug)]
+pub struct NativeMatrixDescriptor {
+    pub(super) plan: NativeMatrixArtifactPlan,
+    pub(super) stack: u64,
+    pub(super) code: u64,
+    pub(super) ir: [u8; 32],
+}
+impl NativeMatrixDescriptor {
+    pub fn plan(&self) -> &NativeMatrixArtifactPlan {
+        &self.plan
+    }
+    pub const fn stack_bytes(&self) -> u64 {
+        self.stack
+    }
+    pub const fn code_bytes(&self) -> u64 {
+        self.code
+    }
+    pub const fn typed_ir_sha256(&self) -> &[u8; 32] {
+        &self.ir
+    }
+    pub(super) fn new(plan: &NativeMatrixArtifactPlan, stack: u64, code: u64) -> Self {
+        Self {
+            plan: plan.clone(),
+            stack,
+            code,
+            ir: super::identity::typed_ir_sha256(plan),
+        }
+    }
+}
+/// Synchronous private ABI. No matrix payload or Rust container representation
+/// crosses generated code. The safe evaluator installs the exact two specific
+/// leaf shims and the completion callback; callers cannot supply callbacks.
+#[repr(C)]
+pub(super) struct MatrixFrame {
+    pub version: u64,
+    pub inputs: u64,
+    pub calls: u64,
+    pub outputs: u64,
+    pub context: *mut c_void,
+    pub transpose: unsafe extern "C" fn(*mut c_void, u64) -> u64,
+    pub matmul: unsafe extern "C" fn(*mut c_void, u64) -> u64,
+    pub complete: unsafe extern "C" fn(*mut c_void, u64) -> u64,
+}
+#[cfg(feature = "canonical-native")]
+pub(super) type RawMatrixEntry = unsafe extern "C" fn(*mut MatrixFrame) -> u64;
