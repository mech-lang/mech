+        }
+        assert_eq!(
+            owner_body(&mut context, Phase::Setup, &deep, 0),
+            Err(Error::Descriptor(
+                "borrowed matrix schema owner exceeds bounded metadata depth"
+            ))
+        );
+        assert_eq!(context.work, 33 * 64);
+        context.work = 0;
