+use super::identity::MATRIX_IDENTITY_BYTES;
+use super::{
+    NativeMatrixDescriptor, NativeMatrixExecutionError, NativeMatrixExecutionLimits,
+    NativeMatrixExecutionReport, NativeMatrixValue,
+};
+use core::ffi::c_void;
+use mech_core::{ManagedMemoryBudget, Value};
+use mech_engine::native_artifact::NativeMatrixArtifactPlan;
+
+pub struct LinkedMatrixArtifact {
+    entry: unsafe extern "C" fn(*mut c_void) -> u64,
+    descriptor: NativeMatrixDescriptor,
+}
+impl LinkedMatrixArtifact {
+    /// Binds the actual selected canonical plan, outside evaluation.
+    ///
+    /// # Safety
+    /// Entry and identity MUST originate from the same unchanged Object made
+    /// by this crate's checked shared matrix emitter, with verified object,
+    /// bytecode and generated-source build pins. Identity bytes alone do not
+    /// establish this invariant. Entry obeys the synchronous private ABI4,
+    /// invokes only its frame's exact leaf callbacks in emitted order, retains
+    /// no pointers, and cannot unwind or access unadmitted data. Arbitrary
+    /// foreign code or a fabricated matching record is unsound.
+    pub unsafe fn from_build_owned_entry(
+        plan: &NativeMatrixArtifactPlan,
+        identity: &'static [u8; MATRIX_IDENTITY_BYTES],
+        entry: unsafe extern "C" fn(*mut c_void) -> u64,
+    ) -> Result<Self, &'static str> {
+        Ok(Self {
+            entry,
+            descriptor: super::identity::bind(plan, identity)?,
+        })
+    }
+    pub fn descriptor(&self) -> &NativeMatrixDescriptor {
+        &self.descriptor
+    }
+    /// Real managed admission and atomic typed publication, identical to JIT.
+    /// The explicit account bounds all backing and conservative workspace.
+    pub fn evaluate_into(
+        &self,
+        inputs: &[Value],
+        outputs: &mut [Option<NativeMatrixValue>],
+        limits: NativeMatrixExecutionLimits,
+        budget: &ManagedMemoryBudget,
+    ) -> Result<NativeMatrixExecutionReport, NativeMatrixExecutionError> {
+        super::runtime::execute(
+            &self.descriptor,
+            |frame| {
+                // SAFETY: established by the explicit build-owned constructor.
+                unsafe { (self.entry)(frame.cast()) }
+            },
+            inputs,
+            outputs,
+            limits,
+            budget,
+        )
+    }
+}
