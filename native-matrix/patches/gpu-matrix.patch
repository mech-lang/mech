+//! One checked static leaf-call definition for both JIT and Object modules.
+use super::super::{NativeCompileError, NativeCompileLimits};
+use super::{
+    abi::{
+        BAD_ABI, ERROR, MATRIX_ABI_VERSION, MATRIX_ENTRY_SYMBOL, MatrixFrame,
+        NativeMatrixDescriptor, OK, RawMatrixEntry,
+    },
+    identity::NativeMatrixObjectIdentity,
+    runtime::{
+        NativeMatrixExecutionError, NativeMatrixExecutionLimits, NativeMatrixExecutionReport,
+        NativeMatrixValue,
+    },
+};
+use cranelift_codegen::{
+    ir::{AbiParam, InstBuilder, MemFlags, Value, condcodes::IntCC, types},
+    isa::unwind::UnwindInst,
+    settings::{self, Configurable},
+};
+use cranelift_frontend::{FunctionBuilder, FunctionBuilderContext};
+use cranelift_module::{DataDescription, FuncId, Linkage, Module, default_libcall_names};
+use cranelift_object::{ObjectBuilder, ObjectModule};
+use mech_core::{ManagedMemoryBudget, Value as CanonicalValue};
+use mech_engine::native_artifact::{NativeMatrixArtifactPlan, NativeMatrixPrimitive};
+fn backend(e: impl std::fmt::Display) -> NativeCompileError {
+    NativeCompileError::Backend(e.to_string())
+}
+fn limit(dimension: &'static str, required: u64, maximum: u64) -> Result<(), NativeCompileError> {
+    if required > maximum {
+        Err(NativeCompileError::Limit {
+            dimension,
+            required,
+            limit: maximum,
+        })
+    } else {
+        Ok(())
+    }
+}
+fn host() -> Result<(), NativeCompileError> {
+    if super::super::identity::host_target_tag().is_none() {
+        Err(NativeCompileError::UnsupportedHost)
+    } else {
+        Ok(())
+    }
+}
+pub struct JitMatrixArtifact {
+    _module: cranelift_jit::JITModule,
+    entry: RawMatrixEntry,
+    descriptor: NativeMatrixDescriptor,
+}
+impl JitMatrixArtifact {
+    pub fn compile(plan: &NativeMatrixArtifactPlan) -> Result<Self, NativeCompileError> {
+        Self::compile_with_limits(plan, NativeCompileLimits::default())
+    }
+    pub fn compile_with_limits(
+        plan: &NativeMatrixArtifactPlan,
+        limits: NativeCompileLimits,
+    ) -> Result<Self, NativeCompileError> {
+        host()?;
+        let builder = cranelift_jit::JITBuilder::with_flags(
+            &[
+                ("opt_level", "none"),
+                ("is_pic", "true"),
+                ("preserve_frame_pointers", "true"),
+                ("unwind_info", "true"),
+            ],
+            default_libcall_names(),
+        )
+        .map_err(backend)?;
+        let mut module = cranelift_jit::JITModule::new(builder);
+        let (id, descriptor) = define(plan, &mut module, limits)?;
+        module.finalize_definitions().map_err(backend)?;
+        // SAFETY: shared define emits this private ABI4 and module owns code.
+        let entry = unsafe {
+            std::mem::transmute::<*const u8, RawMatrixEntry>(module.get_finalized_function(id))
+        };
+        Ok(Self {
+            _module: module,
+            entry,
+            descriptor,
+        })
+    }
+    pub fn descriptor(&self) -> &NativeMatrixDescriptor {
+        &self.descriptor
+    }
+    pub fn evaluate_into(
+        &self,
+        inputs: &[CanonicalValue],
+        outputs: &mut [Option<NativeMatrixValue>],
+        limits: NativeMatrixExecutionLimits,
+        budget: &ManagedMemoryBudget,
+    ) -> Result<NativeMatrixExecutionReport, NativeMatrixExecutionError> {
+        super::runtime::execute(
+            &self.descriptor,
+            |frame| {
+                // SAFETY: module retains the exact shared-definition code.
+                unsafe { (self.entry)(frame) }
+            },
+            inputs,
+            outputs,
+            limits,
+            budget,
+        )
+    }
+}
+/// Emission evidence only. Actual linked execution is separately qualified.
+pub struct NativeMatrixObject {
+    bytes: Vec<u8>,
+    descriptor: NativeMatrixDescriptor,
+    identity: NativeMatrixObjectIdentity,
+}
+impl NativeMatrixObject {
+    pub fn bytes(&self) -> &[u8] {
+        &self.bytes
+    }
+    pub fn descriptor(&self) -> &NativeMatrixDescriptor {
+        &self.descriptor
+    }
+    pub fn identity(&self) -> &NativeMatrixObjectIdentity {
+        &self.identity
+    }
+    pub fn metadata(&self) -> serde_json::Value {
+        serde_json::json!({"schema":"mech.canonical-native-matrix-object.v1","abi":MATRIX_ABI_VERSION,"entry":MATRIX_ENTRY_SYMBOL,"typed_ir_sha256":super::identity::hex(self.descriptor.typed_ir_sha256()),"program_revision":super::identity::hex(self.descriptor.plan().program_revision().as_bytes()),"stack_bytes":self.descriptor.stack_bytes(),"code_bytes":self.descriptor.code_bytes(),"object_bytes":self.bytes.len(),"nodes":self.descriptor.plan().calls().len(),"linked":false,"executed":false,"timing_samples":0})
+    }
+}
+pub fn emit_matrix_object(
+    plan: &NativeMatrixArtifactPlan,
+) -> Result<NativeMatrixObject, NativeCompileError> {
+    emit_matrix_object_with_limits(plan, NativeCompileLimits::default())
+}
+pub fn emit_matrix_object_with_limits(
+    plan: &NativeMatrixArtifactPlan,
+    limits: NativeCompileLimits,
+) -> Result<NativeMatrixObject, NativeCompileError> {
+    host()?;
+    let mut flags = settings::builder();
+    for (name, value) in [
+        ("opt_level", "none"),
+        ("is_pic", "true"),
+        ("preserve_frame_pointers", "true"),
+        ("unwind_info", "true"),
+    ] {
+        flags.set(name, value).map_err(backend)?;
+    }
+    let isa = cranelift_native::builder()
+        .map_err(backend)?
+        .finish(settings::Flags::new(flags))
+        .map_err(backend)?;
+    let mut module = ObjectModule::new(
+        ObjectBuilder::new(isa, "mech_canonical_matrix", default_libcall_names())
+            .map_err(backend)?,
+    );
+    let (_, descriptor) = define(plan, &mut module, limits)?;
+    let identity = NativeMatrixObjectIdentity::from_descriptor(&descriptor)
+        .ok_or(NativeCompileError::UnsupportedHost)?;
+    let id = module
+        .declare_data(identity.symbol(), Linkage::Export, false, false)
+        .map_err(backend)?;
+    let mut data = DataDescription::new();
+    data.define(identity.bytes().to_vec().into_boxed_slice());
+    data.set_align(8);
+    module.define_data(id, &data).map_err(backend)?;
+    Ok(NativeMatrixObject {
+        bytes: module.finish().emit().map_err(backend)?,
+        descriptor,
+        identity,
+    })
+}
+fn guard(
+    b: &mut FunctionBuilder<'_>,
+    valid: Value,
+    error: cranelift_codegen::ir::Block,
+    status: u64,
+) {
+    let good = b.create_block();
+    let status = b.ins().iconst(types::I64, status as i64);
+    b.ins().brif(valid, good, &[], error, &[status.into()]);
+    b.switch_to_block(good);
+}
+fn load(b: &mut FunctionBuilder<'_>, frame: Value, offset: usize) -> Value {
+    b.ins()
+        .load(types::I64, MemFlags::new(), frame, offset as i32)
+}
+fn callback(
+    b: &mut FunctionBuilder<'_>,
+    frame: Value,
+    context: Value,
+    offset: usize,
+    sig: cranelift_codegen::ir::SigRef,
+    ordinal: usize,
+    error: cranelift_codegen::ir::Block,
+) {
+    let target = load(b, frame, offset);
+    let nonnull = b.ins().icmp_imm(IntCC::NotEqual, target, 0);
+    guard(b, nonnull, error, BAD_ABI);
+    let ordinal = b.ins().iconst(types::I64, ordinal as i64);
+    let call = b.ins().call_indirect(sig, target, &[context, ordinal]);
+    let status = b.inst_results(call)[0];
+    let valid = b.ins().icmp_imm(IntCC::Equal, status, OK as i64);
+    guard(b, valid, error, ERROR);
+}
+fn define<M: Module>(
+    plan: &NativeMatrixArtifactPlan,
+    module: &mut M,
+    limits: NativeCompileLimits,
+) -> Result<(FuncId, NativeMatrixDescriptor), NativeCompileError> {
+    host()?;
+    if module.target_config().pointer_type() != types::I64 {
+        return Err(NativeCompileError::UnsupportedHost);
+    }
+    limit("matrix nodes", plan.calls().len() as u64, limits.max_nodes)?;
+    limit(
+        "matrix inputs",
+        plan.inputs().len() as u64,
+        limits.max_inputs,
+    )?;
+    limit(
+        "matrix outputs",
+        plan.outputs().len() as u64,
+        limits.max_outputs,
+    )?;
+    // Before allocating canonical encodings for identity, bound referenced
+    // immutable payload with the existing finite compile byte allowance.
+    let mut constant_bytes = 0u64;
+    for c in plan.constants() {
+        let mech_core::ValueData::Matrix(matrix) = c.canonical().data() else {
+            return Err(NativeCompileError::InvalidPlan {
+                node: None,
+                reason: "matrix constant has wrong payload",
+            });
+        };
+        let packed = (matrix.elements().len() as u64).checked_mul(8).ok_or(
+            NativeCompileError::InvalidPlan {
+                node: None,
+                reason: "matrix constant byte overflow",
+            },
+        )?;
+        limit(
+            "matrix constant pre-encoding bytes",
+            packed,
+            limits.max_code_bytes,
+        )?;
+        constant_bytes = constant_bytes
+            .checked_add(
+                c.canonical()
+                    .canonical_payload_len(plan.schemas())
+                    .map_err(backend)? as u64,
+            )
+            .ok_or(NativeCompileError::InvalidPlan {
+                node: None,
+                reason: "matrix constant byte overflow",
+            })?;
+    }
+    limit(
+        "matrix constant identity bytes",
+        constant_bytes,
+        limits.max_code_bytes,
+    )?;
+    let mut sig = module.make_signature();
+    sig.params.push(AbiParam::new(types::I64));
+    sig.returns.push(AbiParam::new(types::I64));
+    let id = module
+        .declare_function(MATRIX_ENTRY_SYMBOL, Linkage::Export, &sig)
+        .map_err(backend)?;
+    let mut ctx = module.make_context();
+    ctx.func.signature = sig;
+    let mut helper = module.make_signature();
+    helper
+        .params
+        .extend([AbiParam::new(types::I64), AbiParam::new(types::I64)]);
+    helper.returns.push(AbiParam::new(types::I64));
+    let mut function = FunctionBuilderContext::new();
+    {
+        let mut b = FunctionBuilder::new(&mut ctx.func, &mut function);
+        let entry = b.create_block();
+        let error = b.create_block();
+        b.append_block_param(error, types::I64);
+        b.append_block_params_for_function_params(entry);
+        b.switch_to_block(entry);
+        let frame = b.block_params(entry)[0];
+        let valid = b.ins().icmp_imm(IntCC::NotEqual, frame, 0);
+        guard(&mut b, valid, error, BAD_ABI);
+        for (offset, expected) in [
+            (
+                core::mem::offset_of!(MatrixFrame, version),
+                MATRIX_ABI_VERSION,
+            ),
+            (
+                core::mem::offset_of!(MatrixFrame, inputs),
+                plan.inputs().len() as u64,
+            ),
+            (
+                core::mem::offset_of!(MatrixFrame, calls),
+                plan.calls().len() as u64,
+            ),
+            (
+                core::mem::offset_of!(MatrixFrame, outputs),
+                plan.outputs().len() as u64,
+            ),
+        ] {
+            let value = load(&mut b, frame, offset);
+            let valid = b.ins().icmp_imm(IntCC::Equal, value, expected as i64);
+            guard(&mut b, valid, error, BAD_ABI);
+        }
+        let context = load(&mut b, frame, core::mem::offset_of!(MatrixFrame, context));
+        let nonnull = b.ins().icmp_imm(IntCC::NotEqual, context, 0);
+        guard(&mut b, nonnull, error, BAD_ABI);
+        let callback_sig = b.import_signature(helper);
+        for (ordinal, call) in plan.calls().iter().enumerate() {
+            let before = b.func.dfg.num_insts();
+            let offset = match call.template().primitive() {
+                NativeMatrixPrimitive::TransposeF64 => {
+                    core::mem::offset_of!(MatrixFrame, transpose)
+                }
+                NativeMatrixPrimitive::MatmulF64 => core::mem::offset_of!(MatrixFrame, matmul),
+            };
+            callback(&mut b, frame, context, offset, callback_sig, ordinal, error);
+            // The fixed callback/progress bookkeeping is conservatively128
+            // logical units; explicit checked CLIF + that bound must fit256.
+            let required = b
+                .func
+                .dfg
+                .num_insts()
+                .checked_sub(before)
+                .and_then(|n| n.checked_add(128))
+                .ok_or(NativeCompileError::InvalidPlan {
+                    node: Some(call.template().node()),
+                    reason: "matrix emitted work counter overflow",
+                })?;
+            limit("matrix static callback work", required as u64, 256)?;
+        }
+        callback(
+            &mut b,
+            frame,
+            context,
+            core::mem::offset_of!(MatrixFrame, complete),
+            callback_sig,
+            plan.calls().len(),
+            error,
+        );
+        let success = b.ins().iconst(types::I64, OK as i64);
+        b.ins().return_(&[success]);
+        b.switch_to_block(error);
+        let status = b.block_params(error)[0];
+        b.ins().return_(&[status]);
+        b.seal_all_blocks();
+        b.finalize();
+    }
+    module.define_function(id, &mut ctx).map_err(backend)?;
+    let compiled = ctx
+        .compiled_code()
+        .ok_or(NativeCompileError::StackMetadata {
+            reason: "matrix compiled code missing",
+        })?;
+    let stack = compiled_stack_bytes(&compiled.buffer)?;
+    let code = u64::from(compiled.code_info().total_size);
+    limit("matrix entry stack bytes", stack, limits.max_stack_bytes)?;
+    limit("matrix code bytes", code, limits.max_code_bytes)?;
+    Ok((id, NativeMatrixDescriptor::new(plan, stack, code)))
+}
+
+// Same pinned Cranelift unwind/frame authority as the scalar emitter.
+fn compiled_stack_bytes(
+    buffer: &cranelift_codegen::MachBufferFinalized<cranelift_codegen::Final>,
+) -> Result<u64, NativeCompileError> {
+    let layout = buffer
+        .frame_layout()
+        .ok_or(NativeCompileError::StackMetadata {
+            reason: "fixed frame layout missing",
+        })?;
+    let mut pushes = 0;
+    let mut frames = 0;
+    let mut clobbers = None;
+    let mut fixed_allocation = None;
+    for (_, inst) in &buffer.unwind_info {
+        match inst {
+            UnwindInst::PushFrameRegs {
+                offset_upward_to_caller_sp: 16,
+            } if pushes == 0 && frames == 0 => pushes += 1,
+            UnwindInst::DefineNewFrame {
+                offset_upward_to_caller_sp: 16,
+                offset_downward_to_clobbers,
+            } if pushes == 1 && frames == 0 => {
+                frames += 1;
+                clobbers = Some(*offset_downward_to_clobbers);
+            }
+            // Pinned AArch64 reports its ordinary fixed area explicitly; the
+            // field is already included in frame_to_fp_offset. No tail calls
+            // or dynamic stack allocations are emitted by this definition.
+            UnwindInst::StackAlloc { size }
+                if cfg!(target_arch = "aarch64") && frames == 1 && fixed_allocation.is_none() =>
+            {
+                fixed_allocation = Some(*size);
+            }
+            UnwindInst::PushFrameRegs { .. }
+            | UnwindInst::DefineNewFrame { .. }
+            | UnwindInst::StackAlloc { .. } => {
+                return Err(NativeCompileError::StackMetadata {
+                    reason: "unsupported or repeated frame setup",
+                });
+            }
+            UnwindInst::SaveReg { .. } if frames == 1 => {}
+            UnwindInst::Aarch64SetPointerAuth { .. } if cfg!(target_arch = "aarch64") => {}
+            _ => {
+                return Err(NativeCompileError::StackMetadata {
+                    reason: "unsupported unwind action",
+                });
+            }
+        }
+    }
+    if pushes != 1 || frames != 1 {
+        return Err(NativeCompileError::StackMetadata {
+            reason: "exact preserved native frame setup unavailable",
+        });
+    }
+    let clobbers = clobbers.ok_or(NativeCompileError::StackMetadata {
+        reason: "clobber layout missing",
+    })?;
+    if cfg!(target_arch = "aarch64") {
+        if clobbers.checked_add(fixed_allocation.unwrap_or(0)) != Some(layout.frame_to_fp_offset) {
+            return Err(NativeCompileError::StackMetadata {
+                reason: "fixed AArch64 allocation does not match complete frame",
+            });
+        }
+    } else if fixed_allocation.is_some() || clobbers > layout.frame_to_fp_offset {
+        return Err(NativeCompileError::StackMetadata {
+            reason: "unsupported x86_64 fixed-frame metadata",
+        });
+    }
+    // Pinned Cranelift frame_to_fp_offset includes clobbers, fixed/spill slots
+    // and outgoing arguments (machinst/abi.rs::sp_to_fp_offset). The supported
+    // preserved-FP prologue contributes exactly the separately verified16.
+    Ok(u64::from(layout.frame_to_fp_offset) + 16)
+}
