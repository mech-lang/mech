+//! The same managed evaluator is used by JIT and build-owned linked entries.
+//! Generated code selects exact private leaf callbacks; it never calls a
+//! resident executor or dispatches an operation by public name.
+use super::abi::{BAD_ABI, ERROR, MATRIX_ABI_VERSION, MatrixFrame, NativeMatrixDescriptor, OK};
+use super::memory::MatrixStorage;
+use mech_core::snapshot::SequenceView;
+use mech_core::{
+    CardinalitySpec, DimensionExpr, ManagedMemoryBudget, ManagedMemoryReservation,
+    MemoryRuntimeError, NodeId, ResolvedValueDescriptor, SchemaBody, Value, ValueData,
+};
+use mech_engine::native_artifact::{
+    NativeMatrixArtifactPlan, NativeMatrixPlanningDemand, NativeMatrixPrimitive,
+    NativeMatrixValueId,
+};
+use std::{
+    ffi::c_void,
+    panic::{AssertUnwindSafe, catch_unwind},
+    rc::Rc,
+};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct NativeMatrixExecutionLimits {
+    pub max_work: u64,
+    pub max_retained_nodes: u64,
+    /// Generated entry frame only; not the Rust caller/leaf stack.
+    pub max_native_stack_bytes: u64,
+}
+impl Default for NativeMatrixExecutionLimits {
+    fn default() -> Self {
+        Self {
+            max_work: 16_777_216,
+            max_retained_nodes: 262_144,
+            max_native_stack_bytes: 65_536,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum NativeMatrixExecutionPhase {
+    Setup,
+    Node(NodeId),
+    Completion,
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum NativeMatrixExecutionError {
+    InvalidInputs {
+        expected: usize,
+        actual: usize,
+    },
+    InvalidOutputs {
+        expected: usize,
+        actual: usize,
+    },
+    Input {
+        input: usize,
+        reason: &'static str,
+    },
+    Descriptor(&'static str),
+    Planning {
+        node: NodeId,
+    },
+    Work {
+        phase: NativeMatrixExecutionPhase,
+        required: u64,
+        limit: u64,
+    },
+    Nodes {
+        required: u64,
+        limit: u64,
+    },
+    Stack {
+        required: u64,
+        limit: u64,
+    },
+    Sequence {
+        expected: u64,
+        actual: u64,
+    },
+    Leaf {
+        node: NodeId,
+    },
+    Panic,
+    Status(u64),
+    Memory(MemoryRuntimeError),
+}
+impl From<MemoryRuntimeError> for NativeMatrixExecutionError {
+    fn from(e: MemoryRuntimeError) -> Self {
+        Self::Memory(e)
+    }
+}
+impl std::fmt::Display for NativeMatrixExecutionError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "canonical native matrix execution: {self:?}")
+    }
+}
+impl std::error::Error for NativeMatrixExecutionError {}
+type Error = NativeMatrixExecutionError;
+type Phase = NativeMatrixExecutionPhase;
+fn add(a: u64, b: u64) -> Result<u64, Error> {
+    a.checked_add(b)
+        .ok_or(Error::Descriptor("matrix accounting overflow"))
+}
+fn mul(a: u64, b: u64) -> Result<u64, Error> {
+    a.checked_mul(b)
+        .ok_or(Error::Descriptor("matrix accounting overflow"))
+}
+fn count(n: usize) -> Result<u64, Error> {
+    u64::try_from(n).map_err(|_| Error::Descriptor("matrix count exceeds u64"))
+}
+fn host(n: u64) -> Result<usize, Error> {
+    usize::try_from(n).map_err(|_| Error::Descriptor("matrix extent exceeds host"))
+}
+
+/// An immutable, managed, compact column-major typed result. Construction is
+/// private. No raw buffer/descriptor setter or unchecked deserializer exists.
+#[derive(Clone)]
+pub struct NativeMatrixValue {
+    descriptor: Rc<DescriptorOwner>,
+    extents: [u64; 2],
+    storage: Rc<MatrixStorage>,
+}
+impl NativeMatrixValue {
+    pub fn descriptor(&self) -> &ResolvedValueDescriptor {
+        &self.descriptor.value
+    }
+    pub const fn extents(&self) -> [u64; 2] {
+        self.extents
+    }
+    pub fn column_major_values(&self) -> &[f64] {
+        self.storage.values()
+    }
+}
+struct DescriptorOwner {
+    value: ResolvedValueDescriptor,
+    _claim: ManagedMemoryReservation,
+    bytes: u64,
+}
+impl DescriptorOwner {
+    // Descriptor construction is separately pre-admitted metadata work. This
+    // persistent exact-root claim follows shared output aliases beyond a call.
+    fn new(
+        value: ResolvedValueDescriptor,
+        budget: &ManagedMemoryBudget,
+        sealed_descriptor_bound: u64,
+    ) -> Result<Rc<Self>, Error> {
+        // The sealed type's conservative metadata record bound includes the
+        // complete ResolvedType kind/environment/predicate evidence as well
+        // as Schema and ShapeInstance; schema heap alone is insufficient.
+        let bytes = add(
+            sealed_descriptor_bound,
+            (core::mem::size_of::<Self>() + 64) as u64,
+        )?;
+        let claim = budget.reserve_capacity(bytes)?;
+        Ok(Rc::new(Self {
+            value,
+            _claim: claim,
+            bytes,
+        }))
+    }
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct NativeMatrixExecutionReport {
+    pub work: u64,
+    pub completed_nodes: usize,
+    /// Maximum observed account capacity, including caller-retained results;
+    /// not physical RSS or a timing measurement.
+    pub peak_admitted_account_bytes: u64,
+}
+
+struct LiveValue<'a> {
+    descriptor: Rc<DescriptorOwner>,
+    extents: [u64; 2],
+    source: Option<&'a Value>,
+    storage: Option<Rc<MatrixStorage>>,
+    // The borrowed canonical source remains alive under the invocation's
+    // input lifetime. This finite ticket also accounts its actual retained
+    // payload/schema owner in this evaluator's mandatory memory account.
+    _source_claim: Option<ManagedMemoryReservation>,
+}
+struct Context<'a> {
+    descriptor: &'a NativeMatrixDescriptor,
+    budget: &'a ManagedMemoryBudget,
+    limits: NativeMatrixExecutionLimits,
+    values: Vec<Option<LiveValue<'a>>>,
+    staged: Vec<NativeMatrixValue>,
+    _metadata: ManagedMemoryReservation,
+    _foreign_outputs: ManagedMemoryReservation,
+    work: u64,
+    nodes: u64,
+    next: u64,
+    complete: bool,
+    peak: u64,
+    error: Option<Error>,
+}
+impl<'a> Context<'a> {
+    fn plan(&self) -> &NativeMatrixArtifactPlan {
+        &self.descriptor.plan
+    }
+    fn charge(&mut self, phase: Phase, amount: u64) -> Result<(), Error> {
+        let required = self.work.checked_add(amount).ok_or(Error::Work {
+            phase,
+            required: u64::MAX,
+            limit: self.limits.max_work,
+        })?;
+        if required > self.limits.max_work {
+            return Err(Error::Work {
+                phase,
+                required,
+                limit: self.limits.max_work,
+            });
+        }
+        self.work = required;
+        Ok(())
+    }
+    fn retain_nodes(&mut self, amount: u64) -> Result<(), Error> {
+        let required = add(self.nodes, amount)?;
+        if required > self.limits.max_retained_nodes {
+            return Err(Error::Nodes {
+                required,
+                limit: self.limits.max_retained_nodes,
+            });
+        }
+        self.nodes = required;
+        Ok(())
+    }
+    fn observe_peak(&mut self) {
+        self.peak = self.peak.max(self.budget.used_bytes());
+    }
+    fn metadata(
+        &mut self,
+        phase: Phase,
+        d: NativeMatrixPlanningDemand,
+    ) -> Result<ManagedMemoryReservation, Error> {
+        self.charge(phase, d.work)?;
+        self.retain_nodes(d.retained_nodes)?;
+        let claim = self.budget.reserve_capacity(d.temporary_bytes)?;
+        self.observe_peak();
+        Ok(claim)
+    }
+    fn value(&self, id: NativeMatrixValueId) -> Result<&LiveValue<'a>, Error> {
+        self.values
+            .get(id.get() as usize)
+            .and_then(Option::as_ref)
+            .ok_or(Error::Descriptor("matrix source is unavailable"))
+    }
+    /// Import only when the current ordered node requires this source. A later
+    /// incompatible shape never overtakes earlier checked work/admission.
+    fn import(
+        &mut self,
+        id: NativeMatrixValueId,
+        phase: Phase,
+    ) -> Result<Rc<MatrixStorage>, Error> {
+        let current = self.value(id)?;
+        if let Some(storage) = &current.storage {
+            return Ok(storage.clone());
+        }
+        let source = current
+            .source
+            .ok_or(Error::Descriptor("matrix source has no backing"))?;
+        let extents = current.extents;
+        let elements = mul(extents[0], extents[1])?;
+        // Fund the complete retained schema table's structural walk before
+        // memory_budget_required_bytes. Cached canonical byte lengths bound
+        // schema/parameter syntax nodes; no parameter solver is invoked here.
+        let owner = source
+            .schemas()
+            .ok_or(Error::Descriptor("matrix input lost schema owner"))?;
+        let entries = count(owner.entries().len())?;
+        self.charge(phase, add(256, mul(entries, 128)?)?)?;
+        self.retain_nodes(add(entries, 8)?)?;
+        let mut encoded = 0;
+        for entry in owner.entries() {
+            encoded = add(encoded, count(entry.canonical_bytes().len())?)?;
+        }
+        self.charge(phase, add(mul(encoded, 128)?, mul(elements, 64)?)?)?;
+        // Guard the Rust recursion used by the core owner allocation witness.
+        // Unrelated entries may have richer syntax than this plan's root; a
+        // charged depth-bounded structural walk prevents a deeply nested
+        // foreign owner from exhausting the callback stack. This is a bounded
+        // invocation metadata limit, not a language schema restriction.
+        for entry in owner.entries() {
+            owner_body(self, phase, entry.schema().body(), 0)?;
+            for parameter in entry.schema().dimension_parameters() {
+                owner_dimension(self, phase, parameter.lower_bound(), 0)?;
+                if let Some(upper) = parameter.upper_bound() {
+                    owner_dimension(self, phase, upper, 0)?;
+                }
+            }
+        }
+        // This first bounded slice deliberately accounts the full borrowed
+        // source owner even if the caller also owns a same-account import.
+        // It does not traverse the historical import-registration list or
+        // infer ownership authority from an Arc address.
+        let source_claim = self
+            .budget
+            .reserve_capacity(source.memory_budget_required_bytes()?)?;
+        let mut storage = MatrixStorage::new(host(elements)?, self.budget)?;
+        self.observe_peak();
+        let ValueData::Matrix(matrix) = source.data() else {
+            return Err(Error::Descriptor("validated matrix payload is not Matrix"));
+        };
+        let sequence = matrix.elements();
+        if count(sequence.len())? != elements {
+            return Err(Error::Descriptor(
+                "matrix payload length disagrees with exact shape",
+            ));
+        }
+        let rows = host(extents[0])?;
+        let columns = host(extents[1])?;
+        for canonical in 0..host(elements)? {
+            // A nonempty payload proves columns>0. In particular a huge
+            // rows×0 value performs no row-count loop or division.
+            let row = canonical / columns;
+            let column = canonical % columns;
+            let value = match sequence {
+                SequenceView::F64(values) => values[canonical].to_f64(),
+                SequenceView::Values(values) => match &values[canonical] {
+                    ValueData::F64(bits) => bits.to_f64(),
+                    _ => return Err(Error::Descriptor("matrix F64 source has a non-F64 lane")),
+                },
+                _ => {
+                    return Err(Error::Descriptor(
+                        "matrix F64 source has an incompatible sequence representation",
+                    ));
+                }
+            };
+            storage.values_mut()[row + column * rows] = value;
+        }
+        let storage = Rc::new(storage);
+        let target = self
+            .values
+            .get_mut(id.get() as usize)
+            .and_then(Option::as_mut)
+            .ok_or(Error::Descriptor("matrix import target disappeared"))?;
+        target.storage = Some(storage.clone());
+        target._source_claim = Some(source_claim);
+        Ok(storage)
+    }
+    fn call(&mut self, ordinal: u64, primitive: NativeMatrixPrimitive) -> Result<(), Error> {
+        if self.complete || ordinal != self.next {
+            return Err(Error::Sequence {
+                expected: self.next,
+                actual: ordinal,
+            });
+        }
+        let index = host(ordinal)?;
+        let call = self
+            .plan()
+            .calls()
+            .get(index)
+            .ok_or(Error::Descriptor("matrix node ordinal is absent"))?;
+        if call.template().primitive() != primitive {
+            return Err(Error::Descriptor(
+                "matrix entry requested a different certified leaf",
+            ));
+        }
+        let node = call.template().node();
+        let phase = Phase::Node(node);
+        self.charge(phase, 256)?;
+        let call = &self.plan().calls()[index];
+        let metadata = self.metadata(phase, call.planning_demand())?;
+        // This bounded arity is part of the sealed leaf certificate. Clone
+        // descriptors only after metadata admission, then instantiate a real
+        // current NativeHost BoundCall and its full core memory plan.
+        let call = &self.plan().calls()[index];
+        let ids = call.operands().to_vec();
+        let target = call.output();
+        let mut descriptors = Vec::with_capacity(ids.len());
+        let mut extents = Vec::with_capacity(ids.len());
+        for &id in &ids {
+            let v = self.value(id)?;
+            descriptors.push(v.descriptor.value.clone());
+            extents.push(v.extents);
+        }
+        let bounds = self
+            .plan()
+            .call_bounds(index, &extents)
+            .map_err(|_| Error::Planning { node })?;
+        let planned = self
+            .plan()
+            .instantiate_call(index, &descriptors)
+            .map_err(|_| Error::Planning { node })?;
+        if planned.bound_call.outputs().len() != 1 {
+            return Err(Error::Descriptor(
+                "matrix planner returned wrong output arity",
+            ));
+        }
+        // Full selected-plan capacity (including bounded-axis padding/staging)
+        // is conservatively reserved IN ADDITION TO compact leaf buffers.
+        // Planned column strides are never treated as compact current.rows.
+        let mut workspace_bytes = 0;
+        for allocation in &planned.allocations {
+            workspace_bytes = add(workspace_bytes, allocation.capacity_bytes)?;
+        }
+        workspace_bytes = workspace_bytes
+            .max(planned.demand.turn_peak_bytes)
+            .max(planned.demand.transaction_peak_bytes);
+        self.charge(phase, bounds.compute_work)?;
+        self.retain_nodes(add(count(planned.allocations.len())?, 4)?)?;
+        let workspace = self.budget.reserve_capacity(workspace_bytes)?;
+        self.observe_peak();
+        // Both the full metadata/shape calculation and all work/storage
+        // admissions precede the first source payload view or leaf entry.
+        let mut output = MatrixStorage::new(host(bounds.output_elements)?, self.budget)?;
+        self.observe_peak();
+        let lhs = self.import(ids[0], phase)?;
+        match primitive {
+            NativeMatrixPrimitive::TransposeF64 => {
+                mech_engine::__native_matrix::transpose_f64(
+                    lhs.values(),
+                    output.values_mut(),
+                    host(extents[0][0])?,
+                    host(extents[0][1])?,
+                )
+                .map_err(|_| Error::Leaf { node })?;
+            }
+            NativeMatrixPrimitive::MatmulF64 => {
+                let rhs = self.import(ids[1], phase)?;
+                mech_engine::__native_matrix::matmul_f64(
+                    lhs.values(),
+                    rhs.values(),
+                    output.values_mut(),
+                    host(bounds.rows)?,
+                    host(bounds.inner)?,
+                    host(bounds.columns)?,
+                )
+                .map_err(|_| Error::Leaf { node })?;
+            }
+        }
+        let descriptor_bound = self.plan().values()[target.get() as usize]
+            .planning_demand()
+            .temporary_bytes;
+        let result = LiveValue {
+            descriptor: DescriptorOwner::new(
+                planned.bound_call.outputs()[0].clone(),
+                self.budget,
+                descriptor_bound,
+            )?,
+            extents: [bounds.rows, bounds.columns],
+            source: None,
+            storage: Some(Rc::new(output)),
+            _source_claim: None,
+        };
+        self.observe_peak();
+        let destination = self
+            .values
+            .get_mut(target.get() as usize)
+            .ok_or(Error::Descriptor("matrix result id out of range"))?;
+        if destination.is_some() {
+            return Err(Error::Descriptor("matrix result was already assigned"));
+        }
+        *destination = Some(result);
+        self.next = self
+            .next
+            .checked_add(1)
+            .ok_or(Error::Descriptor("matrix node cursor overflow"))?;
+        drop(workspace);
+        drop(metadata);
+        Ok(())
+    }
+    fn finish(&mut self, ordinal: u64) -> Result<(), Error> {
+        let total = count(self.plan().calls().len())?;
+        if self.complete || ordinal != self.next || ordinal != total {
+            return Err(Error::Sequence {
+                expected: self.next,
+                actual: ordinal,
+            });
+        }
+        self.charge(
+            Phase::Completion,
+            add(128, mul(count(self.plan().outputs().len())?, 256)?)?,
+        )?;
+        for index in 0..self.plan().outputs().len() {
+            let id = self.plan().outputs()[index].value();
+            let storage = self.import(id, Phase::Completion)?;
+            let live = self.value(id)?;
+            let expected = &self.plan().values()[id.get() as usize];
+            if live.descriptor.value.schema() != expected.schema()
+                || storage.values().len() != host(mul(live.extents[0], live.extents[1])?)?
+            {
+                return Err(Error::Descriptor(
+                    "matrix output schema/shape/backing disagrees with plan",
+                ));
+            }
+            let candidate = NativeMatrixValue {
+                descriptor: live.descriptor.clone(),
+                extents: live.extents,
+                storage,
+            };
+            self.staged.push(candidate);
+        }
+        self.complete = true;
+        self.next = add(self.next, 1)?;
+        Ok(())
+    }
+}
+
+fn owner_dimension(
+    context: &mut Context<'_>,
+    phase: Phase,
+    expression: &DimensionExpr,
+    depth: u8,
+) -> Result<(), Error> {
+    context.charge(phase, 64)?;
+    if depth >= 32 {
+        return Err(Error::Descriptor(
+            "borrowed matrix schema owner exceeds bounded metadata depth",
+        ));
+    }
+    match expression {
+        DimensionExpr::Hole | DimensionExpr::Constant(_) | DimensionExpr::Parameter(_) => Ok(()),
+        DimensionExpr::Add(items)
+        | DimensionExpr::Multiply(items)
+        | DimensionExpr::Min(items)
+        | DimensionExpr::Max(items) => {
+            for item in items {
+                owner_dimension(context, phase, item, depth + 1)?;
+            }
+            Ok(())
+        }
+    }
+}
+fn owner_extent(
+    context: &mut Context<'_>,
+    phase: Phase,
+    extent: &CardinalitySpec,
+    depth: u8,
+) -> Result<(), Error> {
+    context.charge(phase, 64)?;
+    match extent {
+        CardinalitySpec::Exact(expression) => owner_dimension(context, phase, expression, depth),
+        CardinalitySpec::Dynamic { upper_bound } => {
+            if let Some(upper) = upper_bound {
+                owner_dimension(context, phase, upper, depth)?;
+            }
+            Ok(())
+        }
+    }
+}
+fn owner_body(
+    context: &mut Context<'_>,
+    phase: Phase,
+    body: &SchemaBody,
+    depth: u8,
+) -> Result<(), Error> {
+    context.charge(phase, 64)?;
+    if depth >= 32 {
+        return Err(Error::Descriptor(
+            "borrowed matrix schema owner exceeds bounded metadata depth",
+        ));
+    }
+    match body {
+        SchemaBody::Enum { variants, .. } => {
+            for variant in variants {
+                context.charge(phase, 64)?;
+                if let Some(payload) = &variant.payload {
+                    owner_body(context, phase, payload, depth + 1)?;
+                }
+            }
+        }
+        SchemaBody::Option(item) => owner_body(context, phase, item, depth + 1)?,
+        SchemaBody::Tuple(items) => {
+            for item in items {
+                owner_body(context, phase, item, depth + 1)?;
+            }
+        }
+        SchemaBody::Record(fields) => {
+            for field in fields {
+                owner_body(context, phase, &field.schema, depth + 1)?;
+            }
+        }
+        SchemaBody::Matrix {
+            element,
+            dimensions,
+        } => {
+            owner_body(context, phase, element, depth + 1)?;
+            for dimension in dimensions {
+                owner_dimension(context, phase, dimension, 0)?;
+            }
+        }
+        SchemaBody::Table { columns, rows } => {
+            for field in columns {
+                owner_body(context, phase, &field.schema, depth + 1)?;
+            }
+            owner_extent(context, phase, rows, 0)?;
+        }
+        SchemaBody::Set {
+            element,
+            cardinality,
+        } => {
+            owner_body(context, phase, element, depth + 1)?;
+            owner_extent(context, phase, cardinality, 0)?;
+        }
+        SchemaBody::Map {
+            key,
+            value,
+            cardinality,
+        } => {
+            owner_body(context, phase, key, depth + 1)?;
+            owner_body(context, phase, value, depth + 1)?;
+            owner_extent(context, phase, cardinality, 0)?;
+        }
+        SchemaBody::Dynamic
+        | SchemaBody::Bool
+        | SchemaBody::UnsignedInteger(_)
+        | SchemaBody::SignedInteger(_)
+        | SchemaBody::IntegerInterval(_)
+        | SchemaBody::FloatingPoint(_)
+        | SchemaBody::Complex(_)
+        | SchemaBody::Rational64
+        | SchemaBody::String
+        | SchemaBody::Id
+        | SchemaBody::Index
+        | SchemaBody::Atom(_)
+        | SchemaBody::ReifiedType => {}
+    }
+    Ok(())
+}
+
+/// Catches all Rust panics at the exact private synchronous FFI boundary.
+/// A failed callback stores its first typed error, so no later generated node
+/// or output publication can run after admission or shape failure.
+unsafe fn callback(
+    context: *mut c_void,
+    ordinal: u64,
+    primitive: Option<NativeMatrixPrimitive>,
+) -> u64 {
+    if context.is_null() {
+        return BAD_ABI;
+    }
+    // SAFETY: only execute creates this context and calls the paired entry
+    // synchronously. No callback or generated pointer escapes that scope.
+    let context = unsafe { &mut *context.cast::<Context<'_>>() };
+    if context.error.is_some() {
+        return ERROR;
+    }
+    match catch_unwind(AssertUnwindSafe(|| match primitive {
+        Some(p) => context.call(ordinal, p),
+        None => context.finish(ordinal),
+    })) {
+        Ok(Ok(())) => OK,
+        Ok(Err(error)) => {
+            context.error = Some(error);
+            ERROR
+        }
+        Err(_) => {
+            context.error = Some(Error::Panic);
+            ERROR
+        }
+    }
+}
+unsafe extern "C" fn transpose(context: *mut c_void, ordinal: u64) -> u64 {
+    // SAFETY: exact context lifetime established by execute.
+    unsafe { callback(context, ordinal, Some(NativeMatrixPrimitive::TransposeF64)) }
+}
+unsafe extern "C" fn matmul(context: *mut c_void, ordinal: u64) -> u64 {
+    // SAFETY: exact context lifetime established by execute.
+    unsafe { callback(context, ordinal, Some(NativeMatrixPrimitive::MatmulF64)) }
+}
+unsafe extern "C" fn complete(context: *mut c_void, ordinal: u64) -> u64 {
+    // SAFETY: exact context lifetime established by execute.
+    unsafe { callback(context, ordinal, None) }
+}
+
+fn source_value<'a>(
+    plan: &NativeMatrixArtifactPlan,
+    id: NativeMatrixValueId,
+    value: &'a Value,
+    ordinal: usize,
+    budget: &ManagedMemoryBudget,
+) -> Result<LiveValue<'a>, Error> {
+    let expected = plan
+        .values()
+        .get(id.get() as usize)
+        .ok_or(Error::Descriptor("matrix input value id is absent"))?;
+    let error = || Error::Input {
+        input: ordinal,
+        reason: "matrix input schema/key/shape does not match canonical plan",
+    };
+    if value.schema() != expected.schema_id() || value.schema_key() != expected.schema_key() {
+        return Err(error());
+    }
+    let schema = value
+        .validate_against(plan.schemas())
+        .map_err(|_| error())?;
+    if schema != expected.schema() {
+        return Err(error());
+    }
+    let SchemaBody::Matrix { dimensions, .. } = schema.body() else {
+        return Err(error());
+    };
+    let extents = [
+        value
+            .shape()
+            .resolve_dimension(&dimensions[0])
+            .map_err(|_| error())?,
+        value
+            .shape()
+            .resolve_dimension(&dimensions[1])
+            .map_err(|_| error())?,
+    ];
+    // Validate the complete authoritative parameter bounds before retaining
+    // or reading payload. The sealed executable subset has at most two
+    // constant-bound parameters, so the pre-admitted demand is finite.
+    let descriptor =
+        ResolvedValueDescriptor::from_schema(expected.schema().clone(), value.shape().clone())
+            .map_err(|_| error())?;
+    Ok(LiveValue {
+        descriptor: DescriptorOwner::new(
+            descriptor,
+            budget,
+            expected.planning_demand().temporary_bytes,
+        )?,
+        extents,
+        source: Some(value),
+        storage: None,
+        _source_claim: None,
+    })
+}
+
+pub(super) fn execute<F>(
+    descriptor: &NativeMatrixDescriptor,
+    entry: F,
+    inputs: &[Value],
+    outputs: &mut [Option<NativeMatrixValue>],
+    limits: NativeMatrixExecutionLimits,
+    budget: &ManagedMemoryBudget,
+) -> Result<NativeMatrixExecutionReport, Error>
+where
+    F: FnOnce(*mut MatrixFrame) -> u64,
+{
+    let plan = descriptor.plan();
+    // O(1) checks before the first charged descriptor/interface traversal.
+    if inputs.len() != plan.inputs().len() {
+        return Err(Error::InvalidInputs {
+            expected: plan.inputs().len(),
+            actual: inputs.len(),
+        });
+    }
+    if outputs.len() != plan.outputs().len() {
+        return Err(Error::InvalidOutputs {
+            expected: plan.outputs().len(),
+            actual: outputs.len(),
+        });
+    }
+    if descriptor.stack_bytes() > limits.max_native_stack_bytes {
+        return Err(Error::Stack {
+            required: descriptor.stack_bytes(),
+            limit: limits.max_native_stack_bytes,
+        });
+    }
+    let demand = plan.setup_demand();
+    if demand.work > limits.max_work {
+        return Err(Error::Work {
+            phase: Phase::Setup,
+            required: demand.work,
+            limit: limits.max_work,
+        });
+    }
+    let setup_nodes = add(demand.retained_nodes, count(plan.values().len())?)?;
+    if setup_nodes > limits.max_retained_nodes {
+        return Err(Error::Nodes {
+            required: setup_nodes,
+            limit: limits.max_retained_nodes,
+        });
+    }
+    let headers = add(
+        mul(
+            count(plan.values().len())?,
+            core::mem::size_of::<Option<LiveValue<'_>>>() as u64,
+        )?,
+        mul(
+            count(outputs.len())?,
+            core::mem::size_of::<NativeMatrixValue>() as u64,
+        )?,
+    )?;
+    let metadata = budget.reserve_capacity(add(demand.temporary_bytes, headers)?)?;
+    let mut foreign = 0;
+    // Previous outputs stay live through candidate evaluation. Same-account
+    // backing already consumes capacity; foreign backing is conservatively
+    // mirrored for this invocation before any candidate storage is allocated.
+    for value in outputs.iter().flatten() {
+        if value.storage.budget() != budget {
+            foreign = add(
+                foreign,
+                add(value.storage.retained_bytes()?, value.descriptor.bytes)?,
+            )?;
+        }
+    }
+    let foreign_outputs = budget.reserve_capacity(foreign)?;
+    let mut values = Vec::new();
+    values
+        .try_reserve_exact(plan.values().len())
+        .map_err(|_| Error::Descriptor("matrix value metadata allocation failed"))?;
+    values.resize_with(plan.values().len(), || None);
+    for (index, (input, value)) in plan.inputs().iter().zip(inputs).enumerate() {
+        let target = input.value().get() as usize;
+        if values[target].is_some() {
+            return Err(Error::Descriptor("matrix input assigned twice"));
+        }
+        values[target] = Some(source_value(plan, input.value(), value, index, budget)?);
+    }
+    for constant in plan.constants() {
+        let target = constant.value().get() as usize;
+        if values[target].is_some() {
+            return Err(Error::Descriptor("matrix constant assigned twice"));
+        }
+        values[target] = Some(source_value(
+            plan,
+            constant.value(),
+            constant.canonical(),
+            inputs.len(),
+            budget,
+        )?);
+    }
+    let mut staged = Vec::new();
+    staged
+        .try_reserve_exact(outputs.len())
+        .map_err(|_| Error::Descriptor("matrix output metadata allocation failed"))?;
+    let mut context = Context {
+        descriptor,
+        budget,
+        limits,
+        values,
+        staged,
+        _metadata: metadata,
+        _foreign_outputs: foreign_outputs,
+        work: demand.work,
+        nodes: setup_nodes,
+        next: 0,
+        complete: false,
+        peak: budget.used_bytes(),
+        error: None,
+    };
+    let mut frame = MatrixFrame {
+        version: MATRIX_ABI_VERSION,
+        inputs: count(inputs.len())?,
+        calls: count(plan.calls().len())?,
+        outputs: count(outputs.len())?,
+        context: (&mut context as *mut Context<'_>).cast(),
+        transpose,
+        matmul,
+        complete,
+    };
+    let original_context = frame.context;
+    let status = entry(&mut frame);
+    if let Some(error) = context.error.take() {
+        return Err(error);
+    }
+    if status != OK {
+        return Err(Error::Status(status));
+    }
+    // Full header, callback identity and progress validation precedes every
+    // caller write. Function items are explicitly cast through pointers.
+    if frame.version != MATRIX_ABI_VERSION
+        || frame.inputs != count(inputs.len())?
+        || frame.calls != count(plan.calls().len())?
+        || frame.outputs != count(outputs.len())?
+        || frame.context != original_context
+        || frame.transpose as usize != transpose as *const () as usize
+        || frame.matmul as usize != matmul as *const () as usize
+        || frame.complete as usize != complete as *const () as usize
+        || !context.complete
+        || context.next != add(count(plan.calls().len())?, 1)?
+        || context.staged.len() != outputs.len()
+    {
+        return Err(Error::Descriptor(
+            "matrix entry changed frame or failed to complete exact sequence",
+        ));
+    }
+    let report = NativeMatrixExecutionReport {
+        work: context.work,
+        completed_nodes: plan.calls().len(),
+        peak_admitted_account_bytes: context.peak,
+    };
+    // All fallible work/validation is complete. Moving admitted immutable
+    // handles does not copy payload or allocate, so publication is atomic.
+    for (target, candidate) in outputs.iter_mut().zip(context.staged.drain(..)) {
+        *target = Some(candidate);
+    }
+    Ok(report)
+}
+
+#[cfg(all(test, feature = "canonical-native"))]
+mod tests {
+    use super::*;
+    use mech_engine::CanonicalSourceFrontend;
+    use mech_syntax::document::{
+        AstNode, DocumentId, DocumentSyntax, ParseConfig, Revision, TextSnapshot,
+        parse_canonical_document,
+    };
+
+    #[test]
+    fn borrowed_owner_metadata_has_finite_pre_descent_work_and_depth() {
+        // The descriptor itself comes from a genuine canonical source plan.
+        let parsed = parse_canonical_document(
+            TextSnapshot::new(DocumentId(0x4d41544f574e), Revision(1), "input<[f64]>'\n").unwrap(),
+            ParseConfig::default(),
+        );
+        assert!(parsed.is_strictly_clean());
+        let artifact = CanonicalSourceFrontend
+            .compile_document_with_catalog(
+                &DocumentSyntax::cast(parsed.syntax()).unwrap(),
+                mech_stdlib::source_catalog(),
+            )
+            .unwrap()
+            .compile_artifact()
+            .unwrap();
+        let plan = mech_engine::native_artifact::lower_matrix_artifact(
+            &artifact,
+            &mech_stdlib::source_catalog(),
+        )
+        .unwrap();
+        let jit = super::super::compiler::JitMatrixArtifact::compile(&plan).unwrap();
+        let budget = ManagedMemoryBudget::new(1024);
+        let mut context = Context {
+            descriptor: jit.descriptor(),
+            budget: &budget,
+            limits: NativeMatrixExecutionLimits::default(),
+            values: Vec::new(),
+            staged: Vec::new(),
+            _metadata: budget.reserve_capacity(0).unwrap(),
+            _foreign_outputs: budget.reserve_capacity(0).unwrap(),
+            work: 0,
+            nodes: 0,
+            next: 0,
+            complete: false,
+            peak: 0,
+            error: None,
+        };
+        let wide = SchemaBody::Tuple(vec![SchemaBody::Bool; 64].into_boxed_slice());
+        context.limits.max_work = 512;
+        assert!(matches!(
+            owner_body(&mut context, Phase::Setup, &wide, 0),
+            Err(Error::Work {
+                phase: Phase::Setup,
+                ..
+            })
+        ));
+        assert_eq!(context.work, 512);
+        context.work = 0;
+        context.limits = NativeMatrixExecutionLimits::default();
+        let mut deep = SchemaBody::Bool;
