+//! Explicit matrix qualification shell. Kernel evaluation is typed/nonprinting;
+//! this shell alone parses raw hexadecimal F64 words and prints results.
+use mech_core::{
+    ManagedMemoryBudget, ValueDataDraft, ValueDraft,
+    snapshot::{F64Bits, SnapshotValidationContext},
+};
+use mech_engine::native_artifact::lower_matrix_artifact;
+use mech_gpu::native_artifact::matrix::{
+    LinkedMatrixArtifact, MATRIX_IDENTITY_BYTES, NativeMatrixExecutionLimits,
+};
+use sha2::{Digest, Sha256};
+use std::{
+    ffi::{OsString, c_void},
+    io::Write,
+};
+unsafe extern "C" {
+    #[link_name = "mech_canonical_matrix_entry_v1"]
+    fn linked_entry(frame: *mut c_void) -> u64;
+    #[link_name = "@IDENTITY_SYMBOL@"]
+    static LINKED_IDENTITY: [u8; MATRIX_IDENTITY_BYTES];
+}
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+fn unsigned(text: &str) -> Result<u64, String> {
+    if text.is_empty() || !text.bytes().all(|b| b.is_ascii_digit()) {
+        return Err("invalid unsigned argument".into());
+    }
+    text.parse()
+        .map_err(|_| "unsigned argument overflow".into())
+}
+fn options(
+    arguments: Vec<OsString>,
+) -> Result<(NativeMatrixExecutionLimits, u64, Vec<OsString>), String> {
+    let mut limits = NativeMatrixExecutionLimits::default();
+    let mut budget = 64 * 1024 * 1024;
+    let mut payload = Vec::new();
+    let mut controls = true;
+    for argument in arguments {
+        if controls {
+            let text = argument.to_str().ok_or("argument is not Unicode")?;
+            if text == "--" {
+                controls = false;
+                continue;
+            }
+            let mut selected = None;
+            for (prefix, kind) in [
+                ("--work=", 0),
+                ("--nodes=", 1),
+                ("--stack=", 2),
+                ("--budget=", 3),
+            ] {
+                if let Some(value) = text.strip_prefix(prefix) {
+                    selected = Some((kind, unsigned(value)?));
+                    break;
+                }
+            }
+            if let Some((kind, value)) = selected {
+                match kind {
+                    0 => limits.max_work = value,
+                    1 => limits.max_retained_nodes = value,
+                    2 => limits.max_native_stack_bytes = value,
+                    _ => budget = value,
+                }
+                continue;
+            }
+            if text.starts_with("--") {
+                return Err("unknown option".into());
+            }
+            controls = false;
+        }
+        payload.push(argument);
+    }
+    Ok((limits, budget, payload))
+}
+fn matrix(text: &str) -> Result<([u64; 2], Vec<ValueDataDraft>), String> {
+    let (shape, words) = text
+        .split_once(':')
+        .ok_or("matrix input needs rowsxcolumns:hexwords")?;
+    let (rows, columns) = shape
+        .split_once('x')
+        .ok_or("matrix input needs rowsxcolumns")?;
+    let extents = [unsigned(rows)?, unsigned(columns)?];
+    let count = extents[0]
+        .checked_mul(extents[1])
+        .ok_or("matrix element count overflow")?;
+    let mut data = Vec::new();
+    if !words.is_empty() {
+        for word in words.split(',') {
+            if word.len() != 16 || !word.bytes().all(|b| b.is_ascii_hexdigit()) {
+                return Err("invalid F64 bit word".into());
+            }
+            data.push(ValueDataDraft::F64(F64Bits::from_bits(
+                u64::from_str_radix(word, 16).map_err(|_| "invalid F64 bit word")?,
+            )));
+        }
+    }
+    if data.len() as u64 != count {
+        return Err("matrix element count differs from shape".into());
+    }
+    Ok((extents, data))
+}
+fn run() -> Result<(), String> {
+    let bytecode = include_bytes!("../program.mecb");
+    if hex(&Sha256::digest(bytecode)) != "@BYTECODE_SHA256@" {
+        return Err("embedded canonical bytecode identity mismatch".into());
+    }
+    let artifact = mech_engine::decode_program_artifact_bytecode_v1(bytecode)
+        .map_err(|e| format!("canonical artifact decode: {e:?}"))?;
+    // Only actual maintained catalog metadata is selected here. The generated
+    // app has no syntax, JIT, codegen, activation or resident evaluator route.
+    let catalog = std::thread::Builder::new()
+        .name("canonical-matrix-catalog".into())
+        .stack_size(64 * 1024 * 1024)
+        .spawn(|| -> Result<_, String> {
+            let mut builder = mech_core::FunctionCatalogBuilder::new();
+            mech_stdlib::install_native_plan(&mut builder).map_err(|e| format!("{e:?}"))?;
+            mech_engine::install_intrinsic_resident(&mut builder).map_err(|e| format!("{e:?}"))?;
+            builder.build().map_err(|e| format!("{e:?}"))
+        })
+        .map_err(|e| e.to_string())?
+        .join()
+        .map_err(|_| "matrix metadata catalog panicked")??;
+    let plan = lower_matrix_artifact(&artifact, &catalog).map_err(|e| e.to_string())?;
+    // SAFETY: the build pins all generated inputs and links both symbols from
+    // the SAME unchanged checked matrix Object. Identity alone is insufficient.
+    let linked = unsafe {
+        LinkedMatrixArtifact::from_build_owned_entry(&plan, &LINKED_IDENTITY, linked_entry)
+    }
+    .map_err(str::to_owned)?;
+    let (limits, budget, arguments) = options(std::env::args_os().skip(1).collect())?;
+    if arguments.len() != plan.inputs().len() {
+        return Err(format!("expected {} matrix inputs", plan.inputs().len()));
+    }
+    let context = SnapshotValidationContext::with_shared_schemas(plan.schemas());
+    let mut inputs = Vec::with_capacity(arguments.len());
+    for (argument, input) in arguments.iter().zip(plan.inputs()) {
+        let (extents, data) = matrix(argument.to_str().ok_or("argument is not Unicode")?)?;
+        let ty = &plan.values()[input.value().get() as usize];
+        let shape = mech_core::shape_for_resolved_extents(ty.schema(), &extents)
+            .map_err(|e| format!("matrix input shape: {e:?}"))?;
+        inputs.push(
+            ValueDraft {
+                schema: ty.schema_id(),
+                shape_values: shape.parameter_values().to_vec().into_boxed_slice(),
+                data: ValueDataDraft::Matrix(data.into_boxed_slice()),
+            }
+            .finalize(&context)
+            .map_err(|e| format!("matrix input value: {e:?}"))?,
+        );
+    }
+    let mut outputs = vec![None; plan.outputs().len()];
+    linked
+        .evaluate_into(
+            &inputs,
+            &mut outputs,
+            limits,
+            &ManagedMemoryBudget::new(budget),
+        )
+        .map_err(|e| e.to_string())?;
+    let mut result = String::new();
+    for output in outputs {
+        let output = output.ok_or("matrix output absent")?;
+        let [rows, columns] = output.extents();
+        use std::fmt::Write;
+        write!(&mut result, "{rows}x{columns}:").unwrap();
+        for ordinal in 0..rows
+            .checked_mul(columns)
+            .ok_or("matrix output count overflow")?
+        {
+            let row = ordinal / columns;
+            let column = ordinal % columns;
+            if ordinal != 0 {
+                result.push(',');
+            }
+            let offset = usize::try_from(row + column * rows)
+                .map_err(|_| "matrix output offset overflow")?;
+            write!(
+                &mut result,
+                "{:016x}",
+                output.column_major_values()[offset].to_bits()
+            )
+            .unwrap();
+        }
+        result.push('\n');
+    }
+    std::io::stdout()
+        .lock()
+        .write_all(result.as_bytes())
+        .map_err(|e| e.to_string())
+}
+fn main() {
+    if let Err(error) = run() {
+        eprintln!("{error}");
+        std::process::exit(1);
+    }
+}
