+//! Canonical scalar CFG definition shared by JIT and Object emission.
+use super::abi::{NO_NODE, NativeEntryFrame as Frame, STATUS_ABI, STATUS_OK};
+use super::compiler::{
+    admit, backend, compiled_stack_bytes, frame_load, guard, host_supported, limit, offset,
+    primitive, set_origin, signature,
+};
+use super::control_abi::{ENTRY, Entry, NativeMatchDescriptor, STATUS_REJECT, VERSION};
+use super::control_runtime::{NativeMatchExecutionError, NativeMatchExecutionReport};
+use super::{NativeCompileError, NativeCompileLimits, NativeExecutionLimits};
+use cranelift_codegen::{
+    ir::{AbiParam, InstBuilder, MemFlags, Value, condcodes::IntCC, types},
+    settings::{self, Configurable},
+};
+use cranelift_frontend::{FunctionBuilder, FunctionBuilderContext};
+use cranelift_module::{DataDescription, FuncId, Linkage, Module, default_libcall_names};
+use cranelift_object::{ObjectBuilder, ObjectModule};
+use mech_core::ManagedMemoryBudget;
+use mech_engine::native_artifact::{
+    NativeMatchAction, NativeMatchArtifactPlan, NativeMatchTerminator, NativeMatchValue,
+    NativeScalarKind, NativeScalarValue,
+};
+use std::collections::VecDeque;
+
+pub struct JitMatchArtifact {
+    _module: cranelift_jit::JITModule,
+    entry: Entry,
+    descriptor: NativeMatchDescriptor,
+}
+impl JitMatchArtifact {
+    pub fn compile(plan: &NativeMatchArtifactPlan) -> Result<Self, NativeCompileError> {
+        Self::compile_with_limits(plan, NativeCompileLimits::default())
+    }
+    pub fn compile_with_limits(
+        plan: &NativeMatchArtifactPlan,
+        limits: NativeCompileLimits,
+    ) -> Result<Self, NativeCompileError> {
+        host_supported()?;
+        let builder = cranelift_jit::JITBuilder::with_flags(
+            &[
+                ("opt_level", "none"),
+                ("is_pic", "true"),
+                ("preserve_frame_pointers", "true"),
+                ("unwind_info", "true"),
+            ],
+            default_libcall_names(),
+        )
+        .map_err(backend)?;
+        let mut module = cranelift_jit::JITModule::new(builder);
+        let (function, descriptor) = define(plan, &mut module, limits)?;
+        module.finalize_definitions().map_err(backend)?;
+        // SAFETY: the one checked definition emits the private repr(C) ABI;
+        // this owner retains its module for every synchronous invocation.
+        let entry = unsafe {
+            std::mem::transmute::<*const u8, Entry>(module.get_finalized_function(function))
+        };
+        Ok(Self {
+            _module: module,
+            entry,
+            descriptor,
+        })
+    }
+    pub fn descriptor(&self) -> &NativeMatchDescriptor {
+        &self.descriptor
+    }
+    pub fn evaluate_into(
+        &self,
+        inputs: &[NativeScalarValue],
+        outputs: &mut [NativeScalarValue],
+        limits: NativeExecutionLimits,
+        budget: Option<&ManagedMemoryBudget>,
+    ) -> Result<NativeMatchExecutionReport, NativeMatchExecutionError> {
+        super::control_runtime::execute(
+            &self.descriptor,
+            |frame| {
+                // SAFETY: this owner created and retains the exact checked entry.
+                unsafe { (self.entry)(frame) }
+            },
+            inputs,
+            outputs,
+            limits,
+            budget,
+        )
+    }
+}
+pub struct NativeMatchObject {
+    bytes: Vec<u8>,
+    descriptor: NativeMatchDescriptor,
+    identity: [u8; 168],
+    symbol: String,
+}
+impl NativeMatchObject {
+    pub fn bytes(&self) -> &[u8] {
+        &self.bytes
+    }
+    pub fn descriptor(&self) -> &NativeMatchDescriptor {
+        &self.descriptor
+    }
+    pub fn identity_bytes(&self) -> &[u8; 168] {
+        &self.identity
+    }
+    pub fn identity_symbol(&self) -> &str {
+        &self.symbol
+    }
+    pub fn metadata(&self) -> serde_json::Value {
+        serde_json::json!({
+            "schema":"mech.canonical-scalar-match-object.v1","control_abi_version":VERSION,
+            "typed_ir_sha256":super::identity::hex(self.descriptor.typed_ir_sha256()),
+            "identity_symbol":self.symbol,"stack_bytes":self.descriptor.stack_bytes(),"code_bytes":self.descriptor.code_bytes(),
+            "linked":false,"executed":false,"timing_samples":0,
+        })
+    }
+}
+pub fn emit_match_object(
+    plan: &NativeMatchArtifactPlan,
+) -> Result<NativeMatchObject, NativeCompileError> {
+    emit_match_object_with_limits(plan, NativeCompileLimits::default())
+}
+pub fn emit_match_object_with_limits(
+    plan: &NativeMatchArtifactPlan,
+    limits: NativeCompileLimits,
+) -> Result<NativeMatchObject, NativeCompileError> {
+    host_supported()?;
+    let mut flags = settings::builder();
+    for (key, value) in [
+        ("opt_level", "none"),
+        ("is_pic", "true"),
+        ("preserve_frame_pointers", "true"),
+        ("unwind_info", "true"),
+    ] {
+        flags.set(key, value).map_err(backend)?;
+    }
+    let isa = cranelift_native::builder()
+        .map_err(backend)?
+        .finish(settings::Flags::new(flags))
+        .map_err(backend)?;
+    let mut module = ObjectModule::new(
+        ObjectBuilder::new(isa, "mech_canonical_scalar_match", default_libcall_names())
+            .map_err(backend)?,
+    );
+    let (_, descriptor) = define(plan, &mut module, limits)?;
+    let identity = super::control_identity::object_record(plan, &descriptor)?;
+    let symbol = format!(
+        "mech_canonical_scalar_match_identity_v1_{}",
+        super::identity::hex(descriptor.typed_ir_sha256())
+    );
+    let id = module
+        .declare_data(&symbol, Linkage::Export, false, false)
+        .map_err(backend)?;
+    let mut data = DataDescription::new();
+    data.define(identity.to_vec().into_boxed_slice());
+    data.set_align(8);
+    module.define_data(id, &data).map_err(backend)?;
+    let bytes = module.finish().emit().map_err(backend)?;
+    Ok(NativeMatchObject {
+        bytes,
+        descriptor,
+        identity,
+        symbol,
+    })
+}
+
+fn successors(term: NativeMatchTerminator) -> [Option<u32>; 2] {
+    match term {
+        NativeMatchTerminator::Jump(next) => [Some(next), None],
+        NativeMatchTerminator::Branch { yes, no, .. }
+        | NativeMatchTerminator::LiteralBranch { yes, no, .. } => [Some(yes), Some(no)],
+        _ => [None, None],
+    }
+}
+fn action_reads(action: &NativeMatchAction) -> Vec<NativeMatchValue> {
+    let reads = match action {
+        NativeMatchAction::Primitive { operands, .. } => operands.to_vec(),
+        NativeMatchAction::Copy { source, .. } => vec![*source],
+        NativeMatchAction::None => Vec::new(),
+    };
+    reads
+}
+fn output(action: &NativeMatchAction) -> Option<NativeMatchValue> {
+    match action {
+        NativeMatchAction::Primitive { output, .. } | NativeMatchAction::Copy { output, .. } => {
+            Some(*output)
+        }
+        NativeMatchAction::None => None,
+    }
+}
+
+/// Check dominance and all exact types without constructing a callable plan.
+/// Metadata is private-constructor, but the emitter still refuses malformed CFG.
+fn validate(plan: &NativeMatchArtifactPlan) -> Result<(), NativeCompileError> {
+    let bad = || NativeCompileError::InvalidPlan {
+        node: None,
+        reason: "invalid Match CFG or scalar dominance",
+    };
+    let n = plan.blocks().len();
+    let count = plan.values().len();
+    if plan.entry() as usize >= n {
+        return Err(bad());
+    }
+    let ty = |value: NativeMatchValue| plan.values().get(value.get() as usize).ok_or_else(bad);
+    let mut predecessors = vec![Vec::new(); n];
+    let mut degrees = vec![0usize; n];
+    for (index, block) in plan.blocks().iter().enumerate() {
+        for next in successors(block.terminator()).into_iter().flatten() {
+            let next = next as usize;
+            if next >= n {
+                return Err(bad());
+            }
+            predecessors[next].push(index);
+            degrees[next] = degrees[next].checked_add(1).ok_or_else(bad)?;
+        }
+        match block.action() {
+            NativeMatchAction::Primitive {
+                op,
+                operands,
+                output,
+                ..
+            } => {
+                let (args, result) = signature(*op);
+                if operands.len() != args.len() || ty(*output)?.kind() != result {
+                    return Err(bad());
+                }
+                for (&value, &kind) in operands.iter().zip(args) {
+                    if ty(value)?.kind() != kind {
+                        return Err(bad());
+                    }
+                }
+            }
+            NativeMatchAction::Copy { source, output } => {
+                if ty(*source)? != ty(*output)? {
+                    return Err(bad());
+                }
+            }
+            NativeMatchAction::None => {}
+        }
+        match block.terminator() {
+            NativeMatchTerminator::Branch { condition, .. } => {
+                if ty(condition)?.kind() != NativeScalarKind::Bool {
+                    return Err(bad());
+                }
+            }
+            NativeMatchTerminator::LiteralBranch { left, right, .. } => {
+                if ty(left)? != ty(right)? {
+                    return Err(bad());
+                }
+            }
+            _ => {}
+        }
+    }
+    let mut initial = vec![false; count];
+    for input in plan.inputs() {
+        let id = input.value().get() as usize;
+        if id >= count || ty(input.value())? != input.declaration().ty() {
+            return Err(bad());
+        }
+        initial[id] = true;
+    }
+    for constant in plan.constants() {
+        let id = constant.value().get() as usize;
+        if id >= count {
+            return Err(bad());
+        }
+        let kind = match constant.scalar() {
+            NativeScalarValue::Bool(_) => NativeScalarKind::Bool,
+            NativeScalarValue::U64(_) => NativeScalarKind::U64,
+        };
+        if ty(constant.value())?.kind() != kind {
+            return Err(bad());
+        }
+        initial[id] = true;
+    }
+    let mut ends = vec![Vec::<bool>::new(); n];
+    let mut ready = (0..n)
+        .filter(|&id| degrees[id] == 0)
+        .collect::<VecDeque<_>>();
+    let mut seen = 0;
+    while let Some(id) = ready.pop_front() {
+        seen += 1;
+        let block = &plan.blocks()[id];
+        let mut known = if let Some(&first) = predecessors[id].first() {
+            ends[first].clone()
+        } else {
+            initial.clone()
+        };
+        for &parent in predecessors[id].iter().skip(1) {
+            for (bit, &other) in known.iter_mut().zip(&ends[parent]) {
+                *bit &= other;
+            }
+        }
+        for value in action_reads(block.action()) {
+            if !known.get(value.get() as usize).copied().unwrap_or(false) {
+                return Err(bad());
+            }
+        }
+        if let Some(value) = output(block.action()) {
+            known[value.get() as usize] = true;
+        }
+        let conditions = match block.terminator() {
+            NativeMatchTerminator::Branch { condition, .. } => vec![condition],
+            NativeMatchTerminator::LiteralBranch { left, right, .. } => vec![left, right],
+            _ => Vec::new(),
+        };
+        for value in conditions {
+            if !known.get(value.get() as usize).copied().unwrap_or(false) {
+                return Err(bad());
+            }
+        }
+        if block.terminator() == NativeMatchTerminator::Complete {
+            for output in plan.outputs() {
+                if !known
+                    .get(output.value().get() as usize)
+                    .copied()
+                    .unwrap_or(false)
+                    || ty(output.value())? != output.ty()
+                {
+                    return Err(bad());
+                }
+            }
+        }
+        ends[id] = known;
+        for next in successors(block.terminator()).into_iter().flatten() {
+            let next = next as usize;
+            degrees[next] -= 1;
+            if degrees[next] == 0 {
+                ready.push_back(next);
+            }
+        }
+    }
+    if seen != n {
+        return Err(bad());
+    }
+    Ok(())
+}
+
+fn load(
+    b: &mut FunctionBuilder<'_>,
+    locals: Value,
+    value: NativeMatchValue,
+) -> Result<Value, NativeCompileError> {
+    Ok(b.ins().load(
+        types::I64,
+        MemFlags::new(),
+        locals,
+        offset(value.get() as usize)?,
+    ))
+}
+fn define<M: Module>(
+    plan: &NativeMatchArtifactPlan,
+    module: &mut M,
+    limits: NativeCompileLimits,
+) -> Result<(FuncId, NativeMatchDescriptor), NativeCompileError> {
+    host_supported()?;
+    if module.target_config().pointer_type() != types::I64 {
+        return Err(NativeCompileError::UnsupportedHost);
+    }
+    limit("Match blocks", plan.blocks().len() as u64, limits.max_nodes)?;
+    limit(
+        "Match inputs",
+        plan.inputs().len() as u64,
+        limits.max_inputs,
+    )?;
+    limit(
+        "Match outputs",
+        plan.outputs().len() as u64,
+        limits.max_outputs,
+    )?;
+    limit(
+        "Match scalar values",
+        plan.values().len() as u64,
+        limits.max_nodes.saturating_mul(8),
+    )?;
+    offset(plan.values().len())?;
+    offset(plan.inputs().len())?;
+    offset(plan.outputs().len())?;
+    validate(plan)?;
+    let mut signature_entry = module.make_signature();
+    signature_entry.params.push(AbiParam::new(types::I64));
+    signature_entry.returns.push(AbiParam::new(types::I64));
+    let function = module
+        .declare_function(ENTRY, Linkage::Export, &signature_entry)
+        .map_err(backend)?;
+    let mut callback_signature = module.make_signature();
+    callback_signature.params = vec![AbiParam::new(types::I64); 2];
+    callback_signature.returns.push(AbiParam::new(types::I64));
+    let mut context = module.make_context();
+    context.func.signature = signature_entry;
+    let mut fb = FunctionBuilderContext::new();
+    {
+        let mut b = FunctionBuilder::new(&mut context.func, &mut fb);
+        let entry = b.create_block();
+        b.append_block_params_for_function_params(entry);
+        b.switch_to_block(entry);
+        let frame = b.block_params(entry)[0];
+        let error = b.create_block();
+        b.append_block_param(error, types::I64);
+        b.set_cold_block(error);
+        let nonnull = b.ins().icmp_imm(IntCC::NotEqual, frame, 0);
+        guard(&mut b, nonnull, error, STATUS_ABI);
+        set_origin(&mut b, frame, NO_NODE);
+        for (field, value) in [
+            (core::mem::offset_of!(Frame, version), VERSION),
+            (
+                core::mem::offset_of!(Frame, input_count),
+                plan.inputs().len() as u64,
+            ),
+            (
+                core::mem::offset_of!(Frame, local_count),
+                plan.values().len() as u64,
+            ),
+            (
+                core::mem::offset_of!(Frame, output_count),
+                plan.outputs().len() as u64,
+            ),
+        ] {
+            let actual = frame_load(&mut b, frame, field);
+            let valid = b.ins().icmp_imm(IntCC::Equal, actual, value as i64);
+            guard(&mut b, valid, error, STATUS_ABI);
+        }
+        let inputs = frame_load(&mut b, frame, core::mem::offset_of!(Frame, inputs));
+        let locals = frame_load(&mut b, frame, core::mem::offset_of!(Frame, locals));
+        let outputs = frame_load(&mut b, frame, core::mem::offset_of!(Frame, outputs));
+        let user_context = frame_load(&mut b, frame, core::mem::offset_of!(Frame, context));
+        let callback = frame_load(&mut b, frame, core::mem::offset_of!(Frame, admit_next));
+        for (pointer, count) in [
+            (inputs, plan.inputs().len()),
+            (locals, plan.values().len()),
+            (outputs, plan.outputs().len()),
+            (user_context, 1),
+            (callback, 1),
+        ] {
+            if count > 0 {
+                let valid = b.ins().icmp_imm(IntCC::NotEqual, pointer, 0);
+                guard(&mut b, valid, error, STATUS_ABI);
+            }
+        }
+        for (index, input) in plan.inputs().iter().enumerate() {
+            let word = b
+                .ins()
+                .load(types::I64, MemFlags::new(), inputs, offset(index)?);
+            if input.declaration().ty().kind() == NativeScalarKind::Bool {
+                let valid = b.ins().icmp_imm(IntCC::UnsignedLessThanOrEqual, word, 1);
+                guard(&mut b, valid, error, STATUS_ABI);
+            }
+            b.ins().store(
+                MemFlags::new(),
+                word,
+                locals,
+                offset(input.value().get() as usize)?,
+            );
+        }
+        for constant in plan.constants() {
+            let word = match constant.scalar() {
+                NativeScalarValue::Bool(value) => u64::from(value),
+                NativeScalarValue::U64(value) => value,
+            };
+            let value = b.ins().iconst(types::I64, word as i64);
+            b.ins().store(
+                MemFlags::new(),
+                value,
+                locals,
+                offset(constant.value().get() as usize)?,
+            );
+        }
+        let callback_signature = b.import_signature(callback_signature);
+        let mut reachable = vec![false; plan.blocks().len()];
+        let mut pending = vec![plan.entry() as usize];
+        while let Some(id) = pending.pop() {
+            if reachable[id] {
+                continue;
+            }
+            reachable[id] = true;
+            pending.extend(
+                successors(plan.blocks()[id].terminator())
+                    .into_iter()
+                    .flatten()
+                    .map(|next| next as usize),
+            );
+        }
+        let blocks = reachable
+            .iter()
+            .map(|&used| used.then(|| b.create_block()))
+            .collect::<Vec<_>>();
+        b.ins()
+            .jump(blocks[plan.entry() as usize].expect("reachable entry"), &[]);
+        for (index, block) in plan.blocks().iter().enumerate() {
+            if !reachable[index] {
+                continue;
+            }
+            b.switch_to_block(blocks[index].expect("reachable block"));
+            let before = b.func.dfg.num_insts();
+            set_origin(&mut b, frame, index as u64);
+            admit(
+                &mut b,
+                callback_signature,
+                callback,
+                user_context,
+                index,
+                error,
+            );
+            match block.action() {
+                NativeMatchAction::Primitive {
+                    op,
+                    operands,
+                    output,
+                    ..
+                } => {
+                    let args = operands
+                        .iter()
+                        .map(|&value| load(&mut b, locals, value))
+                        .collect::<Result<Vec<_>, _>>()?;
+                    let value = primitive(&mut b, *op, &args, error);
+                    b.ins().store(
+                        MemFlags::new(),
+                        value,
+                        locals,
+                        offset(output.get() as usize)?,
+                    );
+                }
+                NativeMatchAction::Copy { source, output } => {
+                    let value = load(&mut b, locals, *source)?;
+                    b.ins().store(
+                        MemFlags::new(),
+                        value,
+                        locals,
+                        offset(output.get() as usize)?,
+                    );
+                }
+                NativeMatchAction::None => {}
+            }
+            match block.terminator() {
+                NativeMatchTerminator::Jump(next) => {
+                    b.ins()
+                        .jump(blocks[next as usize].expect("reachable successor"), &[]);
+                }
+                NativeMatchTerminator::Branch { condition, yes, no } => {
+                    let value = load(&mut b, locals, condition)?;
+                    let condition = b.ins().icmp_imm(IntCC::NotEqual, value, 0);
+                    b.ins().brif(
+                        condition,
+                        blocks[yes as usize].expect("reachable successor"),
+                        &[],
+                        blocks[no as usize].expect("reachable successor"),
+                        &[],
+                    );
+                }
+                NativeMatchTerminator::LiteralBranch {
+                    left,
+                    right,
+                    yes,
+                    no,
+                } => {
+                    let left = load(&mut b, locals, left)?;
+                    let right = load(&mut b, locals, right)?;
+                    let condition = b.ins().icmp(IntCC::Equal, left, right);
+                    b.ins().brif(
+                        condition,
+                        blocks[yes as usize].expect("reachable successor"),
+                        &[],
+                        blocks[no as usize].expect("reachable successor"),
+                        &[],
+                    );
+                }
+                NativeMatchTerminator::Reject => {
+                    let status = b.ins().iconst(types::I64, STATUS_REJECT as i64);
+                    b.ins().return_(&[status]);
+                }
+                NativeMatchTerminator::Complete => {
+                    set_origin(&mut b, frame, NO_NODE);
+                    for (index, output) in plan.outputs().iter().enumerate() {
+                        let value = load(&mut b, locals, output.value())?;
+                        b.ins()
+                            .store(MemFlags::new(), value, outputs, offset(index)?);
+                    }
+                    let status = b.ins().iconst(types::I64, STATUS_OK as i64);
+                    b.ins().return_(&[status]);
+                }
+            }
+            let emitted = (b.func.dfg.num_insts() - before) as u64;
+            let bound = match block.action() {
+                NativeMatchAction::Primitive { op, .. } => super::abi::primitive_work(*op),
+                _ => {
+                    if block.terminator() == NativeMatchTerminator::Complete {
+                        (plan.outputs().len() as u64)
+                            .checked_mul(8)
+                            .and_then(|v| v.checked_add(128))
+                            .ok_or_else(|| backend("Match completion overflow"))?
+                    } else {
+                        128
+                    }
+                }
+            };
+            if emitted.checked_add(64).is_none_or(|total| total > bound) {
+                return Err(NativeCompileError::InvalidPlan {
+                    node: Some(block.origin().node()),
+                    reason: "Match visit exceeds conservative work template",
+                });
+            }
+        }
+        b.switch_to_block(error);
+        let status = b.block_params(error)[0];
+        b.ins().return_(&[status]);
+        b.seal_all_blocks();
+        b.finalize();
+    }
+    module
+        .define_function(function, &mut context)
+        .map_err(backend)?;
+    let compiled = context
+        .compiled_code()
+        .ok_or(NativeCompileError::StackMetadata {
+            reason: "Match compiled code missing",
+        })?;
+    let stack = compiled_stack_bytes(&compiled.buffer)?;
+    let code = compiled.code_info().total_size as u64;
+    limit("Match stack", stack, limits.max_stack_bytes)?;
+    limit("Match code", code, limits.max_code_bytes)?;
+    Ok((
+        function,
+        NativeMatchDescriptor::from_compiled(plan, stack, code)?,
+    ))
+}
diff --git a/hosts/gpu/src/native_artifact/control_identity.rs b/hosts/gpu/src/native_artifact/control_identity.rs
new file mode 100644
--- /dev/null
+++ b/hosts/gpu/src/native_artifact/control_identity.rs
@@ -0,0 +1,147 @@
+//! Explicit versioned executable CFG identity; no Debug/serde encoding.
+use mech_engine::native_artifact::{
+    NativeMatchAction, NativeMatchArtifactPlan, NativeMatchTerminator, NativeScalarKind,
+    NativeScalarValue,
+};
+use sha2::{Digest, Sha256};
+fn word(hash: &mut Sha256, value: u64) {
+    hash.update(value.to_le_bytes());
+}
+fn bytes(hash: &mut Sha256, value: &[u8]) {
+    word(hash, value.len() as u64);
+    hash.update(value);
+}
+pub(super) fn object_record(
+    plan: &NativeMatchArtifactPlan,
+    descriptor: &super::control_abi::NativeMatchDescriptor,
+) -> Result<[u8; 168], super::NativeCompileError> {
+    let mut bytes = [0; 168];
+    bytes[..16].copy_from_slice(b"MECHNATIVEMATCH\0");
+    for (at, value) in [
+        (16, 1u64),
+        (24, super::control_abi::VERSION),
+        (32, 1),
+        (112, descriptor.stack_bytes()),
+        (120, descriptor.code_bytes()),
+        (128, plan.inputs().len() as u64),
+        (136, plan.values().len() as u64),
+        (144, plan.blocks().len() as u64),
+        (152, plan.outputs().len() as u64),
+        (160, plan.entry() as u64),
+    ] {
+        bytes[at..at + 8].copy_from_slice(&value.to_le_bytes());
+    }
+    bytes[40..72].copy_from_slice(plan.program_revision().as_bytes());
+    bytes[72..104].copy_from_slice(descriptor.typed_ir_sha256());
+    bytes[104..112].copy_from_slice(
+        &super::identity::host_target_tag().ok_or(super::NativeCompileError::UnsupportedHost)?,
+    );
+    Ok(bytes)
+}
+pub(super) fn typed_ir_sha256(plan: &NativeMatchArtifactPlan) -> [u8; 32] {
+    let mut hash = Sha256::new();
+    hash.update(b"mech.canonical-scalar-match-cfg\0");
+    word(&mut hash, 1); // Separate control IR version, not scalar v1/v2/v3.
+    word(&mut hash, super::control_abi::VERSION);
+    word(&mut hash, 1); // Control visit work policy.
+    hash.update(plan.program_revision().as_bytes());
+    word(&mut hash, plan.entry() as u64);
+    word(&mut hash, plan.values().len() as u64);
+    for ty in plan.values() {
+        hash.update([match ty.kind() {
+            NativeScalarKind::Bool => 1,
+            NativeScalarKind::U64 => 2,
+        }]);
+        word(&mut hash, ty.schema().get() as u64);
+        hash.update(ty.schema_key().as_bytes());
+    }
+    word(&mut hash, plan.inputs().len() as u64);
+    for input in plan.inputs() {
+        word(&mut hash, input.declaration().input().get() as u64);
+        word(&mut hash, input.declaration().slot().get() as u64);
+        bytes(&mut hash, input.declaration().name().as_bytes());
+        word(&mut hash, input.value().get() as u64);
+    }
+    word(&mut hash, plan.constants().len() as u64);
+    for constant in plan.constants() {
+        word(&mut hash, constant.value().get() as u64);
+        match constant.scalar() {
+            NativeScalarValue::Bool(value) => {
+                hash.update([1]);
+                word(&mut hash, value as u64);
+            }
+            NativeScalarValue::U64(value) => {
+                hash.update([2]);
+                word(&mut hash, value);
+            }
+        }
+    }
+    word(&mut hash, plan.blocks().len() as u64);
+    for block in plan.blocks() {
+        let at = block.origin();
+        word(&mut hash, at.node().get() as u64);
+        for id in [at.block(), at.local()] {
+            match id {
+                Some(id) => {
+                    hash.update([1]);
+                    word(&mut hash, id as u64);
+                }
+                None => hash.update([0]),
+            }
+        }
+        match block.action() {
+            NativeMatchAction::None => hash.update([0]),
+            NativeMatchAction::Primitive {
+                op,
+                operands,
+                output,
+                ..
+            } => {
+                hash.update([1, super::identity::op_tag(*op)]);
+                word(&mut hash, output.get() as u64);
+                word(&mut hash, operands.len() as u64);
+                for operand in operands {
+                    word(&mut hash, operand.get() as u64);
+                }
+            }
+            NativeMatchAction::Copy { source, output } => {
+                hash.update([2]);
+                word(&mut hash, source.get() as u64);
+                word(&mut hash, output.get() as u64);
+            }
+        }
+        match block.terminator() {
+            NativeMatchTerminator::Jump(next) => {
+                hash.update([1]);
+                word(&mut hash, next as u64);
+            }
+            NativeMatchTerminator::Branch { condition, yes, no } => {
+                hash.update([2]);
+                word(&mut hash, condition.get() as u64);
+                word(&mut hash, yes as u64);
+                word(&mut hash, no as u64);
+            }
+            NativeMatchTerminator::LiteralBranch {
+                left,
+                right,
+                yes,
+                no,
+            } => {
+                hash.update([3]);
+                for value in [left.get(), right.get(), yes, no] {
+                    word(&mut hash, value as u64);
+                }
+            }
+            NativeMatchTerminator::Complete => hash.update([4]),
+            NativeMatchTerminator::Reject => hash.update([5]),
+        }
+    }
+    word(&mut hash, plan.outputs().len() as u64);
+    for output in plan.outputs() {
+        word(&mut hash, output.output().get() as u64);
+        word(&mut hash, output.slot().get() as u64);
+        bytes(&mut hash, output.name().as_bytes());
+        word(&mut hash, output.value().get() as u64);
+    }
+    hash.finalize().into()
+}
diff --git a/hosts/gpu/src/native_artifact/control_runtime.rs b/hosts/gpu/src/native_artifact/control_runtime.rs
new file mode 100644
--- /dev/null
+++ b/hosts/gpu/src/native_artifact/control_runtime.rs
@@ -0,0 +1,459 @@
+//! Safe managed invocation for a compiled CFG. Callbacks admit visits only;
+//! they do not evaluate a condition, pattern, operation, or program bytecode.
+use super::abi::{
+    NO_NODE, NativeEntryFrame as Frame, STATUS_ABI, STATUS_ADMISSION, STATUS_ARITHMETIC, STATUS_OK,
+};
+use super::control_abi::{NativeMatchDescriptor, STATUS_REJECT, VERSION};
+use super::memory::{NativeWordStorage, transport_bytes};
+use super::{NativeExecutionError, NativeExecutionLimits};
+use mech_core::ManagedMemoryBudget;
+use mech_engine::native_artifact::{NativeMatchOrigin, NativeScalarKind, NativeScalarValue};
+use std::ffi::c_void;
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum NativeMatchExecutionError {
+    Base(NativeExecutionError),
+    Work {
+        origin: Option<NativeMatchOrigin>,
+        required: u64,
+        limit: u64,
+    },
+    Visit {
+        previous: Option<u32>,
+        actual: u64,
+    },
+    Arithmetic {
+        origin: NativeMatchOrigin,
+    },
+    Unmatched {
+        origin: NativeMatchOrigin,
+    },
+}
+impl From<NativeExecutionError> for NativeMatchExecutionError {
+    fn from(value: NativeExecutionError) -> Self {
+        Self::Base(value)
+    }
+}
+impl std::fmt::Display for NativeMatchExecutionError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "canonical native Match execution: {self:?}")
+    }
+}
+impl std::error::Error for NativeMatchExecutionError {}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct NativeMatchExecutionReport {
+    pub work: u64,
+    pub transport_bytes: u64,
+    pub visits: u64,
+}
+fn invalid(reason: &'static str) -> NativeMatchExecutionError {
+    NativeExecutionError::Descriptor { reason }.into()
+}
+fn add(a: u64, b: u64) -> Result<u64, NativeMatchExecutionError> {
+    a.checked_add(b)
+        .ok_or_else(|| invalid("Match work overflow"))
+}
+fn mul(a: u64, b: u64) -> Result<u64, NativeMatchExecutionError> {
+    a.checked_mul(b)
+        .ok_or_else(|| invalid("Match work overflow"))
+}
+
+struct Context<'a> {
+    descriptor: &'a NativeMatchDescriptor,
+    previous: Option<u32>,
+    completed: bool,
+    work: u64,
+    limit: u64,
+    visits: u64,
+    error: Option<NativeMatchExecutionError>,
+}
+impl Context<'_> {
+    fn charge(
+        &mut self,
+        origin: Option<NativeMatchOrigin>,
+        work: u64,
+    ) -> Result<(), NativeMatchExecutionError> {
+        let required = self
+            .work
+            .checked_add(work)
+            .ok_or(NativeMatchExecutionError::Work {
+                origin,
+                required: u64::MAX,
+                limit: self.limit,
+            })?;
+        if required > self.limit {
+            return Err(NativeMatchExecutionError::Work {
+                origin,
+                required,
+                limit: self.limit,
+            });
+        }
+        self.work = required;
+        Ok(())
+    }
+    fn visit(&mut self, raw: u64) -> Result<(), NativeMatchExecutionError> {
+        let id = u32::try_from(raw).ok();
+        let allowed = !self.completed
+            && match self.previous {
+                None => id == Some(self.descriptor.entry),
+                Some(previous) => {
+                    id.is_some()
+                        && self.descriptor.visits[previous as usize]
+                            .successors
+                            .contains(&id)
+                }
+            };
+        if !allowed {
+            return Err(NativeMatchExecutionError::Visit {
+                previous: self.previous,
+                actual: raw,
+            });
+        }
+        let id = id.ok_or_else(|| invalid("Match visit id overflow"))?;
+        let site = self
+            .descriptor
+            .visits
+            .get(id as usize)
+            .ok_or_else(|| invalid("Match visit outside descriptor"))?;
+        let origin = site.origin;
+        let work = site.work;
+        let complete = site.complete;
+        self.charge(Some(origin), work)?;
+        self.previous = Some(id);
+        self.completed = complete;
+        self.visits = add(self.visits, 1)?;
+        Ok(())
+    }
+}
+unsafe extern "C" fn admit(context: *mut c_void, id: u64) -> u64 {
+    if context.is_null() {
+        return STATUS_ABI;
+    }
+    // SAFETY: only execute creates this callback context, for this synchronous
+    // invocation; generated code cannot retain or replace it.
+    let context = unsafe { &mut *context.cast::<Context<'_>>() };
+    if context.error.is_some() {
+        return STATUS_ADMISSION;
+    }
+    match context.visit(id) {
+        Ok(()) => STATUS_OK,
+        Err(error) => {
+            context.error = Some(error);
+            STATUS_ADMISSION
+        }
+    }
+}
+
+pub(super) fn execute<F: FnOnce(*mut Frame) -> u64>(
+    descriptor: &NativeMatchDescriptor,
+    entry: F,
+    inputs: &[NativeScalarValue],
+    outputs: &mut [NativeScalarValue],
+    limits: NativeExecutionLimits,
+    budget: Option<&ManagedMemoryBudget>,
+) -> Result<NativeMatchExecutionReport, NativeMatchExecutionError> {
+    if inputs.len() != descriptor.inputs.len() {
+        return Err(NativeExecutionError::InvalidInputs {
+            expected: descriptor.inputs.len(),
+            actual: inputs.len(),
+        }
+        .into());
+    }
+    if outputs.len() != descriptor.outputs.len() {
+        return Err(NativeExecutionError::InvalidOutputs {
+            expected: descriptor.outputs.len(),
+            actual: outputs.len(),
+        }
+        .into());
+    }
+    if descriptor.stack_bytes > limits.max_native_stack_bytes {
+        return Err(NativeExecutionError::StackLimit {
+            required: descriptor.stack_bytes,
+            limit: limits.max_native_stack_bytes,
+        }
+        .into());
+    }
+    let words = inputs
+        .len()
+        .checked_add(descriptor.value_count)
+        .and_then(|n| n.checked_add(outputs.len()))
+        .ok_or_else(|| invalid("Match transport count overflow"))?;
+    let bytes = transport_bytes(words)?;
+    if bytes > limits.max_transport_bytes {
+        return Err(NativeExecutionError::TransportLimit {
+            required: bytes,
+            limit: limits.max_transport_bytes,
+        }
+        .into());
+    }
+    let mut context = Context {
+        descriptor,
+        previous: None,
+        completed: false,
+        work: 0,
+        limit: limits.max_work,
+        visits: 0,
+        error: None,
+    };
+    // Setup funds managed zeroing, input type/encoding and generated input and
+    // constant copies, plus fixed header validation, before any such work.
+    let setup = add(
+        128,
+        add(
+            mul(words as u64, 4)?,
+            add(
+                mul(inputs.len() as u64, 16)?,
+                mul(descriptor.constant_count as u64, 8)?,
+            )?,
+        )?,
+    )?;
+    context.charge(None, setup)?;
+    let mut storage = NativeWordStorage::new(words, limits.max_transport_bytes, budget)?;
+    for (index, (value, ty)) in inputs.iter().zip(&descriptor.inputs).enumerate() {
+        if !matches!(
+            (value, ty.kind()),
+            (NativeScalarValue::Bool(_), NativeScalarKind::Bool)
+                | (NativeScalarValue::U64(_), NativeScalarKind::U64)
+        ) {
+            return Err(NativeExecutionError::InputType {
+                input: index,
+                expected: ty.kind(),
+            }
+            .into());
+        }
+    }
+    let (input_words, rest) = storage.values_mut().split_at_mut(inputs.len());
+    let (values, output_words) = rest.split_at_mut(descriptor.value_count);
+    for (word, value) in input_words.iter_mut().zip(inputs) {
+        *word = match value {
+            NativeScalarValue::Bool(value) => u64::from(*value),
+            NativeScalarValue::U64(value) => *value,
+        };
+    }
+    let input_pointer = input_words.as_ptr();
+    let local_pointer = values.as_mut_ptr();
+    let output_pointer = output_words.as_mut_ptr();
+    let context_pointer = (&mut context as *mut Context<'_>).cast::<c_void>();
+    let mut frame = Frame {
+        version: VERSION,
+        input_count: inputs.len() as u64,
+        local_count: descriptor.value_count as u64,
+        output_count: outputs.len() as u64,
+        inputs: input_pointer,
+        locals: local_pointer,
+        outputs: output_pointer,
+        context: context_pointer,
+        admit_next: admit,
+        error_node: NO_NODE,
+    };
+    let status = entry(&mut frame);
+    if let Some(error) = context.error.take() {
+        return Err(error);
+    }
+    if frame.version != VERSION
+        || frame.input_count != inputs.len() as u64
+        || frame.local_count != descriptor.value_count as u64
+        || frame.output_count != outputs.len() as u64
+        || frame.inputs != input_pointer
+        || frame.locals != local_pointer
+        || frame.outputs != output_pointer
+        || frame.context != context_pointer
+        || frame.admit_next as usize != admit as *const () as usize
+    {
+        return Err(invalid("Match entry changed immutable frame"));
+    }
+    match status {
+        STATUS_OK => {
+            if !context.completed || frame.error_node != NO_NODE {
+                return Err(invalid("Match entry omitted atomic completion"));
+            }
+        }
+        STATUS_ARITHMETIC | STATUS_REJECT => {
+            let id = context
+                .previous
+                .ok_or_else(|| invalid("Match failure before admitted visit"))?;
+            let site = &descriptor.visits[id as usize];
+            if frame.error_node != id as u64 {
+                return Err(invalid("Match failure origin mismatch"));
+            }
+            if status == STATUS_ARITHMETIC {
+                if !site.arithmetic {
+                    return Err(invalid("Match arithmetic outside primitive"));
+                }
+                return Err(NativeMatchExecutionError::Arithmetic {
+                    origin: site.origin,
+                });
+            }
+            return Err(NativeMatchExecutionError::Unmatched {
+                origin: site.origin,
+            });
+        }
+        _ => return Err(NativeExecutionError::InvalidStatus { status }.into()),
+    }
+    for (index, (&word, ty)) in output_words.iter().zip(&descriptor.outputs).enumerate() {
+        if ty.kind() == NativeScalarKind::Bool && word > 1 {
+            return Err(NativeExecutionError::InvalidOutputBool {
+                output: index,
+                value: word,
+            }
+            .into());
+        }
+    }
+    // All validation is complete. This final pass cannot fail or allocate.
+    for ((target, &word), ty) in outputs
+        .iter_mut()
+        .zip(output_words.iter())
+        .zip(&descriptor.outputs)
+    {
+        *target = match ty.kind() {
+            NativeScalarKind::Bool => NativeScalarValue::Bool(word != 0),
+            NativeScalarKind::U64 => NativeScalarValue::U64(word),
+        };
+    }
+    Ok(NativeMatchExecutionReport {
+        work: context.work,
+        transport_bytes: bytes,
+        visits: context.visits,
+    })
+}
+
