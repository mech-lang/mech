--- /dev/null
+++ b/src/engine/src/native_artifact/iteration.rs
@@ -0,0 +1,115 @@
+//! Read-only lowered native control graph with structurally owned counted loops.
+//!
+//! This is a compiler view of the ordinary canonical `ProgramArtifact`, never
+//! another language artifact. Constructors stay inside the engine's actual
+//! selected-implementation lowering path.
+use super::{NativeMatchAction, NativeMatchOrigin, NativeMatchTerminator, NativeMatchValue};
+
+/// The lexical invocation that owns an immutable result word. Carrier words
+/// have a separate role: only their own initializer and latch may replace them.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum NativeIterationValueScope {
+    Immutable { iteration: Option<u32> },
+    Carrier { iteration: u32 },
+}
+
+#[derive(Clone, Debug)]
+pub enum NativeIterationAction {
+    Scalar(NativeMatchAction),
+    Initialize { iteration: u32 },
+    Latch { iteration: u32 },
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum NativeIterationTerminator {
+    Scalar(NativeMatchTerminator),
+    Header {
+        iteration: u32,
+        body: u32,
+        exit: u32,
+    },
+}
+
+impl From<NativeMatchTerminator> for NativeIterationTerminator {
+    fn from(value: NativeMatchTerminator) -> Self {
+        Self::Scalar(value)
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct NativeIterationBlock {
+    pub(crate) origin: NativeMatchOrigin,
+    pub(crate) action: NativeIterationAction,
+    pub(crate) terminator: NativeIterationTerminator,
+    pub(crate) iteration: Option<u32>,
+}
+impl NativeIterationBlock {
+    pub const fn origin(&self) -> NativeMatchOrigin {
+        self.origin
+    }
+    pub fn action(&self) -> &NativeIterationAction {
+        &self.action
+    }
+    pub const fn terminator(&self) -> NativeIterationTerminator {
+        self.terminator
+    }
+    pub const fn iteration(&self) -> Option<u32> {
+        self.iteration
+    }
+}
+
+/// One literal-count carrier transition, linked to its exact lexical body.
+/// Private scalar carrier and counter storage is independent of `count`.
+#[derive(Clone, Debug)]
+pub struct NativeIterationLoop {
+    pub(crate) origin: NativeMatchOrigin,
+    pub(crate) count: u64,
+    pub(crate) parent: Option<u32>,
+    pub(crate) seed: NativeMatchValue,
+    pub(crate) carrier: NativeMatchValue,
+    pub(crate) next: NativeMatchValue,
+    pub(crate) result: NativeMatchValue,
+    pub(crate) initialize: u32,
+    pub(crate) header: u32,
+    pub(crate) body: u32,
+    pub(crate) latch: u32,
+    pub(crate) exit: u32,
+}
+impl NativeIterationLoop {
+    pub const fn origin(&self) -> NativeMatchOrigin {
+        self.origin
+    }
+    pub const fn count(&self) -> u64 {
+        self.count
+    }
+    pub const fn parent(&self) -> Option<u32> {
+        self.parent
+    }
+    pub const fn seed(&self) -> NativeMatchValue {
+        self.seed
+    }
+    pub const fn carrier(&self) -> NativeMatchValue {
+        self.carrier
+    }
+    pub const fn next(&self) -> NativeMatchValue {
+        self.next
+    }
+    pub const fn result(&self) -> NativeMatchValue {
+        self.result
+    }
+    pub const fn initialize(&self) -> u32 {
+        self.initialize
+    }
+    pub const fn header(&self) -> u32 {
+        self.header
+    }
+    pub const fn body(&self) -> u32 {
+        self.body
+    }
+    pub const fn latch(&self) -> u32 {
+        self.latch
+    }
+    pub const fn exit(&self) -> u32 {
+        self.exit
+    }
+}
diff --git a/src/engine/src/native_artifact/iteration_validation.rs b/src/engine/src/native_artifact/iteration_validation.rs
new file mode 100644
index 000000000..ad7f7fe70
--- /dev/null
+++ b/src/engine/src/native_artifact/iteration_validation.rs
@@ -0,0 +1,390 @@
+//! Current-visit definition proof for structurally owned counted loops.
+//! Backedges are validated only through a declared loop. Each lexical body is
+//! checked once as an acyclic graph, beginning with ancestors plus its carrier;
+//! previous-visit body locals are never part of that initial definition set.
+use super::{
+    NativeIterationAction as Action, NativeIterationArtifactPlan as Plan,
+    NativeIterationTerminator as Terminator, NativeIterationValueScope as Scope,
+    NativeMatchAction as Scalar, NativeMatchTerminator as Term, NativeMatchValue as Value,
+    NativeScalarKind, NativeScalarValue,
+};
+use std::collections::VecDeque;
+
+const BAD: &str = "invalid counted-loop ownership or current-visit definitions";
+const ANALYSIS_CELLS: usize = 16 * 1024 * 1024;
+fn scalar_successors(term: Term) -> [Option<u32>; 2] {
+    match term {
+        Term::Jump(next) => [Some(next), None],
+        Term::Branch { yes, no, .. } | Term::LiteralBranch { yes, no, .. } => [Some(yes), Some(no)],
+        Term::Complete | Term::Reject => [None, None],
+    }
+}
+fn scope_ancestor(plan: &Plan, ancestor: Option<u32>, mut scope: Option<u32>) -> bool {
+    // Loop ids are pre-order; every parent must be earlier. The caller first
+    // validates this property, so the walk cannot cycle.
+    loop {
+        if scope == ancestor {
+            return true;
+        }
+        let Some(id) = scope else {
+            return false;
+        };
+        scope = plan.iterations()[id as usize].parent();
+    }
+}
+fn readable(plan: &Plan, value: Value, scope: Option<u32>, block: usize) -> bool {
+    match plan.value_scopes().get(value.get() as usize) {
+        Some(Scope::Immutable { iteration }) => scope_ancestor(plan, *iteration, scope),
+        Some(Scope::Carrier { iteration }) => {
+            scope_ancestor(plan, Some(*iteration), scope)
+                || plan.iterations()[*iteration as usize].exit() as usize == block
+        }
+        None => false,
+    }
+}
+
+/// Called before the opaque engine plan is returned, including runtime-only
+/// same-Object rederivation. No caller can construct or mutate a certified plan.
+pub(super) fn validate(plan: &Plan) -> Result<(), &'static str> {
+    let blocks = plan.blocks();
+    let count = plan.values().len();
+    if plan.entry() as usize >= blocks.len()
+        || plan.value_scopes().len() != count
+        || blocks
+            .len()
+            .checked_mul(count)
+            .is_none_or(|n| n > ANALYSIS_CELLS)
+    {
+        return Err(BAD);
+    }
+    let ty = |v: Value| plan.values().get(v.get() as usize).ok_or(BAD);
+    let mut initial = vec![false; count];
+    for input in plan.inputs() {
+        let id = input.value().get() as usize;
+        if ty(input.value())? != input.declaration().ty()
+            || plan.value_scopes()[id] != (Scope::Immutable { iteration: None })
+            || initial[id]
+        {
+            return Err(BAD);
+        }
+        initial[id] = true;
+    }
+    for constant in plan.constants() {
+        let id = constant.value().get() as usize;
+        let kind = match constant.scalar() {
+            NativeScalarValue::Bool(_) => NativeScalarKind::Bool,
+            NativeScalarValue::U64(_) => NativeScalarKind::U64,
+        };
+        if ty(constant.value())?.kind() != kind
+            || plan.value_scopes()[id] != (Scope::Immutable { iteration: None })
+            || initial[id]
+        {
+            return Err(BAD);
+        }
+        initial[id] = true;
+    }
+    let mut roles = vec![None; blocks.len()];
+    for (id, iteration) in plan.iterations().iter().enumerate() {
+        if iteration
+            .parent()
+            .is_some_and(|parent| parent as usize >= id)
+        {
+            return Err(BAD);
+        }
+        let mut depth = 0;
+        let mut parent = iteration.parent();
+        while let Some(p) = parent {
+            depth += 1;
+            if depth > crate::MAX_CONTROL_DEPTH {
+                return Err(BAD);
+            }
+            parent = plan.iterations()[p as usize].parent();
+        }
+        if ty(iteration.seed())? != ty(iteration.carrier())?
+            || ty(iteration.next())? != ty(iteration.carrier())?
+            || ty(iteration.result())? != ty(iteration.carrier())?
+            || plan.value_scopes()[iteration.carrier().get() as usize]
+                != (Scope::Carrier {
+                    iteration: id as u32,
+                })
+        {
+            return Err(BAD);
+        }
+        for (block, role) in [
+            (iteration.initialize(), 0),
+            (iteration.header(), 1),
+            (iteration.latch(), 2),
+            (iteration.exit(), 3),
+        ] {
+            let entry = roles.get_mut(block as usize).ok_or(BAD)?;
+            if entry.replace((id as u32, role)).is_some() {
+                return Err(BAD);
+            }
+        }
+        let init = &blocks[iteration.initialize() as usize];
+        let header = &blocks[iteration.header() as usize];
+        let latch = &blocks[iteration.latch() as usize];
+        let exit = &blocks[iteration.exit() as usize];
+        if init.iteration() != iteration.parent()
+            || !matches!(init.action(),Action::Initialize { iteration: n } if *n == id as u32)
+            || init.terminator() != Terminator::Scalar(Term::Jump(iteration.header()))
+            || header.iteration() != Some(id as u32)
+            || !matches!(header.action(), Action::Scalar(Scalar::None))
+            || header.terminator()
+                != (Terminator::Header {
+                    iteration: id as u32,
+                    body: iteration.body(),
+                    exit: iteration.exit(),
+                })
+            || latch.iteration() != Some(id as u32)
+            || !matches!(latch.action(),Action::Latch { iteration:n } if *n == id as u32)
+            || latch.terminator() != Terminator::Scalar(Term::Jump(iteration.header()))
+            || exit.iteration() != iteration.parent()
+            || !matches!(exit.action(), Action::Scalar(Scalar::Copy { source,output })
+                if *source==iteration.carrier() && *output==iteration.result())
+            || blocks
+                .get(iteration.body() as usize)
+                .ok_or(BAD)?
+                .iteration()
+                != Some(id as u32)
+        {
+            return Err(BAD);
+        }
+    }
+    for (id, scope) in plan.value_scopes().iter().enumerate() {
+        let owner = match scope {
+            Scope::Immutable { iteration } => *iteration,
+            Scope::Carrier { iteration } => Some(*iteration),
+        };
+        if owner.is_some_and(|n| n as usize >= plan.iterations().len()) {
+            return Err(BAD);
+        }
+        if let Scope::Carrier { iteration } = scope {
+            if plan.iterations()[*iteration as usize].carrier().get() as usize != id {
+                return Err(BAD);
+            }
+        }
+    }
+    // Check every structural edge, including dormant literal arms. Entry into
+    // a child scope is exclusively its initializer; exit is exclusively header.
+    for (id, block) in blocks.iter().enumerate() {
+        if block
+            .iteration()
+            .is_some_and(|n| n as usize >= plan.iterations().len())
+        {
+            return Err(BAD);
+        }
+        let successors = match block.terminator() {
+            Terminator::Scalar(term) => scalar_successors(term),
+            Terminator::Header { body, exit, .. } => [Some(body), Some(exit)],
+        };
+        for next in successors.into_iter().flatten() {
+            let next_block = blocks.get(next as usize).ok_or(BAD)?;
+            let special = match roles.get(next as usize).copied().flatten() {
+                Some((loop_id, 1)) => {
+                    id == plan.iterations()[loop_id as usize].initialize() as usize
+                        || id == plan.iterations()[loop_id as usize].latch() as usize
+                }
+                Some((loop_id, 3)) => id == plan.iterations()[loop_id as usize].header() as usize,
+                _ => block.iteration() == next_block.iteration(),
+            };
+            if !special {
+                return Err(BAD);
+            }
+        }
+        if let Terminator::Header { iteration, .. } = block.terminator() {
+            if roles[id] != Some((iteration, 1)) {
+                return Err(BAD);
+            }
+        }
+        match block.action() {
+            Action::Initialize { iteration } if roles[id] != Some((*iteration, 0)) => {
+                return Err(BAD);
+            }
+            Action::Latch { iteration } if roles[id] != Some((*iteration, 2)) => return Err(BAD),
+            Action::Scalar(Scalar::Primitive {
+                operands, output, ..
+            }) => {
+                ty(*output)?;
+                if operands.iter().any(|v| ty(*v).is_err()) {
+                    return Err(BAD);
+                }
+            }
+            Action::Scalar(Scalar::Copy { source, output }) if ty(*source)? != ty(*output)? => {
+                return Err(BAD);
+            }
+            _ => {}
+        }
+        match block.terminator() {
+            Terminator::Scalar(Term::Branch { condition, .. })
+                if ty(condition)?.kind() != NativeScalarKind::Bool =>
+            {
+                return Err(BAD);
+            }
+            Terminator::Scalar(Term::LiteralBranch { left, right, .. })
+                if ty(left)? != ty(right)? =>
+            {
+                return Err(BAD);
+            }
+            Terminator::Scalar(Term::Complete) if block.iteration().is_some() => return Err(BAD),
+            _ => {}
+        }
+    }
+    let mut visited = vec![false; blocks.len()];
+    check_scope(plan, None, plan.entry(), initial, &roles, &mut visited)?;
+    // Unreachable fail-closed Reject blocks still have checked structure/types;
+    // no operation with a read or write is silently omitted from the proof.
+    for (id, block) in blocks.iter().enumerate() {
+        if !visited[id]
+            && !(matches!(block.action(), Action::Scalar(Scalar::None))
+                && matches!(block.terminator(), Terminator::Scalar(Term::Reject)))
+        {
+            return Err(BAD);
+        }
+    }
+    Ok(())
+}
+fn check_scope(
+    plan: &Plan,
+    scope: Option<u32>,
+    entry: u32,
+    initial: Vec<bool>,
+    roles: &[Option<(u32, u8)>],
+    visited: &mut [bool],
+) -> Result<(), &'static str> {
+    let mut incoming = vec![Vec::new(); plan.blocks().len()];
+    let mut degrees = vec![0usize; plan.blocks().len()];
+    let mut reachable = vec![false; plan.blocks().len()];
+    let mut pending = vec![entry];
+    while let Some(id) = pending.pop() {
+        if std::mem::replace(&mut reachable[id as usize], true) {
+            continue;
+        }
+        if plan.blocks()[id as usize].iteration() != scope {
+            return Err(BAD);
+        }
+        for next in collapsed_successors(plan, id).into_iter().flatten() {
+            incoming[next as usize].push(id as usize);
+            degrees[next as usize] = degrees[next as usize].checked_add(1).ok_or(BAD)?;
+            pending.push(next);
+        }
+    }
+    let mut ends = vec![Vec::new(); plan.blocks().len()];
+    let mut ready = (0..degrees.len())
+        .filter(|&i| reachable[i] && degrees[i] == 0)
+        .collect::<VecDeque<_>>();
+    let mut seen = 0;
+    while let Some(id) = ready.pop_front() {
+        seen += 1;
+        visited[id] = true;
+        let block = &plan.blocks()[id];
+        let mut known = if let Some(&first) = incoming[id].first() {
+            ends[first].clone()
+        } else {
+            initial.clone()
+        };
+        for &previous in incoming[id].iter().skip(1) {
+            for (bit, &other) in known.iter_mut().zip(&ends[previous]) {
+                *bit &= other;
+            }
+        }
+        let read = |v: Value, known: &[bool]| -> Result<(), &'static str> {
+            if known.get(v.get() as usize).copied().unwrap_or(false) && readable(plan, v, scope, id)
+            {
+                Ok(())
+            } else {
+                Err(BAD)
+            }
+        };
+        match block.action() {
+            Action::Initialize { iteration } => {
+                let child = &plan.iterations()[*iteration as usize];
+                read(child.seed(), &known)?;
+                let mut body_initial = known.clone();
+                body_initial[child.carrier().get() as usize] = true;
+                // The header is not part of the body DAG; it owns the only
+                // backedge and always dispatches before a fresh body visit.
+                visited[child.header() as usize] = true;
+                check_scope(
+                    plan,
+                    Some(*iteration),
+                    child.body(),
+                    body_initial,
+                    roles,
+                    visited,
+                )?;
+                known[child.carrier().get() as usize] = true;
+            }
+            Action::Latch { iteration } => {
+                read(plan.iterations()[*iteration as usize].next(), &known)?
+            }
+            Action::Scalar(action) => {
+                let output = match action {
+                    Scalar::Primitive {
+                        operands, output, ..
+                    } => {
+                        for &value in operands {
+                            read(value, &known)?;
+                        }
+                        Some(*output)
+                    }
+                    Scalar::Copy { source, output } => {
+                        read(*source, &known)?;
+                        Some(*output)
+                    }
+                    Scalar::None => None,
+                };
+                if let Some(output) = output {
+                    let ordinal = output.get() as usize;
+                    if known[ordinal]
+                        || plan.value_scopes()[ordinal] != (Scope::Immutable { iteration: scope })
+                    {
+                        return Err(BAD);
+                    }
+                    known[ordinal] = true;
+                }
+            }
+        }
+        if let Terminator::Scalar(term) = block.terminator() {
+            match term {
+                Term::Branch { condition, .. } => read(condition, &known)?,
+                Term::LiteralBranch { left, right, .. } => {
+                    read(left, &known)?;
+                    read(right, &known)?;
+                }
+                Term::Complete => {
+                    for output in plan.outputs() {
+                        read(output.value(), &known)?;
+                        if plan.values()[output.value().get() as usize] != *output.ty() {
+                            return Err(BAD);
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+        ends[id] = known;
+        for next in collapsed_successors(plan, id).into_iter().flatten() {
+            degrees[next as usize] -= 1;
+            if degrees[next as usize] == 0 {
+                ready.push_back(next as usize);
+            }
+        }
+    }
+    if seen != reachable.into_iter().filter(|v| *v).count() {
+        return Err(BAD);
+    }
+    Ok(())
+}
+fn collapsed_successors(plan: &Plan, id: u32) -> [Option<u32>; 2] {
+    match plan.blocks()[id as usize].action() {
+        Action::Initialize { iteration } => {
+            [Some(plan.iterations()[*iteration as usize].exit()), None]
+        }
+        Action::Latch { .. } => [None, None],
+        _ => match plan.blocks()[id as usize].terminator() {
+            Terminator::Scalar(term) => scalar_successors(term),
+            Terminator::Header { .. } => [None, None],
+        },
+    }
+}
