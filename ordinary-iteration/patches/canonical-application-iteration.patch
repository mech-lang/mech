+//! Ordinary application stages share the resumable recursive expression owner.
+use super::*;
+
+pub(super) fn supports(rule: RuleId) -> bool {
+    matches!(rule, rules::APPLICATION_STAGE | rules::APPLICATION_OPERATOR)
+}
