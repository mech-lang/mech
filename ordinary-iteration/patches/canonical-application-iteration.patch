+#[test]
+fn a_complete_comprehension_seed_uses_the_normal_unary_library_declaration() {
+    let source = "+> sequence\n[x + 1u64 | x <- values<[u64]>] |> sequence/length\n";
+    let catalog = mech_stdlib::source_catalog();
