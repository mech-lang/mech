{
  "schema": "mech.canonical-control-matrix-captures.v1",
  "source_parent_commit": "dfde3a64a",
  "scope": "Canonical source and original/decoded resident artifacts with live matrix lexical captures, nested control-local geometry, and canonical scalar Match result schemas.",
  "changes": [
    "Rank-two scalar-element matrices with Turn dimensions may be lexical captures backed by validated canonical snapshots.",
    "Suspended captures retain their original snapshot geometry while fresh live inputs use current geometry.",
    "Snapshot retention measurement uses the immutable schema table owned by the retained value.",
    "Runtime-shaped control locals do not claim activation-fixed geometry from their lower-bound allocation seed.",
    "Match result compatibility compares finalized canonical schemas; unused source-axis declarations do not distinguish equal scalar results."
  ],
  "preserved_requirements": [
    "Closed scrutinee, pattern-binding and result gates remain separate from lexical matrix capture eligibility.",
    "Inactive branches remain lazy; admitted capture failures preserve the publication and allow later recovery.",
    "Activation-lifetime and unsupported-rank matrix captures do not gain eligibility.",
    "Different scalar kinds and different fixed result geometries remain incompatible."
  ],
