  n-body-scene := {
    width: 860
    height: 770
    background: "#080b12"
    circles: scene-circles
    point-sets: scene-point-sets
    lines: scene-lines
    line-strips: scene-line-strips
    texts: scene-text
  }

  @scene/replace <- n-body-scene
  total-energy
