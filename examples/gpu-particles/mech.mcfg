config := {
  runtime: {
    execution: {
      resident-routing: "require-resident"
    }

    limits: {
      max-turn-duration-ms: 10000
    }
  }

  hosts: [
    {
      name: "clock"
      provider: "timer"
      settings: {
        frequency-hz: 60
        max-catch-up-steps: 1
      }
    }

    {
      name: "particles"
      provider: "gpu"
      settings: {
        region: "particle-field"
      }
    }

    {
      name: "console"
      provider: "console"
      settings: {}
    }
  ]

  run: {
    paths: ["particles.mec"]

    grants: [
      {
        target: "clock/tick"
        operations: ["read"]
        paths: ["tick"]
      }

      {
        target: "particles/kernel"
        operations: ["read", "write"]
        paths: ["turns", "dispatch-ms", "turn"]
      }

      {
        target: "console/output"
        operations: ["write"]
        paths: ["line"]
      }
    ]
  }
}
