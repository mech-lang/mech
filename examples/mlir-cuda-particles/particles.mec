-- Each column is an independent particle lane. All six state vectors remain
-- resident on the selected device across turns.

~x<[f64]:1,65536> := 0.25
~y<[f64]:1,65536> := 0.0 - 0.40
~z<[f64]:1,65536> := 0.15
~vx<[f64]:1,65536> := 0.010
~vy<[f64]:1,65536> := 0.0 - 0.020
~vz<[f64]:1,65536> := 0.015

dt := 0.004
drag := 0.9995

r2 := x * x + y * y + z * z + 0.75
inverse := 1.0 / r2
inverse2 := inverse * inverse
radial := (0.0 - 0.2) * inverse2

ax := x * radial + y * 0.03
ay := y * radial - x * 0.03
az := z * radial

next-vx := (vx + ax * dt) * drag
next-vy := (vy + ay * dt) * drag
next-vz := (vz + az * dt) * drag

next-x := x + next-vx * dt
next-y := y + next-vy * dt
next-z := z + next-vz * dt

vx = next-vx
vy = next-vy
vz = next-vz
x = next-x
y = next-y
z = next-z

x
