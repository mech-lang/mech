-- This is the ordinary transactional CPU graph. Its committed timer turn
-- produces an after-commit dispatch to the configured GPU host.
@clock := timer://clock/tick{:read(tick)}
@particles := gpu://particles/kernel{:read(adapter), :read(turns), :read(dispatch-ms), :write(input/force-x), :write(input/force-y), :write(input/force-enabled), :write(input/dt), :write(turn)}
@out := console://console/output{:write(line)}

tick := @clock/tick
adapter := @particles/adapter
gpu-turns := @particles/turns
dispatch-ms := @particles/dispatch-ms

-- These controls deliberately live in the regular CPU graph. A window host
-- can replace these expressions with live pointer resource reads.
force-x := tick * 0.001 - 0.5
force-y := 0.2
force-enabled := 1.0
dt := 0.016

@particles/input/force-x <- force-x
@particles/input/force-y <- force-y
@particles/input/force-enabled <- force-enabled
@particles/input/dt <- dt
@particles/turn <- tick
@out/line <- (tick, gpu-turns, dispatch-ms, adapter)
