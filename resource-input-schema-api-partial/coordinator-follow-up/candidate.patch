+    /// Resolve geometry in the target schema's own dimension environment.
+    /// The planning value seeds activation geometry; only Turn declarations
+    /// permit later observations to differ from that seed.
+    fn rebind_observation_value(
+        &self,
+        observation: &super::BoundResidentObservation,
+        value: &Value,
+    ) -> MResult<Value> {
+        let target = self.instance().plan.slots.iter().find(|slot| {
+            slot.artifact_id == observation.input.artifact_slot
+        }).ok_or_else(|| invalid_value("observation slot is unavailable".to_owned()))?;
+        let schema = self.artifact.schemas().get(observation.input.schema).ok_or_else(|| {
+            invalid_value("observation schema is unavailable".to_owned())
+        })?;
+        if target.schema != observation.input.schema
+            || target.schema_key != observation.input.schema_key
+            || target.shape != observation.input.shape
+            || schema.key() != observation.input.schema_key
+        {
+            return Err(invalid_value("observation differs from its activated slot".to_owned()));
+        }
+        let source_schemas = value.schemas().ok_or_else(|| {
+            invalid_value("observation value has no schema owner".to_owned())
+        })?;
+        value.validate_against(&source_schemas)?;
+        let source_schema = source_schemas.get(value.schema()).ok_or_else(|| {
+            invalid_value("observation value schema is unavailable".to_owned())
+        })?;
+        let actual_body = source_schema.closed_body(value.shape())?;
+        let shape = mech_core::shape_for_schema_components(
+            schema,
+            &[(schema.body(), actual_body)],
+            None,
+        ).map_err(|error| invalid_value(format!(
+            "observation geometry does not satisfy its declared schema: {error:?}"
+        )))?;
+        if (target.activation_fixed_shape && shape != target.shape)
+            || !mech_core::shape_change_allowed(schema, &target.shape, &shape)
+        {
+            return Err(invalid_value("observation changes fixed activation geometry".to_owned()));
+        }
+        value.rebind(observation.input.schema, &shape, self.artifact.schemas())
+    }
