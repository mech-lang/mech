{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mech-lang.org/schemas/value-system-current-inventory-v5.json",
  "additionalProperties": false,
  "properties": {
    "enums": {
      "additionalProperties": false,
      "properties": {
        "Kind": { "$ref": "#/$defs/enumInventory" },
        "Value": { "$ref": "#/$defs/valueEnumInventory" },
        "ValueKind": { "$ref": "#/$defs/enumInventory" }
      },
      "required": ["Value", "ValueKind", "Kind"],
      "type": "object"
    },
    "high_risk_api_uses": {
      "additionalProperties": { "$ref": "#/$defs/useList" },
      "type": "object"
    },
    "identity_mechanisms": {
      "items": { "$ref": "#/$defs/mechanism" },
      "type": "array"
    },
    "journal_mechanisms": {
      "items": { "$ref": "#/$defs/mechanism" },
      "type": "array"
    },
    "auxiliary_rust_fixtures": {
      "items": { "$ref": "#/$defs/auxiliaryRustFixture" },
      "type": "array"
    },
    "auxiliary_cargo_fixtures": {
      "items": { "$ref": "#/$defs/auxiliaryCargoFixture" },
      "type": "array"
    },
    "enumerated_rust_files": {
      "items": { "minLength": 1, "type": "string" },
      "minItems": 1,
      "type": "array"
    },
    "audited_rust_files": {
      "items": { "minLength": 1, "type": "string" },
      "minItems": 1,
      "type": "array"
    },
    "legacy_aliases": {
      "items": { "$ref": "#/$defs/legacyAlias" },
      "type": "array"
    },
    "required_compatibility_aliases": {
      "items": { "$ref": "#/$defs/compatibilityAlias" },
      "type": "array"
    },
    "raw_approved_aliases": {
      "items": { "$ref": "#/$defs/approvedAlias" },
      "type": "array"
    },
    "reference_commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "schema_version": { "const": 5 },
    "workspace_packages": {
      "items": { "$ref": "#/$defs/workspacePackage" },
      "minItems": 1,
      "type": "array"
    },
    "type_contract_sources": {
      "additionalProperties": false,
      "properties": {
        "kind_expression_sources": {
          "items": { "$ref": "#/$defs/typeContractSource" },
          "minItems": 1,
          "type": "array"
        },
        "kind_scheme_sources": {
          "items": { "$ref": "#/$defs/typeContractSource" },
          "minItems": 1,
          "type": "array"
        },
        "runtime_representation_sources": {
          "items": { "$ref": "#/$defs/typeContractSource" },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "kind_expression_sources",
        "kind_scheme_sources",
        "runtime_representation_sources"
      ],
      "type": "object"
    },
    "variant_uses": {
      "items": { "$ref": "#/$defs/variantUse" },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "reference_commit",
    "workspace_packages",
    "enumerated_rust_files",
    "audited_rust_files",
    "enums",
    "variant_uses",
    "type_contract_sources",
    "auxiliary_rust_fixtures",
    "auxiliary_cargo_fixtures",
    "legacy_aliases",
    "required_compatibility_aliases",
    "raw_approved_aliases",
    "identity_mechanisms",
    "journal_mechanisms",
    "high_risk_api_uses"
  ],
  "type": "object",
  "$defs": {
    "workspacePackage": {
      "additionalProperties": false,
      "properties": {
        "directory": { "minLength": 1, "type": "string" },
        "manifest": { "pattern": "(?:^|/)Cargo\\.toml$", "type": "string" },
        "name": { "minLength": 1, "type": "string" },
        "rust_file_count": { "minimum": 1, "type": "integer" }
      },
      "required": ["name", "manifest", "directory", "rust_file_count"],
      "type": "object"
    },
    "enumInventory": {
      "additionalProperties": false,
      "properties": {
        "source": { "minLength": 1, "type": "string" },
        "variants": {
          "items": { "$ref": "#/$defs/enumVariant" },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": ["source", "variants"],
      "type": "object"
    },
    "enumVariant": {
      "additionalProperties": false,
      "properties": {
        "cfg": { "type": ["string", "null"] },
        "name": { "minLength": 1, "type": "string" },
        "payload_type": { "type": ["string", "null"] }
      },
      "required": ["name", "cfg", "payload_type"],
      "type": "object"
    },
    "auxiliaryRustFixture": {
      "additionalProperties": false,
      "properties": {
        "driver": { "minLength": 1, "type": "string" },
        "method": { "enum": ["compile_fail", "pass"] },
        "paths": {
          "items": { "minLength": 1, "type": "string" },
          "type": "array"
        },
        "reachable_rust_files": {
          "items": { "minLength": 1, "type": "string" },
          "minItems": 1,
          "type": "array"
        },
        "pattern": { "minLength": 1, "type": "string" }
      },
      "required": ["driver", "method", "pattern", "paths", "reachable_rust_files"],
      "type": "object"
    },
    "auxiliaryCargoTarget": {
      "additionalProperties": false,
      "properties": {
        "kinds": { "items": { "type": "string" }, "minItems": 1, "type": "array" },
        "name": { "minLength": 1, "type": "string" },
        "reachable_rust_files": { "items": { "minLength": 1, "type": "string" }, "minItems": 1, "type": "array" },
        "root": { "minLength": 1, "type": "string" }
      },
      "required": ["name", "kinds", "root", "reachable_rust_files"],
      "type": "object"
    },
    "auxiliaryCargoFixture": {
      "additionalProperties": false,
      "properties": {
        "manifest": { "pattern": "(?:^|/)Cargo\\.toml$", "type": "string" },
        "package": { "minLength": 1, "type": "string" },
        "targets": { "items": { "$ref": "#/$defs/auxiliaryCargoTarget" }, "minItems": 1, "type": "array" }
      },
      "required": ["manifest", "package", "targets"],
      "type": "object"
    },
    "approvedAlias": {
      "additionalProperties": true,
      "properties": {
        "column": { "minimum": 1, "type": "integer" },
        "line": { "minimum": 1, "type": "integer" },
        "name": { "enum": ["MutableReference", "ValRef", "SymbolTableRef", "InterpreterRef"] },
        "path": { "minLength": 1, "type": "string" },
        "raw_name": { "minLength": 1, "type": "string" },
        "target": { "minLength": 1, "type": "string" },
        "visibility": { "enum": ["pub", "private"] }
      },
      "required": ["name", "raw_name", "target", "path", "line", "column", "visibility"],
      "type": "object"
    },
    "legacyAlias": {
      "additionalProperties": false,
      "properties": {
        "line": { "minimum": 1, "type": "integer" },
        "column": { "minimum": 1, "type": "integer" },
        "name": { "enum": ["MutableReference", "ValRef"] },
        "path": { "minLength": 1, "type": "string" },
        "raw_name": { "minLength": 1, "type": "string" },
        "target": { "minLength": 1, "type": "string" },
        "visibility": { "const": "pub" }
      },
      "required": ["name", "raw_name", "target", "path", "line", "column", "visibility"],
      "type": "object"
    },
    "reexportRoute": {
      "additionalProperties": false,
      "properties": {
        "declaration": { "minLength": 1, "type": "string" },
        "line": { "minimum": 1, "type": "integer" },
        "path": { "minLength": 1, "type": "string" }
      },
      "required": ["path", "line", "declaration"],
      "type": "object"
    },
    "compatibilityAlias": {
      "additionalProperties": false,
      "properties": {
        "column": { "minimum": 1, "type": "integer" },
        "line": { "minimum": 1, "type": "integer" },
        "name": { "enum": ["SymbolTableRef", "InterpreterRef"] },
        "path": { "minLength": 1, "type": "string" },
        "public_reexport_route": { "items": { "$ref": "#/$defs/reexportRoute" }, "minItems": 1, "type": "array" },
        "raw_name": { "minLength": 1, "type": "string" },
        "target": { "minLength": 1, "type": "string" },
        "visibility": { "const": "pub" }
      },
      "required": ["name", "raw_name", "target", "path", "line", "column", "visibility", "public_reexport_route"],
      "type": "object"
    },
    "mechanism": {
      "additionalProperties": false,
      "properties": {
        "id": { "minLength": 1, "type": "string" },
        "pattern": { "minLength": 1, "type": "string" },
        "uses": { "$ref": "#/$defs/useList" }
      },
      "required": ["id", "pattern", "uses"],
      "type": "object"
    },
    "site": {
      "additionalProperties": false,
      "properties": {
        "column": { "minimum": 1, "type": "integer" },
        "fingerprint": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
        "line": { "minimum": 1, "type": "integer" }
      },
      "required": ["line", "column", "fingerprint"],
      "type": "object"
    },
    "use": {
      "additionalProperties": false,
      "properties": {
        "count": { "minimum": 1, "type": "integer" },
        "path": { "minLength": 1, "type": "string" },
        "sites": {
          "items": { "$ref": "#/$defs/site" },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": ["path", "sites", "count"],
      "type": "object"
    },
    "useList": {
      "items": { "$ref": "#/$defs/use" },
      "type": "array"
    },
    "typeContractSource": {
      "additionalProperties": false,
      "properties": {
        "implementation_gate": {
          "enum": ["C1", "existing-runtime-contract"]
        },
        "path": { "minLength": 1, "type": "string" },
        "source_kind": { "enum": ["declaration", "field"] },
        "source_form": { "minLength": 1, "type": "string" },
        "symbol": { "minLength": 1, "type": "string" },
        "target": {
          "enum": [
            "KindExpr",
            "KindScheme",
            "RuntimeRepresentationSignature and native-lowering metadata"
          ]
        }
      },
      "required": [
        "path",
        "symbol",
        "source_kind",
        "source_form",
        "target",
        "implementation_gate"
      ],
      "type": "object"
    },
    "valueEnumInventory": {
      "additionalProperties": false,
      "properties": {
        "source": { "const": "src/core/src/value.rs" },
        "variants": {
          "items": { "$ref": "#/$defs/valueVariant" },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": ["source", "variants"],
      "type": "object"
    },
    "valueVariant": {
      "additionalProperties": false,
      "properties": {
        "cfg": { "type": ["string", "null"] },
        "current_roles": {
          "items": { "minLength": 1, "type": "string" },
          "minItems": 1,
          "type": "array"
        },
        "name": { "minLength": 1, "type": "string" },
        "payload_type": { "type": ["string", "null"] },
        "storage_ownership": { "minLength": 1, "type": "string" }
      },
      "required": [
        "name",
        "cfg",
        "payload_type",
        "storage_ownership",
        "current_roles"
      ],
      "type": "object"
    },
    "variantUse": {
      "additionalProperties": false,
      "properties": {
        "column": { "minimum": 1, "type": "integer" },
        "enum": { "enum": ["Value", "ValueKind", "Kind"] },
        "line": { "minimum": 1, "type": "integer" },
        "path": { "minLength": 1, "type": "string" },
        "variant": { "minLength": 1, "type": "string" }
      },
      "required": ["enum", "variant", "path", "line", "column"],
      "type": "object"
    }
  }
}
