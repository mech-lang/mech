{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mech-lang.org/schemas/c2-legacy-adapter-boundary-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scanner",
    "boundary",
    "policy",
    "uses"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "module", "implementation_sha256"],
      "properties": {
        "version": {"const": "c2-legacy-growth-v2"},
        "module": {"const": "scripts/value_system_legacy_scanner_v2.py"},
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "boundary": {
      "const": "src/core/src/legacy_adapter/value.rs"
    },
    "policy": {
      "const": "frozen-boundary-only-uses-may-only-shrink-v1"
    },
    "uses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "identifier", "count", "sites"],
        "properties": {
          "category": {
            "enum": [
              "legacy-value",
              "legacy-value-kind",
              "legacy-ref-allocation",
              "cycle-guard-address"
            ]
          },
          "identifier": {
            "enum": ["LegacyValue", "ValueKind", "Ref", "addr"]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "sites": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["line", "column", "fingerprint"],
              "properties": {
                "line": {"type": "integer", "minimum": 1},
                "column": {"type": "integer", "minimum": 1},
                "fingerprint": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
