{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mech-lang.org/schemas/value-system-migration-v4.json",
  "additionalProperties": false,
  "properties": {
    "families": {
      "items": { "$ref": "#/$defs/family" },
      "minItems": 1,
      "type": "array"
    },
    "authorized_high_risk_uses": {
      "items": { "$ref": "#/$defs/authorizedHighRiskUse" },
      "type": "array",
      "uniqueItems": true
    },
    "reference_commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "schema_version": { "const": 4 },
    "use_classifications": {
      "items": { "$ref": "#/$defs/useClassification" },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "reference_commit",
    "families",
    "authorized_high_risk_uses",
    "use_classifications"
  ],
  "type": "object",
  "$defs": {
    "applicability": {
      "additionalProperties": false,
      "properties": {
        "enum": { "enum": ["LegacyValue", "ValueKind", "Kind"] },
        "variants": {
          "items": { "minLength": 1, "type": "string" },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["enum", "variants"],
      "type": "object"
    },
    "authorizedHighRiskUse": {
      "additionalProperties": false,
      "properties": {
        "count": { "minimum": 1, "type": "integer" },
        "fingerprint": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
        "gate": { "enum": ["D1A", "E4"] },
        "identifier": {
          "enum": [
            "mutable-reference-alias",
            "reactive-cell-id",
            "reactive-turn-journal",
            "ref-addr-definition",
            "ref-addr-ufcs",
            "ref-as-mut-ptr-definition",
            "ref-as-mut-ptr-ufcs",
            "ref-as-ptr-definition",
            "ref-as-ptr-ufcs",
            "ref-id-definition",
            "ref-id-ufcs",
            "transaction-state-values-api",
            "valref-alias",
            "value-mutable-reference",
            "value-state-journal",
            "value-typed-wrapper"
          ]
        },
        "path": { "minLength": 1, "type": "string" },
        "reason": { "minLength": 1, "type": "string" }
      },
      "required": [
        "gate",
        "identifier",
        "path",
        "fingerprint",
        "count",
        "reason"
      ],
      "type": "object"
    },
    "current": {
      "additionalProperties": false,
      "properties": {
        "features": { "items": { "type": "string" }, "type": "array" },
        "kind_variants": { "items": { "type": "string" }, "type": "array" },
        "storage": { "items": { "type": "string" }, "type": "array" },
        "value_kind_variants": { "items": { "type": "string" }, "type": "array" },
        "value_variants": { "items": { "type": "string" }, "type": "array" }
      },
      "required": [
        "value_variants",
        "value_kind_variants",
        "kind_variants",
        "features",
        "storage"
      ],
      "type": "object"
    },
    "family": {
      "additionalProperties": false,
      "properties": {
        "current": { "$ref": "#/$defs/current" },
        "id": { "pattern": "^[a-z0-9][a-z0-9/-]*$", "type": "string" },
        "targets": {
          "items": { "$ref": "#/$defs/target" },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": ["id", "current", "targets"],
      "type": "object"
    },
    "role": {
      "enum": [
        "semantic-payload",
        "mutable-storage",
        "type-wrapper",
        "constant",
        "machine-argument",
        "machine-output",
        "host-input",
        "host-output",
        "serialization",
        "diagnostic",
        "reactive-identity",
        "journal-discovery",
        "selection-ir",
        "compiler-type-data",
        "temporal-payload",
        "compiler-shape-hole",
        "generic-dispatch",
        "reified-type",
        "binding-contract"
      ]
    },
    "site": {
      "additionalProperties": false,
      "properties": {
        "column": { "minimum": 1, "type": "integer" },
        "line": { "minimum": 1, "type": "integer" }
      },
      "required": ["line", "column"],
      "type": "object"
    },
    "status": {
      "additionalProperties": false,
      "properties": {
        "artifact_migrated": { "const": false },
        "implemented": { "type": "boolean" },
        "inventoried": { "const": true },
        "legacy_removed": { "const": false },
        "ports_migrated": { "const": false },
        "resident_storage_migrated": { "const": false },
        "semantics_frozen": { "const": true }
      },
      "required": [
        "inventoried",
        "semantics_frozen",
        "implemented",
        "artifact_migrated",
        "ports_migrated",
        "resident_storage_migrated",
        "legacy_removed"
      ],
      "type": "object"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "applies_to": {
          "items": { "$ref": "#/$defs/applicability" },
          "minItems": 1,
          "type": "array"
        },
        "id": { "pattern": "^[a-z0-9][a-z0-9/-]*$", "type": "string" },
        "implementation_gate": {
          "enum": ["C1", "C2", "C3", "C4", "D", "final-cutover"]
        },
        "key_semantics": { "minLength": 1, "type": "string" },
        "representation": { "minLength": 1, "type": "string" },
        "runtime_storage": { "minLength": 1, "type": "string" },
        "semantic_category": {
          "enum": [
            "immutable-snapshot",
            "reified-type-snapshot",
            "kind-expression",
            "schema",
            "binding-contract",
            "selection-ir",
            "execution-control",
            "runtime-slot-state",
            "compiler-shape-hole",
            "compiler-construction-ir",
            "legacy-dispatch",
            "rejected-legacy-form"
          ]
        },
        "status": { "$ref": "#/$defs/status" }
      },
      "required": [
        "id",
        "applies_to",
        "semantic_category",
        "representation",
        "implementation_gate",
        "key_semantics",
        "runtime_storage",
        "status"
      ],
      "type": "object"
    },
    "useClassification": {
      "additionalProperties": false,
      "properties": {
        "enum": { "enum": ["LegacyValue", "ValueKind", "Kind"] },
        "path": { "minLength": 1, "type": "string" },
        "roles": {
          "items": { "$ref": "#/$defs/role" },
          "minItems": 1,
          "type": "array"
        },
        "sites": {
          "items": { "$ref": "#/$defs/site" },
          "minItems": 1,
          "type": "array"
        },
        "target": { "pattern": "^[a-z0-9][a-z0-9/-]*$", "type": "string" },
        "variant": { "minLength": 1, "type": "string" }
      },
      "required": ["enum", "variant", "path", "sites", "roles", "target"],
      "type": "object"
    }
  }
}
