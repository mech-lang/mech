{
  "$id": "https://mech-lang.org/contracts/d4-failure-matrix-v1-schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "const": {
    "cases": [
      {
        "case": "semantic unsupported under PreferResident",
        "required_result": "legacy"
      },
      {
        "case": "semantic unsupported under RequireResident",
        "required_result": "fail-closed"
      },
      {
        "case": "authorization denied",
        "required_result": "fail-closed"
      },
      {
        "case": "provider unavailable",
        "required_result": "fail-closed"
      },
      {
        "case": "provider contract mismatch",
        "required_result": "fail-closed"
      },
      {
        "case": "malformed bytecode v1",
        "required_result": "fail-closed"
      },
      {
        "case": "successful resident activation",
        "required_result": "resident"
      },
      {
        "case": "rejected resident turn",
        "required_result": "resident-state-unchanged"
      },
      {
        "case": "retained admission capacity exhausted",
        "required_result": "packet-preserved-for-retry"
      },
      {
        "case": "resident turn duration exceeded",
        "required_result": "rejected-before-publication"
      },
      {
        "case": "effect-only resident program",
        "required_result": "execute-on-activation"
      }
    ],
    "schema_version": 1,
    "wildcard_fallback": false
  },
  "title": "Mech D4 failure-matrix contract v1"
}
