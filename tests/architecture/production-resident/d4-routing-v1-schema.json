{
  "$id": "https://mech-lang.org/contracts/d4-routing-v1-schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "const": {
    "activation_order": [
      "provider-contract-presence",
      "semantic-preflight",
      "capability-authority",
      "provider-binding",
      "instance-id-allocation",
      "activation"
    ],
    "capability_grants_revalidated_each_turn": true,
    "exact_input_driver_ownership": true,
    "fallback_eligible": [
      "SemanticUnsupported"
    ],
    "fallback_forbidden": [
      "AuthorizationDenied",
      "ProviderUnavailable",
      "ProviderContractMismatch",
      "InvalidArtifact",
      "InvalidBytecode",
      "AlreadyActive"
    ],
    "finite_use_capabilities_rejected": true,
    "legacy_owner_state_cleared_on_unload": true,
    "policies": [
      "PreferResident",
      "RequireResident",
      "LegacyOnly"
    ],
    "provider_registry_frozen_while_active": true,
    "retained_admission_before_packet_release": true,
    "schema_version": 1,
    "successful_activation_can_fallback": false,
    "wildcard_fallback": false
  },
  "title": "Mech D4 routing contract v1"
}
