{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "$schema",
    "contract",
    "base_commit",
    "bytecode_version",
    "contract_types",
    "artifact_contract_fields",
    "bytecode_section",
    "representative_declarations",
    "protected_execution_paths",
    "allowed_protected_changes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "./c4-boundary-schema.json" },
    "contract": { "const": "mech-operation-contract-c4-v1" },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "bytecode_version": { "const": 1 },
    "contract_types": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifact_contract_fields": {
      "type": "object",
      "required": ["ProgramArtifact", "NodeDeclaration", "IntegrityConstraintDeclaration"],
      "additionalProperties": false,
      "properties": {
        "ProgramArtifact": { "const": "contracts: OperationContractTable" },
        "NodeDeclaration": { "const": "contract: OperationContractId" },
        "IntegrityConstraintDeclaration": { "const": "contract: OperationContractId" }
      }
    },
    "bytecode_section": { "const": "ArtifactOperationContracts" },
    "representative_declarations": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["path", "markers"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "markers": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "protected_execution_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_protected_changes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
