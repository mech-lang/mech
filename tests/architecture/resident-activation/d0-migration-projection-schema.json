{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mech-lang.org/schemas/d0-migration-projection-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate", "source_targets", "source_migration", "target_count", "occurrence_count", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "gate": {"const": "D0"},
    "source_targets": {"const": "tests/architecture/value-system/frozen-semantic-targets-v1.json"},
    "source_migration": {"const": "tests/architecture/value-system/migration.json"},
    "target_count": {"type": "integer", "minimum": 1},
    "occurrence_count": {"type": "integer", "minimum": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/target"}
    }
  },
  "$defs": {
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enum", "variants"],
      "properties": {
        "enum": {"type": "string"},
        "variants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enum", "variant", "path", "line", "column", "target"],
      "properties": {
        "enum": {"type": "string"},
        "variant": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "target": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applies_to", "semantic_category", "representation", "implementation_gate", "key_semantics", "runtime_storage", "implemented", "legacy_removed", "occurrences"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "applies_to": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/applicability"}},
        "semantic_category": {"type": "string", "minLength": 1},
        "representation": {"type": "string", "minLength": 1},
        "implementation_gate": {"const": "D"},
        "key_semantics": {"type": "string", "minLength": 1},
        "runtime_storage": {"type": "string", "minLength": 1},
        "implemented": {"const": false},
        "legacy_removed": {"const": false},
        "occurrences": {"type": "array", "items": {"$ref": "#/$defs/occurrence"}}
      }
    }
  }
}
