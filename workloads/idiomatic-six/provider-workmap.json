  "proposed_ports": [
    {
      "source": "@in/bytes",
      "base": "cli/stdin",
      "path": "bytes",
      "value": "canonical U8 matrix [u8]:1,N, including 1,0",
      "semantics": "immutable authorized raw byte snapshot; invalid UTF-8 retained"
    },
    {
      "source": "@out/bytes",
      "base": "cli/stdout",
      "path": "bytes",
      "value": "canonical U8 matrix [u8]:1,N, including 1,0",
      "semantics": "ordered raw byte send, no suffix/transcoding"
    }
  ],
  "steps": [
    {
      "component": "CliBackend / StdCliBackend / ArgumentSnapshotCliBackend",
      "work": "Add real raw byte acquisition/output methods, delegating through argument snapshots. Read stdin once as bytes; text views validate the same retained snapshot as UTF-8. A missing raw backend must fail explicitly rather than synthesize bytes from a decoded String."
    },
    {
      "component": "CliResourceProvider::plan_read / read / validate_stdin_read",
      "work": "Declare and construct a canonical U8 row schema for /bytes; admit and retain actual input storage/work. Cache one stream acquisition across /text and /bytes, including failures; planning must not consume stdin."
    },
    {
      "component": "preflight_write / preflight_write_schema / plan_write / prepare_output",
      "work": "Accept /bytes only with exact U8 row payload; reject wrong element kinds or non-row matrices before observable effects. Copy/retain admitted raw bytes without flattening hidden nested elements or transcoding."
    },
    {
      "component": "CliOutputEffect / RuntimeAfterCommitEffect",
      "work": "Stage byte payload with exact metadata byte count and selected memory cost; retain existing ordered transaction, revocation, cancellation, denial, rollback and after-commit delivery behavior."
    },
    {
      "component": "canonical source resource requirements / activation / artifact codec / native selected ABI",
      "work": "Carry the byte schema and real capabilities through all existing boundaries, original/decoded equivalence and native lowering; do not route these programs to an experimental grid/record/whole-workload driver."
    },
    {
      "component": "qualification",
      "work": "Run the unchanged complete Mandelbrot/revcomp sources, retained binary inputs/expected outputs and invalid-byte cases. Add mixed text/byte snapshot checks, empty payload, wrong rank/kind, finite denial/recovery, late invalid input rollback, original/decoded, same-binary secure/trusted full lifetime. Nothing in this candidate executes those checks."
    }
  ],
